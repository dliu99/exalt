{
  "$schema": "../exact/scripts/app.schema.json",
  "name": "Exalt",
  "short_name": "Exalt",
  "id": "app.exalt.audiobooks",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "app.exalt.audiobooks",
    "name": "Exalt"
  },
  "host": {
    "web": {},
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ],
      "backgroundModes": [
        "audio"
      ]
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "ios": "0"
    }
  },
  "env": [
    "API_BASE_URL",
    "GOOGLE_WEB_CLIENT_ID",
    "GOOGLE_IOS_CLIENT_ID"
  ],
  "commands": {
    "server": [
      "bun",
      "server/index.ts",
      "--offline"
    ],
    "compare": [
      "bun",
      "server/compare.ts"
    ]
  },
  "audio_session": "playback"
}
