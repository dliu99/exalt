{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--env-file=../../../.env",
        "server/index.ts"
      ],
      "env": {
        "API_BASE_URL": "http://127.0.0.1:8787",
        "PUBLIC_URL": "http://127.0.0.1:8787"
      },
      "port": 8787
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--env-file=../../../.env",
        "server/index.ts"
      ],
      "env": {
        "API_BASE_URL": "http://127.0.0.1:8787",
        "PUBLIC_URL": "http://127.0.0.1:8787",
        "DEV_SIGN_IN": "1",
        "DB": ".exact/dev/data.db",
        "AUDIO_DIR": ".exact/dev/audio"
      },
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--env-file=../../../.env",
        "exact.mjs",
        "web",
        "--port",
        "3000"
      ],
      "env": {
        "EXACT2": "/Users/devin/projects/exact",
        "API_BASE_URL": "http://127.0.0.1:8787"
      },
      "port": 3000
    }
  ]
}
