{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/home", "destination": "/shell.html" },
    { "source": "/import", "destination": "/shell.html" },
    { "source": "/browse", "destination": "/shell.html" },
    { "source": "/voices", "destination": "/shell.html" },
    { "source": "/play/:gen", "destination": "/shell.html" }
  ],
  "headers": [
    { "source": "/(.*)\\.(js|mjs|css|wasm)", "headers": [{ "key": "cache-control", "value": "public, max-age=300" }] }
  ]
}
