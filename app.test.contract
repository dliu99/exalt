test "the lander shows one book at a time, and turns through the stack"
  clock data
  expect text "hero-title" == "Give great words a voice"
  expect text "great-title" == "The Republic"
  tap "stack"
  expect text "great-title" == "Meditations"
  tap "stack"
  expect text "great-title" == "Selected Writings"

test "a book on the lander opens the library searching for it"
  clock data
  tap "stack"
  tap "seek"
  clock data
  expect state asked == "Meditations Marcus Aurelius"
  expect tree has "search"

test "below the fold, the lander says what Exalt is and opens the library"
  clock data
  expect tree has "about"
  expect tree missing "lander-apple"
  expect tree has "lander-google"
  tap "lander-library"
  clock data
  expect tree has "home"
  expect tree has "no-places"
  expect tree has "home-explore"

test "an empty library says how to start"
  clock data
  tap "enter"
  clock data
  expect tree has "app"
  expect tree missing "book-OL1W"

test "search finds a book and opens its page"
  tap "enter"
  tap "nav-explore"
  type "search" "rivers"
  type "search" key "Enter"
  clock data
  expect tree has "book-OL2W"
  tap "book-OL2W"
  clock data
  expect text "book-title" == "Notes on Rivers"
  expect tree has "no-versions"
  expect tree has "goodreads"
  expect tree missing "book-description"

test "Import is the form for anyone: the book's searches, its file, a voice and consent"
  at "/book/OL1W/import"
  clock data
  expect tree has "create"
  expect tree has "find-libgen"
  expect tree has "find-zlibrary"
  expect tree has "find-web"
  expect tree has "choose-file"
  expect tree has "model"
  expect tree has "rights"
  expect tree missing "account"
  expect state rights == false
  expect state canCreate == false
  expect disabled "create-save"
  tap "create-cancel"
  clock data
  expect text "book-title" == "A Quiet Harbour"

test "Import takes a pasted link: an https link to a book file, which sets a download aside"
  at "/book/OL1W/import"
  clock data
  expect tree has "link"
  expect tree missing "link-note"
  type "book-source" "lg-00000000000000000000000000000001"
  expect tree has "source-note"
  type "link" "http://books.example/a-quiet-harbour.txt"
  expect state sourceId == ""
  expect tree missing "source-note"
  type "model" "exalt/silence"
  tap "rights"
  expect state canCreate == false
  expect text "create-hint" == "Paste a link that starts with https://."
  type "link" "https://books.example/a-quiet-harbour.txt"
  expect tree has "link-note"
  expect state canCreate == true
  expect enabled "create-save"
  // Signed out, Make asks for an account first, and carries on with the link.
  tap "create-save"
  expect tree has "account-site-google"
  expect state pendingAuth == "make"
  expect state link == "https://books.example/a-quiet-harbour.txt"

test "signed out, Generate opens the sheet to log in or sign up, and stays on the book"
  size 390x844
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  expect state pendingAuth == ""
  tap "make"
  expect tree has "account-site-google"
  expect state pendingAuth == "import"
  expect tree missing "create"
  expect text "book-title" == "A Quiet Harbour"

test "typing suggests books under the field, and one opens its page"
  tap "enter"
  tap "nav-explore"
  type "search" "r"
  clock +300
  clock data
  expect tree missing "suggestions"
  type "search" "rivers"
  clock +100
  expect tree missing "suggestions"
  clock +300
  clock data
  expect tree has "suggest-OL2W"
  expect tree missing "book-OL2W"
  tap "suggest-OL2W"
  clock data
  expect text "book-title" == "Notes on Rivers"

test "enter shows every result and closes the suggestions"
  tap "enter"
  tap "nav-explore"
  type "search" "rivers"
  clock +300
  clock data
  expect tree has "suggestions"
  type "search" key "Enter"
  clock data
  expect tree missing "suggestions"
  expect tree has "book-OL2W"

test "explore is only the search field until something is asked"
  clock data
  tap "enter"
  tap "nav-explore"
  clock data
  expect tree has "search"
  expect tree missing "canon-9780141442433"

test "voices lists Fish Audio's, and choosing one makes it yours"
  clock data
  tap "enter"
  clock data
  tap "nav-voices"
  clock data
  expect tree has "voice-v-reader"
  expect text "use-v-reader" == "Use"
  tap "use-v-reader"
  clock data
  expect text "use-v-reader" == "✓ Selected"
  tap "nav-home"
  clock data
  expect tree has "home"

test "closing the sheet without signing in carries nothing on"
  size 390x844
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  tap "make"
  expect state pendingAuth == "import"
  back
  clock settle
  expect state pendingAuth == ""
  expect text "book-title" == "A Quiet Harbour"

test "a search settles to its books, and the field clears"
  tap "enter"
  tap "nav-explore"
  expect tree missing "search-clear"
  type "search" "rivers"
  type "search" key "Enter"
  clock data
  expect tree missing "searching"
  expect tree missing "search-busy"
  expect tree has "book-OL2W"
  tap "search-clear"
  expect state query == ""
  expect state asked == ""
  expect tree missing "book-OL2W"

// On a phone, a book's page turns the dock into its own bar: back, and Play or Generate.
test "a book with no audiobook shows back and Generate in the dock, and back returns"
  size 390x844
  tap "enter"
  tap "nav-explore"
  type "search" "rivers"
  type "search" key "Enter"
  clock data
  tap "book-OL2W"
  clock data
  expect tree has "book-bar"
  expect tree has "dock-back"
  expect tree has "make"
  expect tree missing "listen"
  expect tree missing "nav-home"
  expect tree missing "book-back"
  tap "dock-back"
  clock settle
  expect tree has "explore"
  expect tree has "nav-home"
  expect tree missing "book-bar"

test "a version lists its chapters: the first narrated, the others waiting for Generate"
  request POST "/books/OL1W/generations?source=lg-00000000000000000000000000000001&model=exalt%2Fsilence&rights=1" as ada
  clock +1500 real
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  expect text "status-1" == "ada · 1 of 3 chapters narrated"
  tap "version-1"
  clock data
  expect text "now-playing" == "Chapter One: The Harbour"
  expect tree has "toggle"
  expect tree missing "generate-0"
  expect tree has "generate-1"
  expect tree has "generate-2"
  expect tree missing "delete"
  expect tree missing "in-progress"

test "signed out, a chapter's Generate opens the sheet"
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  tap "version-1"
  clock data
  expect state pendingAuth == ""
  tap "generate-2"
  expect tree has "account-site-google"
  expect state pendingAuth == "chapter"
  expect state pendingChapter == 2

test "the player's speed, pause, position and skips"
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  tap "version-1"
  clock data
  expect state duration == 1
  expect state rate == 1
  tap "rate"
  expect state rate == 1.25
  expect text "rate" == "1.25×"
  tap "rate"
  tap "rate"
  expect state rate == 2
  tap "rate"
  expect state rate == 0.75
  expect state held == false
  tap "toggle"
  expect state held == true
  type "scrub" "1"
  expect state now == 1
  expect text "elapsed" == "0:01"
  tap "back15"
  expect state now == 0
  expect text "elapsed" == "0:00"
  // +30 never runs past the chapter: it stops a second short of its end.
  tap "fwd30"
  expect state now == 0

test "at a chapter that isn't narrated the player stops and offers Generate, and plays it once someone has"
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  tap "version-1"
  clock data
  tap "audio" mediasession "nexttrack"
  expect text "now-playing" == "Chapter Two: The River"
  expect state held == true
  expect tree has "not-narrated"
  expect tree has "generate-current"
  expect tree missing "audio"
  request POST "/generations/1/chapters/1" as grace
  clock +1500 real
  clock +3000
  clock data
  expect tree missing "not-narrated"
  expect tree has "audio"
  expect tree has "toggle"
  expect tree missing "generate-1"

test "once a chapter is narrated the dock plays the book"
  size 390x844
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  expect tree has "listen"
  expect tree missing "make"
  expect tree has "make-another"
  tap "listen"
  clock data
  expect tree has "player"
  expect text "now-playing" == "Chapter One: The Harbour"

// The player is at App level: leaving it keeps the chapter playing, in the dock's mini player.
// (The test chapters are a second of silence each, played in real time: what's checked after
// the first steps is checked paused.)
test "leaving the player keeps it playing, in the dock's mini player, which pauses and opens it"
  size 390x844
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  tap "version-1"
  clock data
  tap "player-back"
  clock settle
  expect tree has "book-bar"
  expect state held == false
  expect tree has "audio"
  expect tree has "mini-player"
  tap "mini-toggle"
  expect state held == true
  expect tree has "audio"
  expect state loaded == "1"
  expect text "mini-book" == "A Quiet Harbour"
  // The lock screen's controls are still the player's: its title, and skips back and ahead.
  expect mediasession owner == "audio"
  expect mediasession album == "A Quiet Harbour"
  expect mediasession has "seekbackward"
  expect mediasession has "seekforward"
  expect mediasession has "nexttrack"
  tap "dock-back"
  clock settle
  expect tree has "explore"
  expect tree has "mini-player"
  expect tree missing "mini"
  tap "mini-open"
  clock settle
  expect tree has "player"
  expect tree missing "mini-player"
  expect state loaded == "1"
  expect tree has "toggle"

test "a narrated chapter in the list plays at a tap; one that isn't keeps its Generate"
  request POST "/generations/1/chapters/1" as grace
  clock +1500 real
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  tap "version-1"
  clock data
  expect text "now-playing" == "Chapter One: The Harbour"
  tap "track-1"
  expect state track == 1
  expect state held == false
  expect text "now-playing" == "Chapter Two: The River"
  expect tree has "audio"
  tap "track-0"
  expect state track == 0
  expect text "now-playing" == "Chapter One: The Harbour"
  expect tree has "generate-2"
  expect tree missing "generate-1"

test "the sleep timer counts while playing, holds with a pause, and pauses at its time or the chapter's end"
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  tap "version-1"
  clock data
  tap "toggle"
  expect state held == true
  expect tree missing "sleep-left"
  tap "sleep"
  tap "sleep-15"
  expect state sleepMins == 15
  expect text "sleep-left" == "Pausing in 15:00"
  clock +60000
  expect text "sleep-left" == "Pausing in 15:00"
  // End of chapter: the chapter's end pauses at the start of the next, where it would have played on.
  tap "sleep"
  tap "sleep-chapter"
  expect text "sleep-left" == "Pausing at the end of this chapter"
  tap "toggle"
  clock +1500 real
  expect state track == 1
  expect state held == true
  expect state sleepMins == 0
  expect tree missing "sleep-left"
  // Minutes: once they've passed it pauses, and turns itself off. (A little over: a chapter's
  // change, a pause and then the next, holds the count for a moment.)
  tap "sleep"
  tap "sleep-15"
  tap "toggle"
  clock +930000
  expect state held == true
  expect state sleepMins == 0
  expect state sleepLeft == 0
  expect tree missing "sleep-left"

// It narrates the third chapter, which the tests above keep waiting for Generate: after them.
test "a version downloads to the device, plays from there, and is removed again"
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  tap "version-1"
  clock data
  expect text "download-state" == "Listen offline"
  expect tree missing "remove-download"
  // A dropped connection keeps nothing, and says so.
  fail fetch "http://127.0.0.1:8787/audio" times 1
  tap "download"
  clock data
  expect text "download-error" == "The download stopped. Check the connection, then try again."
  expect text "download-state" == "Listen offline"
  tap "download"
  clock data
  expect tree missing "download-error"
  expect text "download-state" == "Downloaded"
  expect tree has "remove-download"
  expect tree missing "download"
  expect tree has "chapter-kept-0"
  expect tree has "chapter-kept-1"
  expect state playSrc == "app:/cache/offline/1/0.m4a"
  // A chapter narrated since is offered as the rest.
  request POST "/generations/1/chapters/2" as grace
  clock +1500 real
  // Reopened at the player's address, it loads the version there, paused.
  reload
  clock +100
  clock data
  expect tree has "player"
  expect state loaded == "1"
  expect state held == true
  expect text "download-state" == "2 of 3 chapters downloaded"
  expect text "download" == "Download the rest"
  tap "remove-download"
  clock data
  expect text "download-state" == "Listen offline"
  expect tree has "download"
  expect tree missing "chapter-kept-0"
  expect state keptSrc == ""

// Last: it adds a version to the run’s shared database.
test "a book imported by link is split into chapters; a link to a private address is refused"
  request POST "/books/OL2W/generations?model=exalt%2Fsilence&rights=1&link=https%3A%2F%2F127.0.0.1%2Fbook.epub" as ada expect 400
  request POST "/books/OL2W/generations?model=exalt%2Fsilence&rights=1&link=https%3A%2F%2Fbooks.example%2Fa-quiet-harbour.txt" as ada
  clock +1500 real
  tap "enter"
  tap "nav-explore"
  type "search" "rivers"
  type "search" key "Enter"
  clock data
  tap "book-OL2W"
  clock data
  // The tests before it made version 1, of the other book; nothing was made of the refused link.
  expect text "status-2" == "ada · 1 of 3 chapters narrated"
  expect tree missing "status-3"
