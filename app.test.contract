test "the lander shows one book at a time, and turns through the stack"
  clock data
  expect text "hero-title" == "Give great words a voice"
  expect text "great-title" == "The Republic"
  tap "stack"
  expect text "great-title" == "Meditations"
  tap "stack"
  expect text "great-title" == "Selected Writings"

test "a book on the lander opens the library searching for it"
  clock data
  tap "stack"
  tap "seek"
  clock data
  expect state asked == "Meditations Marcus Aurelius"
  expect tree has "search"

test "below the fold, the lander says what Exalt is and opens the library"
  clock data
  expect tree has "about"
  expect tree has "lander-apple"
  expect tree has "lander-google"
  tap "lander-library"
  clock data
  expect tree has "home"
  expect tree has "no-places"
  expect tree has "mine-signed-out"

test "an empty library says how to start"
  clock data
  tap "enter"
  clock data
  expect tree has "app"
  expect tree missing "book-OL1W"

test "search finds a book and opens its page"
  tap "enter"
  tap "nav-explore"
  type "search" "rivers"
  type "search" key "Enter"
  clock data
  expect tree has "book-OL2W"
  tap "book-OL2W"
  clock data
  expect text "book-title" == "Notes on Rivers"
  expect tree has "no-versions"
  expect tree has "goodreads"
  expect tree missing "book-description"

test "making an audiobook waits for a file and consent"
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  expect text "book-description" == "A test book about a harbour."
  tap "make"
  clock data
  expect text "create-hint" == "Sign in to make an audiobook."
  expect state model == "exalt/silence"

test "making an audiobook asks for an account, with Apple's and Google's buttons"
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  tap "make"
  clock data
  expect tree has "sign-in-note"
  expect tree has "apple-sign-in"
  expect tree has "google-sign-in"
  expect tree missing "account"
  expect tree missing "sign-out"

test "typing suggests books under the field, and one opens its page"
  tap "enter"
  tap "nav-explore"
  type "search" "r"
  clock +300
  clock data
  expect tree missing "suggestions"
  type "search" "rivers"
  clock +100
  expect tree missing "suggestions"
  clock +300
  clock data
  expect tree has "suggest-OL2W"
  expect tree missing "book-OL2W"
  tap "suggest-OL2W"
  clock data
  expect text "book-title" == "Notes on Rivers"

test "enter shows every result and closes the suggestions"
  tap "enter"
  tap "nav-explore"
  type "search" "rivers"
  clock +300
  clock data
  expect tree has "suggestions"
  type "search" key "Enter"
  clock data
  expect tree missing "suggestions"
  expect tree has "book-OL2W"

test "explore is only the search field until something is asked"
  clock data
  tap "enter"
  tap "nav-explore"
  clock data
  expect tree has "search"
  expect tree missing "canon-9780141442433"

test "voices lists Fish Audio's, and choosing one makes it yours"
  clock data
  tap "enter"
  clock data
  expect text "voice-name" == "No voice chosen yet"
  tap "change-voice"
  clock data
  expect tree has "voice-v-reader"
  tap "use-v-reader"
  clock data
  expect text "use-v-reader" == "✓ Selected"
  tap "nav-home"
  clock data
  expect text "voice-name" == "The Reader"

test "a LibGen file can be selected instead of uploading a book"
  tap "enter"
  tap "nav-explore"
  type "search" "harbour"
  type "search" key "Enter"
  clock data
  tap "book-OL1W"
  clock data
  tap "make"
  clock data
  expect tree has "book-source"
  type "book-source" "lg-00000000000000000000000000000001"
  expect state sourceId == "lg-00000000000000000000000000000001"
  expect state filePath == ""
  expect tree has "source-note"
  type "rights" "true"
  expect state rights == true
  expect text "create-hint" == "Sign in to make an audiobook."
