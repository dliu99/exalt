                        background-color="#f7f8fa" border-radius=10 overflow="hidden" box-shadow="0 18px 40px -12px rgba(20,24,36,0.35)" padding="6px 0"
                        for b in suggestions.slice(0, 6) key=b.id
                          SuggestionRow(book=b)
                if asked != ""
                  if searchError != ""
                    text searchError font-family="Jost" font-size=16 color="#b2463c" testId="search-error"
                  else if pending(found) and found.length == 0
                    row justify-content="center" padding=40
                      progress aria-label="Searching" testId="searching"
                  else if found.length == 0
                    text "No books found. Try a different title or author." font-family="Jost" font-weight=300 font-size=20 color="#14171f" testId="no-results"
                  else
                    column
                      for b in found key=b.id
                        ResultRow(book=b)
            TopBar(active="explore", wide=wide)
