                    row justify-content="space-between"
                      text clock(now) font-family="Jost" font-size=12 color="#9a978f" testId="elapsed"
                      text (duration > 0 ? `−${clock(duration - now)}` : "") font-family="Jost" font-size=12 color="#9a978f"
