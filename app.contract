                        option "Download a copy…" value=""
                        for f in bookSources.files key=f.id
                          option f.label value=f.id
                    else
                      text (bookSources.available ? "No EPUB or PDF download found. Upload your own file." : "Book downloads aren’t connected. Upload your own file.") font-family="Jost" font-size=15 line-height=1.45 color="#6b7080" testId="source-empty"
                    if sourceId != ""
                      text "This file will be downloaded and narrated with your chosen voice." font-family="Jost" font-size=14 color="#6b7080" testId="source-note"
