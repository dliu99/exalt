// Exalt: open audiobooks. Every book is one record (a Google Books volume or Open Library work); anyone can upload
// an EPUB, PDF or TXT of it and make an audiobook with the voice model they choose, which
// then sits on that book's page for everyone. app.ts asks server/index.ts for all of it.
// Listening needs no account; making an audiobook needs Sign in with Google.
use EmptyState from "exact:content"
use getIdentityCapabilities, IdentityCapabilities from "@exact/sign-in"
use getClientCapabilities, ClientCapabilities from "@exact/passkeys"
use openBrowser, BrowserResult from "@exact/in-app-browser"
use showNotification, notificationStatus, requestNotificationPermission, notificationclick, NotificationStatus, NotificationEvent from "@exact/notifications"

// The brand face: Jost (SIL Open Font License), for the wordmark, the lander and generated covers; the app reads in the system face.
font "Jost"
  300 = "assets/fonts/Jost-Light.ttf"
  300 italic = "assets/fonts/Jost-LightItalic.ttf"
  400 = "assets/fonts/Jost-Regular.ttf"
  500 = "assets/fonts/Jost-Medium.ttf"

// One stack on Home: a book, its import and the player are pushed over it; Add (a book from a
// file or a link) is a sheet over it; the lander and the player cover it.
routes nav
  home "/home"
    lander "/"
    book "/book/:id"
      create "/book/:id/import"
    play "/play/:gen"
    add "/import"

shape Book
  id: string
  title: string
  author: string
  year: number
  cover: string
  description: string
  versions: number

shape Version
  id: string
  by: string
  model: string
  voice: string
  status: string
  done: number
  total: number
  active: number
  error: string
  sample: string
  voiceName: string

shape BookDetail
  book: Book
  versions: Version[]

shape BookSource
  id: string
  label: string

shape BookSources
  available: bool
  files: BookSource[]

shape Model
  id: string
  name: string
  voices: string[]

// One chapter of a version: narrated (`ready`, with its audio), `idle` until someone asks for it,
// `queued` or `working` (narrating, `progress` of the way) once they have, `failed`, or `unavailable`
// (a version from before chapters were narrated one at a time kept no text for it).
shape Chapter
  idx: number
  title: string
  src: string
  status: string
  progress: number
  error: string

shape Audiobook
  id: string
  book: string
  title: string
  author: string
  cover: string
  by: string
  model: string
  // Its preparation: queued or working (getting and splitting the book), ready, or failed (error).
  status: string
  error: string
  chapters: Chapter[]
  // The signed-in listener's chapters waiting or narrating, of how many they may have at once.
  mine: number
  limit: number
  // Whether the signed-in listener made it (and may delete it).
  owner: bool

// What a file or a link is, read before anything is made: Add a Book's second step.
shape ImportPreview
  ok: bool
  error: string
  title: string
  author: string
  cover: string
  chapters: string[]

// An import's answer: the book it made or matched, whose page opens next.
shape Imported
  ok: bool
  error: string
  book: string

shape Reply
  ok: bool
  error: string

shape Account
  signedIn: bool
  name: string

// Where the listener left off in an audiobook (kept on this device).
shape Place
  gen: string
  book: string
  title: string
  author: string
  cover: string
  track: number
  tracks: number
  time: number
  duration: number
  at: number

// A narrated chapter kept on this device, to play without a connection (under app:/cache/offline).
shape Offline
  gen: string
  idx: number
  path: string

// A chapter this listener asked to have narrated that can be heard now (`ready`: its first part is
// narrated, so it plays while the rest is), or couldn't be narrated (`status`).
// `key` is how it was asked for: "gen/idx".
shape Ready
  key: string
  gen: string
  idx: number
  title: string
  book: string
  status: string

// Whether Exalt is on screen: a chapter that's ready while it isn't gets the system's notification.
shape Page
  visibilityState: string

// A book on Home's shelf, with the few words its controls show.
shape Shelved
  book: string
  gen: string
  title: string
  author: string
  cover: string
  chapter: string
  left: string
  when: string
  frac: number

// An audiobook the signed-in listener made.
shape Mine
  gen: string
  book: string
  title: string
  author: string
  cover: string
  status: string
  done: number
  total: number
  model: string
  voice: string

// A voice from Fish Audio's library (read through OpenRouter's Fish models), and the listener's choice.
shape Voice
  id: string
  title: string
  description: string
  cover: string
  sample: string
  languages: string
  uses: number

shape VoicePref
  id: string
  title: string
  cover: string

// One of the lander's great books: its Penguin cover ships in assets/covers.
shape Great
  id: string
  title: string
  author: string
  era: string
  cover: string

shape Time
  epochAtZero: number
  utcOffset: number

shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool

// The lander's stack. A book's depth is how far below the top it lies (0 is the one in focus);
// the last depth is the book just turned away, thrown off to the left, so going back brings it
// down onto the top again. The rest settle under the top at a slant of their own.
fn depthOf(i: number, cur: number, n: number): number = (i - cur + n) % n
fn gone(d: number, n: number): bool = d == n - 1 and n > 1
fn slant(i: number): number = ((i * 47) % 13 - 6) * 0.85
fn volX(d: number, n: number, i: number, w: number): number = gone(d, n) ? -w * 2.1 : d == 0 ? 0 : ((i * 29) % 9 - 4) * 4
fn volY(d: number, n: number, h: number): number = gone(d, n) ? -h * 0.12 : min(d, 5) * 8
fn volRot(d: number, n: number, i: number): number = gone(d, n) ? -26 : d == 0 ? slant(i) * 0.2 : slant(i)
fn volOpacity(d: number, n: number): number = gone(d, n) ? 0 : d > 5 ? 0 : 1
fn volZ(d: number, n: number): number = gone(d, n) ? n + 1 : n - d
fn mag(x: number): number = max(x, -x)

fn two(n: number): string = n < 10 ? `0${n}` : `${n}`
fn clock(s: number): string = s >= 3600 ? `${floor(s / 3600)}:${two(floor(s / 60) % 60)}:${two(floor(s) % 60)}` : `${floor(max(0, s) / 60)}:${two(floor(max(0, s)) % 60)}`
fn placeFrac(p: Place): number = p.tracks == 0 ? 0 : min(1, (p.track + (p.duration > 0 ? p.time / p.duration : 0)) / p.tracks)
fn chaptersText(done: number, total: number): string = done == total ? `${total} ${total == 1 ? "chapter" : "chapters"}` : `${done} of ${total} chapters narrated`
fn mineText(m: Mine): string = m.status == "ready" ? chaptersText(m.done, m.total) : m.status == "failed" ? "Didn’t finish" : m.status == "queued" ? "Waiting to start…" : "Preparing book…"
fn readBy(v: Version): string = v.voiceName != "" ? v.voiceName : v.model
fn nextRate(r: number): number = r == 1 ? 1.25 : r == 1.25 ? 1.5 : r == 1.5 ? 2 : r == 2 ? 0.75 : 1
fn rateText(r: number): string = r == 1 ? "1×" : r == 1.25 ? "1.25×" : r == 1.5 ? "1.5×" : r == 2 ? "2×" : "0.75×"
fn byline(b: Book): string = b.year > 0 ? `${b.author} · ${b.year}` : b.author
fn versionsText(n: number): string = n == 0 ? "" : n == 1 ? "1 audiobook" : `${n} audiobooks`
fn statusText(v: Version): string = v.status == "ready" ? (v.active > 0 ? `${chaptersText(v.done, v.total)} · narrating` : chaptersText(v.done, v.total)) : v.status == "failed" ? v.error : v.status == "queued" ? "Waiting to start…" : "Preparing book…"
fn goodreads(b: Book): string = `https://www.goodreads.com/search?q=${encodeURIComponent(b.title + " " + b.author)}`
// Import's "find it yourself": a book's title and author searched in the browser, to download and upload.
fn libgenSearch(b: Book): string = `https://libgen.li/index.php?req=${encodeURIComponent(b.title + " " + b.author)}`
fn zlibSearch(b: Book): string = `https://z-library.sk/s/${encodeURIComponent(b.title + " " + b.author)}`
fn webSearch(b: Book): string = `https://www.google.com/search?q=${encodeURIComponent(b.title + " " + b.author + " epub")}`
fn trackTitle(a: Audiobook, i: number): string = match a.chapters.at(i) { case some(t) => t.title, case none => "" }
fn trackSrc(a: Audiobook, i: number): string = match a.chapters.at(i) { case some(t) => t.src, case none => "" }
fn trackStatus(a: Audiobook, i: number): string = match a.chapters.at(i) { case some(t) => t.status, case none => "" }
fn inFlight(status: string): bool = status == "queued" or status == "working"
// What a chapter that isn't narrated says on its row.
fn chapterNote(c: Chapter): string = c.status == "queued" ? "Waiting…" : c.status == "working" ? `Narrating… ${round(c.progress * 100)}%` : c.status == "unavailable" ? "Unavailable" : c.status == "failed" ? "Didn’t finish" : ""
// A chapter asked for is kept as "gen/idx".
fn keyGen(k: string): string = match k.split("/").at(0) { case some(g) => g, case none => "" }
fn keyIdx(k: string): number = match k.split("/").at(1) { case some(s) => (match parseNumber(s) { case some(n) => n, case none => 0 }), case none => 0 }
// Where a chapter's download is on this device, or "".
fn keptAt(kept: Offline[], gen: string, idx: number): string = match kept.filter(o => o.gen == gen and o.idx == idx).at(0) { case some(o) => o.path, case none => "" }
// The sleep timer: 0 is off, -1 the end of the chapter, else minutes (counted down in seconds while playing).
fn sleepText(mins: number, left: number): string = mins == -1 ? "Pausing at the end of this chapter" : `Pausing in ${clock(left)}`
fn chapterCount(n: number): string = `${n} ${n == 1 ? "chapter" : "chapters"}`
// A version's download: what it says, and the line under it.
fn savedTitle(kept: number, narrated: number, saving: bool): string = saving ? `Downloading · ${kept} of ${narrated}` : kept > 0 and kept >= narrated ? "Downloaded" : kept > 0 ? `${kept} of ${narrated} chapters downloaded` : "Listen offline"
fn savedNote(kept: number, narrated: number): string = kept > 0 and kept >= narrated ? `${chapterCount(kept)} on this device, to play without a connection` : kept > 0 ? "Download the rest to hear them offline too" : `Save ${narrated == 1 ? "the narrated chapter" : `the ${narrated} narrated chapters`} to this device`

component App
  state query = ""
  state asked = ""
  state me = "" persist
  state filePath = ""
  state fileName = ""
  state sourceId = ""
  // A pasted link to a book file, which the server downloads (server/link.ts).
  state link = ""
  // Add a Book: a link is taken at Add, in its own sheet.
  state linkTaken = ""
  state model = ""
  state voice = ""
  state rights = false
  state refusal = ""
  state track = 0
  // The player's chapters: what a Generate was refused with, a sign-in asked for by one, and a delete being confirmed.
  state genRefusal = ""
  // What was asked for that needs an account ("import", "chapter", "make"), so signing in carries on with it.
  state pendingAuth = ""
  state pendingChapter = 0
  state confirmDelete = false
  // The lander: a hero over the painting, and a stack of books lying across the fold. Scrolling
  // fades the painting out and brings the stack into focus, one book at a time.
  resource greats = loadGreats() as shape Great[] else empty()
  resource viewport = exactViewport() as shape Viewport
  state cur = 0
  state dragX = 0
  state dragY = 0
  state dragging = false
  state moved = false
  state scrollY = 0
  // A drag far enough to turn the book is felt as it crosses the line.
  state armed = false
  derive n = greats.length
  derive wide = viewport.width >= 820
  // A phone gets the dock: the tabs and the book in progress, floating on glass over every main screen.
  // A phone's mini player floats on every screen but the lander, the player and a picked book's controls.
  derive phoneDock = not wide and fore == "" and top(nav).name != "lander" and top(nav).name != "play"
  derive coverH = round(min(viewport.height * (wide ? (gated ? 0.42 : 0.46) : gated ? 0.45 : 0.4), 440))
  derive coverW = min(round(coverH / 1.55), round(viewport.width * 0.66))
  derive focused = greats.slice(cur, cur + 1)
  derive still = viewport.prefersReducedMotion
  // 0 with the painting in full, 1 once it has scrolled most of the way off.
  derive fade = min(1, max(0, scrollY / max(1, viewport.height * 0.6)))
  derive lit = fade > 0.5
  // The painting covers the screen. On a narrow one it is drawn a little taller and slides
  // so the wanderer stands at the right, under the book's name.
  derive paintH = wide ? max(viewport.height, viewport.width / 1.777) : viewport.height * 1.15
  derive paintW = paintH * 1.777
  derive paintLeft = wide ? (viewport.width - paintW) / 2 : max(viewport.width - paintW, min(0, viewport.width * 0.86 - paintW * 0.83))
  resource listening = loadListening() as shape Book[] else empty()
  resource found = searchBooks(asked) as shape Book[] else empty()
  // Under the field while typing: a few books for what has been typed so far.
  state suggestFor = ""
  state suggestOpen = false
  state leaving = false
  state fieldOn = false
  state voiceOn = false
  resource suggestions = suggestBooks(suggestFor) as shape Book[] else empty()
  resource models = loadModels() as shape Model[] else empty()
  resource detail = loadBook(bookId) as shape BookDetail else empty()
  resource bookSources = loadBookSources(top(nav).name == "create" ? bookId : "") as shape BookSources else empty(available=false, files=[])
  // What plays: one version at a time, held at App level so it keeps playing while the listener
  // browses. The player shows it; a copy downloaded with it answers when the server can't.
  state loaded = ""
  resource audiobook = loadAudiobook(loaded) as shape Audiobook else empty()
  mutation browser as shape BrowserResult
  mutation created as shape Imported refreshes detail, listening, account, mine, shelf then afterCreate
  mutation generated as shape Reply refreshes audiobook, detail, mine then afterGenerate
  mutation removed as shape Reply refreshes detail, listening, mine, shelf then afterRemove
  // Home: where the listener left off, what they made, and the voice they read in.
  resource places = loadPlaces() as shape Place[] else empty()
  mutation placed as shape Reply refreshes places, shelf
  // Home's shelf: six recent books; the one picked comes forward, with its controls under it.
  resource time = exactTime() as shape Time
  resource shelf = loadShelf() with time.epochAtZero as shape Shelved[] else empty()
  state fore = ""
  derive shelfCols = wide ? 6 : 3
  derive shelfGap = wide ? 36 : 22
  derive shelfW = min(viewport.width, 1080) - (wide ? 96 : 48)
  derive bookW = min(floor((shelfW - shelfGap * (shelfCols - 1)) / shelfCols), floor(((viewport.height - 330) / 2 - 46) / 1.5))
  derive bookH = round(bookW * 1.5)
  derive rowH = bookH + 46
  derive rowW = shelfCols * bookW + (shelfCols - 1) * shelfGap
  derive pickScale = min(1.9, (wide ? 280 : viewport.width * 0.56) / max(1, bookW))
  derive pickX = (rowW - bookW) / 2
  derive pickY = round(viewport.height * 0.44) - (wide ? 230 : 212) - bookH / 2
  derive shelfLeft = round((viewport.width - rowW) / 2)
  derive shelfTop = wide ? "230px" : "calc(env(safe-area-inset-top) + 96px)"
  // The app opens on signing in; the site lets anyone through to listen.
  resource app = isApp() as shape Reply else empty(ok=false, error="")
  // The door: where the server keeps accounts, nothing opens without signing in, on the site as in the app.
  resource door = accountRequired() as shape Reply else empty(ok=true, error="")
  derive gated = door.ok and not account.signedIn and identities.providers.google.active
  // On a phone the door is a plain screen of its own: no painting, no wordmark.
  derive phoneDoor = gated and not wide
  resource mine = loadMine() as shape Mine[] else empty()
  resource voicePref = loadVoicePref() as shape VoicePref else empty(id="", title="", cover="")
  mutation prefSet as shape Reply refreshes voicePref
  state voiceQuery = ""
  state voiceAsked = ""
  resource voiceList = loadVoices(voiceAsked) as shape Voice[] else empty()
  state auditioning = ""
  // The player: paused or not, where it is, how long the chapter is, how fast it reads.
  state held = true
  state now = 0
  state duration = 0
  state rate = 1
  state resumeTime = 0
  // The source last given the element, and for which chapter ("gen/idx"): the same chapter from
  // another source (its download arriving, or removed) carries on where it was.
  state heardSrc = ""
  state heardKey = ""
  // The sleep timer: 0 off, minutes, or -1 for the end of the chapter; the seconds left, counted while playing.
  state sleepMins = 0
  state sleepLeft = 0
  // Downloads: the chapters kept on this device, and the version being saved.
  resource offline = loadOffline() as shape Offline[] else empty()
  mutation savedAll as shape Reply refreshes offline then afterSave
  mutation unsaved as shape Reply refreshes offline then afterUnsave
  state saving = ""
  state saveError = ""
  // Chapters this listener asked for ("gen/idx"), until they're narrated, and the notice when one is.
  state wanted: string[] = [] persist
  state askedKey = ""
  resource readyNow = chaptersReady(wanted.join(",")) as shape Ready[] else empty()
  state notice = ""
  state noticeBook = ""
  state noticeKey = ""
  resource page = exactPage() as shape Page
  resource noteStatus = notificationStatus() as shape NotificationStatus
  mutation notePerm as shape NotificationStatus
  derive playerOpen = top(nav).name == "play"
  // The loaded version's record has arrived; until it has, nothing plays (the last one's chapters aren't its).
  derive here = loaded != "" and audiobook.id == loaded
  derive keptSrc = here ? keptAt(offline, loaded, track) : ""
  derive playSrc = not here ? "" : keptSrc != "" ? keptSrc : trackSrc(audiobook, track)
  // The mini player: whatever is loaded, over every screen but the player (and the door and Import).
  derive miniOn = here and not playerOpen and fore == "" and top(nav).name != "lander" and top(nav).name != "create" and top(nav).name != "add"
  // What a download takes: the chapters narrated in full (one still narrating plays as a live stream, not a file).
  derive narratedHere = audiobook.chapters.filter(c => c.status == "ready" and c.src != "").length
  derive keptHere = audiobook.chapters.filter(c => c.status == "ready" and c.src != "" and keptAt(offline, audiobook.id, c.idx) != "").length
  derive anyKept = offline.filter(o => o.gen == audiobook.id).length > 0
  derive savingHere = pending(savedAll) and saving == audiobook.id
  // A ready chapter not yet announced.
  derive fresh = readyNow.filter(r => wanted.filter(w => w == r.key).length > 0)
  derive freshKey = match first(fresh) { case some(r) => r.key, case none => "" }
  derive away = page.visibilityState != "visible"
  derive fishModel = model.startsWith("fish-audio/")
  derive mineWorking = mine.filter(m => m.status == "queued" or m.status == "working").length > 0
  derive playerCover = wide ? min(240, round(viewport.height * 0.28)) : min(220, round(viewport.width * 0.56))
  // The account: the provider's buttons sign in, with a nonce fetched before the press.
  resource account = currentAccount() as shape Account else empty(signedIn=false, name="")
  resource identities = getIdentityCapabilities() as shape IdentityCapabilities
  mutation nonce as shape Reply
  mutation signedIn as shape Reply refreshes account, mine, shelf, places, audiobook
  mutation left as shape Reply refreshes account, mine, shelf, places, audiobook
  derive signInError = match signedIn { case some(r) => r.error, case none => "" }
  derive bookId = match stack(nav).filter(e => e.name == "book" or e.name == "create").at(-1) { case some(e) => e.params.id, case none => "" }
  derive genId = match stack(nav).filter(e => e.name == "play").at(-1) { case some(e) => e.params.gen, case none => "" }
  derive working = detail.versions.filter(v => inFlight(v.status) or v.active > 0).length > 0
  // The versions with something to play: prepared, with a chapter narrated.
  derive playable = detail.versions.filter(v => v.status == "ready" and v.done > 0)
  // The book page's one action, in the dock on a phone: Play when a version has a narrated chapter
  // (the one last heard here, else the first), Generate (Import) when none has.
  derive bookPlaying = detail.book.id == bookId and playable.length > 0
  derive heardHere = places.filter(p => playable.filter(v => v.id == p.gen).length > 0)
  // The version the book's numbers describe: the first with something to play, else the first prepared.
  derive leadVersion = playable.length > 0 ? playable.slice(0, 1) : detail.versions.filter(v => v.status == "ready").slice(0, 1)
  derive bookGen = match first(heardHere) { case some(p) => p.gen, case none => match first(playable) { case some(v) => v.id, case none => "" } }
  // The player's version is being prepared, or has chapters waiting or narrating.
  derive narrating = inFlight(audiobook.status) or audiobook.chapters.filter(c => inFlight(c.status)).length > 0
  // The listener has as many chapters narrating as they may.
  derive atLimit = account.signedIn and audiobook.limit > 0 and audiobook.mine >= audiobook.limit
  derive genPending = pending(generated)
  derive voices = match first(models.filter(m => m.id == model)) { case some(m) => m.voices, case none => [] }
  derive createError = match created { case some(r) => r.error, case none => "" }
  // Add a Book's second step: once a file is picked or a link taken, the book it is.
  derive adding = filePath != "" or linkTaken != ""
  resource preview = previewImport(adding ? filePath : "", adding ? fileName : "", adding ? linkTaken : "") as shape ImportPreview else empty(ok=false, error="", title="", author="", cover="", chapters=[])
  derive linkOk = link.trim() == "" or link.trim().startsWith("https://")
  derive canCreate = (filePath != "" or sourceId != "" or link.trim() != "") and linkOk and model != "" and rights and not pending(created)
  derive createHint = pending(created) ? (sourceId != "" or link.trim() != "" ? "Downloading book and preparing audiobook…" : "Uploading…") : filePath == "" and sourceId == "" and link.trim() == "" ? "Choose a book file, paste a link or upload your own." : not linkOk ? "Paste a link that starts with https://." : model == "" ? "Choose a voice model." : not rights ? "Confirm you may share it." : ""
  derive showSuggestions = suggestOpen and suggestFor.length >= 2 and suggestFor == query.trim() and suggestFor != asked and suggestions.length > 0
  // The field shows it is working from the first keystroke's pause to the answer.
  derive searching = asked != "" and pending(found)
  derive suggesting = suggestOpen and query.trim().length >= 2 and query.trim() != asked and (query.trim() != suggestFor or pending(suggestions))
  derive voiceBusy = voiceQuery.trim() != voiceAsked or pending(voiceList)
  derive searchError = pending(found) ? "" : match failure(found) { case some(f) => "Search isn’t reachable right now. Try again.", case none => "" }

  // While playing, wherever the listener is, the place is kept every so often (and at every pause and chapter's end).
  task keeping when loaded != "" and not held
    every(15000, keepPlace)
  // The player opened at its address (a reload, a link) loads that version.
  task adopting when playerOpen and genId != loaded
    after(1, adopt)
  task resourcing when playSrc != heardSrc
    after(1, heardIt)
  // The sleep timer counts while playing; a pause holds it. Stopped at a chapter that isn't narrated
  // there's nothing to pause, so it runs out.
  task sleeping when sleepLeft > 0 and (not held or playSrc == "")
    every(1000, sleepTick)
  // A download shows each chapter as it lands.
  task watchingSave when pending(savedAll)
    every(1000, refreshOffline)
  task announcing when freshKey != "" key=freshKey
    after(1, announce)
  task noticing when notice != "" key=noticeKey
    after(8000, clearNotice)
  task voiceSearching when voiceQuery.trim() != voiceAsked key=voiceQuery
    after(300, takeVoiceQuery)

  // A drag's end can be followed by a click on the stack; it is spent a moment later either way.
  task settling when moved and not dragging
    after(250, clearMoved)

  // While an audiobook is being made, its page follows the progress.
  task poll mount
    every(3000, pull)

  // Suggestions follow the typing: a short pause asks for a few books (the server keeps each
  // search, so typing back costs nothing). Enter asks for every result.
  task suggesting when query.trim() != suggestFor key=query
    after(200, takeSuggest)
  // Leaving the field closes them, a moment later, so a tap on one still lands.
  task closing when leaving
    after(200, closeSuggest)

  // Signed in from the sheet: what was asked for goes ahead.
  task carryingOn when account.signedIn and pendingAuth != ""
    after(1, carryOn)

  task prepareIdentity mount
    after(1, getNonce)
  // In the app, signing in opens Home, and signing out comes back to the door.
  task entering when app.ok and account.signedIn and top(nav).name == "lander"
    after(1, enter)
  task barring when gated and top(nav).name != "lander"
    after(1, toDoor)

  action getNonce
    send nonce = identityNonce()
  action googleSignIn
    send signedIn = signInWith("google")
  action appleSignIn
    send signedIn = signInWith("apple")
  action signOut
    send left = signOut()
    // A sheet still up is for the session that is ending: its answer is dropped.
    send signedIn = idle()
  action pull
    if working
      refresh detail
    // What's loaded is watched while its chapters narrate, and while the player waits at one that isn't narrated (anyone may narrate it).
    if loaded != "" and (narrating or (playerOpen and trackSrc(audiobook, track) == ""))
      refresh audiobook
    // So are the chapters this listener asked for, wherever they are.
    if wanted.length > 0
      refresh readyNow
    if mineWorking
      refresh mine
      refresh shelf
  action search(v: string)
    query = v
    suggestOpen = true
    if v.trim() == ""
      asked = ""
  action ask
    asked = query.trim()
    suggestOpen = false
  action takeSuggest
    suggestFor = query.trim()
  action clearSearch
    query = ""
    asked = ""
    suggestOpen = false
  action fieldFocus
    fieldOn = true
    leaving = false
    suggestOpen = true
  action fieldBlur
    fieldOn = false
    leaving = true
  action closeSuggest
    leaving = false
    suggestOpen = false
  action back
    if top(nav).name == "play"
      keepPlace()
    nav = back(nav)
  action next
    if n > 0
      cur = (cur + 1) % n
      haptic("selection")
  action prev
    if n > 0
      cur = (cur + n - 1) % n
  // On the lander, ← and → turn the stack.
  action keyed(key: string)
    if top(nav).name == "lander"
      if key == "ArrowRight"
        next()
      else if key == "ArrowLeft"
        prev()
  // A tap throws the top book aside; one that ends a drag does not.
  action tapBook
    if moved
      moved = false
    else
      next()
  action dragBook(dx: number, dy: number)
    dragging = true
    dragX = dx
    dragY = dy
    moved = moved or max(mag(dx), mag(dy)) > 6
    let over = mag(dx) > 70
    if over and not armed
      haptic("impact-light")
    armed = over
  // A throw to the left turns to the next book, to the right back to the last; a short one settles.
  action dropBook(vx: number, vy: number)
    if n > 0 and (dragX < -70 or vx < -600)
      cur = (cur + 1) % n
    else if n > 0 and (dragX > 70 or vx > 600)
      cur = (cur + n - 1) % n
    dragging = false
    armed = false
    dragX = 0
    dragY = 0
  action clearMoved
    moved = false
  action scrolled(x: number, y: number)
    scrollY = y
  action enter
    // The app's sign-in sheet, if it is still up.
    if app.ok
      close("door-sheet")
    if top(nav).name == "lander"
      nav = go(nav, path("home"))
  action toDoor
    fore = ""
    nav = go(nav, path("lander"))
  action pick(id: string)
    fore = fore == id ? "" : id
    haptic("impact-light")
  action unpick
    fore = ""
  // The picked book plays where it left off; one with nothing to play yet opens its page.
  action playPicked(s: Shelved)
    fore = ""
    if s.gen != ""
      listen(s.gen)
    else
      nav = push(nav, path("book", s.book))
  action openPicked(s: Shelved)
    fore = ""
    nav = push(nav, path("book", s.book))
  // A book on the stack opens the app.
  action seek(g: Great)
    nav = go(nav, path("home"))
  action follow(url: string)
    nav = go(nav, url)
  action bookAction
    haptic("impact-medium")
    if bookPlaying
      listen(bookGen)
    else
      startImport()
  // Import needs an account: signed out, the sheet opens first.
  action startImport
    if account.signedIn
      openCreate()
    else
      needAccount("import")
  // Whatever needs an account opens the one sheet to log in or sign up; signing in carries on with it.
  action needAccount(what: string)
    pendingAuth = what
    haptic("selection")
    showModal("account-sheet")
  action carryOn
    let what = pendingAuth
    pendingAuth = ""
    close("account-sheet")
    if what == "import"
      openCreate()
    else if what == "add"
      openAdd()
    else if what == "chapter"
      askedKey = `${audiobook.id}/${pendingChapter}`
      send generated = generateChapter(audiobook.id, pendingChapter)
    else if what == "make" and canCreate
      send created = createAudiobook(bookId, filePath, fileName, sourceId, link.trim(), model, fishModel ? voicePref.id : voice.trim(), fishModel ? voicePref.title : voice.trim(), me.trim(), rights)
  // Dismissed without signing in: nothing carries on later.
  action sheetClosed
    if not account.signedIn
      pendingAuth = ""
  // A search or a library opens over the app (Safari's view on iOS), and Done comes back.
  action openSearch(url: string)
    haptic("selection")
    send browser = openBrowser(url=url)
  action openCreate
    sourceId = ""
    link = ""
    filePath = ""
    fileName = ""
    rights = false
    refusal = ""
    model = match first(models) { case some(m) => (model == "" ? m.id : model), case none => model }
    nav = push(nav, path("create", bookId))
  // Home's +: add a book from a file or a link, no book record needed. Signed out, the sheet opens first.
  action startAdd
    if account.signedIn
      openAdd()
    else
      needAccount("add")
  action openAdd
    sourceId = ""
    link = ""
    linkTaken = ""
    filePath = ""
    fileName = ""
    rights = false
    refusal = ""
    model = match first(models) { case some(m) => (model == "" ? m.id : model), case none => model }
    nav = push(nav, path("add"))
  // The voice, picked as the model is: the recommended voices, and the one chosen before.
  action pickVoice(id: string)
    haptic("selection")
    match first(voiceList.filter(v => v.id == id))
      case some(v)
        send prefSet = setVoicePref(v.id, v.title, v.cover)
      case none
        send prefSet = setVoicePref("", "", "")
  action chooseAddFile
    showPicker("add-upload")
  action takeLink
    if link.trim().startsWith("https://")
      linkTaken = link.trim()
      close("link-sheet")
      haptic("selection")
    else
      refusal = "Paste a link that starts with https://."
  action resetAdd
    filePath = ""
    fileName = ""
    link = ""
    linkTaken = ""
    refusal = ""
  action chooseFile
    showPicker("upload")
  action pickSource(v: string)
    sourceId = v
    filePath = ""
    fileName = ""
    link = v == "" ? link : ""
    refusal = ""
  // A link is one way to the book: typing one sets the others aside.
  action editLink(v: string)
    link = v
    refusal = ""
    if v.trim() != ""
      sourceId = ""
      filePath = ""
      fileName = ""
  action picked(files: Picked[])
    sourceId = match first(files) { case some(f) => "", case none => sourceId }
    link = match first(files) { case some(f) => "", case none => link }
    filePath = match first(files) { case some(f) => f.path, case none => filePath }
    fileName = match first(files) { case some(f) => f.name, case none => fileName }
  action pickModel(v: string)
    model = v
    voice = ""
  action editVoice(v: string)
    voice = v
  action editMe(v: string)
    me = v
  action setRights(on: bool)
    rights = on
  action create
    if canCreate and not account.signedIn
      needAccount("make")
    else if canCreate
      send created = createAudiobook(bookId, filePath, fileName, sourceId, link.trim(), model, fishModel ? voicePref.id : voice.trim(), fishModel ? voicePref.title : voice.trim(), me.trim(), rights)
  action afterCreate
    refusal = createError
    haptic(createError == "" ? "success" : "error")
    if createError == "" and top(nav).name == "create"
      nav = back(nav)
    // Added from Home: the sheet gives way to the new book's page.
    else if createError == "" and top(nav).name == "add"
      let made = match created { case some(r) => r.book, case none => "" }
      nav = made != "" ? push(back(nav), path("book", made)) : back(nav)
  // Loading a version picks up where the listener left off, if they've been here before; the one
  // playing keeps its place first.
  action loadVersion(id: string, play: bool)
    keepPlace()
    loaded = id
    track = match first(places.filter(p => p.gen == id)) { case some(p) => p.track, case none => 0 }
    resumeTime = match first(places.filter(p => p.gen == id)) { case some(p) => p.time, case none => 0 }
    now = 0
    duration = 0
    held = not play
    genRefusal = ""
    confirmDelete = false
    saveError = ""
  // Listening opens the player; the version already loaded carries on where it is.
  action listen(id: string)
    if id != loaded
      loadVersion(id, true)
    else if playSrc != ""
      held = false
    nav = push(nav, path("play", id))
  // Opened at its address, the player loads its version, paused until a press.
  action adopt
    if genId != loaded
      loadVersion(genId, false)
  action openPlayer
    nav = push(nav, path("play", loaded))
  // A chapter played from its notice: its version loaded if it isn't, the player opened at it.
  action playChapter(gen: string, idx: number)
    notice = ""
    if gen != loaded
      keepPlace()
      loaded = gen
      genRefusal = ""
      confirmDelete = false
      saveError = ""
    else
      refresh audiobook
    track = idx
    now = 0
    duration = 0
    resumeTime = 0
    held = false
    if playerOpen and genId != gen
      nav = go(nav, path("play", gen))
    else if not playerOpen
      nav = push(nav, path("play", gen))
  action resume(p: Place)
    listen(p.gen)
  action openMine(m: Mine)
    if m.status == "ready"
      listen(m.gen)
    else
      nav = push(nav, path("book", m.book))
  // A narrated chapter in the list plays from its start; the one playing carries on.
  action playTrack(i: number)
    haptic("selection")
    if i != track
      track = i
      now = 0
      duration = 0
      resumeTime = 0
      keepAt(i, 0, 0)
    held = trackSrc(audiobook, i) == ""
  // At a chapter's end the next one plays; one that isn't narrated yet stops the player there, and offers Generate.
  action nextTrack
    advance(false)
  // A chapter's end: the sleep timer set for it pauses there, at the start of the next.
  action chapterEnded
    if sleepMins == -1
      sleepMins = 0
      advance(true)
    else
      advance(false)
  action advance(stop: bool)
    let following = track + 1
    if following < audiobook.chapters.length
      // A chapter's end pauses the element first (HTML fires `pause` before `ended`): play on.
      track = following
      now = 0
      duration = 0
      resumeTime = 0
      held = stop or trackSrc(audiobook, following) == ""
      keepAt(following, 0, 0)
    else
      held = true
      keepPlace()
  action prevTrack
    if now > 5 or track == 0
      fastSeek("player-audio", 0)
    else
      track = track - 1
      now = 0
      duration = 0
      resumeTime = 0
  action keepPlace
    keepAt(track, now, duration)
  action keepAt(tr: number, t: number, d: number)
    if here
      send placed = savePlace(audiobook.id, audiobook.book, audiobook.title, audiobook.author, audiobook.cover, tr, audiobook.chapters.length, t, d, time.epochAtZero + performanceNow())
  // The element's source changed: for the same chapter (a download landing, or removed), it resumes where it was.
  action heardIt
    let key = `${loaded}/${track}`
    if heardSrc != "" and playSrc != "" and heardKey == key and now > 0
      resumeTime = now
    heardSrc = playSrc
    heardKey = key
  action tick(t: number)
    now = t
  action gotDuration(d: number)
    duration = d
  action resumeAt
    if resumeTime > 0
      fastSeek("player-audio", resumeTime)
      resumeTime = 0
  action scrub(v: number)
    now = v
    fastSeek("player-audio", v)
  action toggle
    held = not held
  action played
    held = false
  action stopped
    held = true
    keepPlace()
  // A skip moves the clock at once; the element follows.
  action back15
    let to = max(0, now - 15)
    now = to
    fastSeek("player-audio", to)
  action fwd30
    let to = duration > 0 ? min(max(0, duration - 1), now + 30) : now + 30
    now = to
    fastSeek("player-audio", to)
  action cycleRate
    rate = nextRate(rate)
    haptic("selection")
  // Narrate a chapter: signed out, the player asks for an account first.
  action generate(i: number)
    genRefusal = ""
    if not account.signedIn
      pendingChapter = i
      needAccount("chapter")
    else if not genPending
      haptic("impact-light")
      askedKey = `${audiobook.id}/${i}`
      askToNotify()
      send generated = generateChapter(audiobook.id, i)
  // A chapter asked for is watched until it's narrated, to say so.
  action afterGenerate
    let said = match generated { case some(r) => r.error, case none => "" }
    genRefusal = said
    haptic(said == "" ? "success" : "error")
    if said == "" and askedKey != ""
      wanted = wanted.filter(w => w != askedKey).concat([askedKey])
  // The first chapter asked for asks, at the press, whether Exalt may say when one is ready.
  action askToNotify
    if noteStatus.available and noteStatus.state == "prompt" and not pending(notePerm)
      send notePerm = requestNotificationPermission()
  // A chapter this listener asked for is ready: a notice here, and the system's while Exalt is in the background.
  action announce
    match first(fresh)
      case some(r)
        wanted = wanted.filter(w => w != r.key)
        // The version playing learns of its new chapter at once, wherever the listener is.
        if r.gen == loaded
          refresh audiobook
        if r.status == "ready"
          if away and noteStatus.state == "granted"
            showNotification(title=`${r.title} is ready`, body=`${r.book} · tap to play it`, tag=r.key, data=r.key)
          if not (playerOpen and r.gen == loaded and r.idx == track)
            notice = r.title
            noticeBook = r.book
            noticeKey = r.key
      case none
        notice = notice
  action noticePlay
    haptic("impact-medium")
    playChapter(keyGen(noticeKey), keyIdx(noticeKey))
  action clearNotice
    notice = ""
  // The system's notification, pressed: its chapter plays.
  action noticeOpened(tag: string, e: NotificationEvent)
    playChapter(keyGen(tag), keyIdx(tag))
  // The sleep timer, from the player's menu.
  action setSleep(m: number)
    haptic("selection")
    sleepMins = m
    sleepLeft = m > 0 ? m * 60 : 0
  action sleepTick
    if sleepLeft <= 1
      sleepLeft = 0
      sleepMins = 0
      held = true
      keepPlace()
    else
      sleepLeft = sleepLeft - 1
  // Downloads: a version's narrated chapters to this device, one after another, and removed again.
  action download
    haptic("impact-light")
    saving = audiobook.id
    saveError = ""
    send savedAll = downloadVersion(audiobook.id)
  action afterSave
    let failed = match savedAll { case some(r) => r.error, case none => "" }
    saveError = failed
    saving = ""
    haptic(failed == "" ? "success" : "error")
  action unsave
    haptic("selection")
    saveError = ""
    send unsaved = removeDownload(audiobook.id)
  action afterUnsave
    saveError = match unsaved { case some(r) => r.error, case none => "" }
  action refreshOffline
    refresh offline
  action askDelete
    confirmDelete = true
  action keepIt
    confirmDelete = false
  action remove
    send removed = deleteAudiobook(audiobook.id)
  // A deleted version stops playing, and its download goes with it.
  action afterRemove
    confirmDelete = false
    let said = match removed { case some(r) => r.error, case none => "" }
    genRefusal = said
    haptic(said == "" ? "success" : "error")
    if said == ""
      send unsaved = removeDownload(audiobook.id)
      held = true
      loaded = ""
      if playerOpen
        nav = back(nav)
  // Voices: browse or search Fish Audio's community library, hear a sample, choose one.
  action editVoiceQuery(v: string)
    voiceQuery = v
  action takeVoiceQuery
    voiceAsked = voiceQuery.trim()
  action clearVoiceQuery
    voiceQuery = ""
    voiceAsked = ""
  action voiceFocus
    voiceOn = true
  action voiceBlur
    voiceOn = false
  action audition(src: string)
    auditioning = auditioning == src ? "" : src
  action auditionEnded
    auditioning = ""
  action chooseVoice(v: Voice)
    haptic("success")
    send prefSet = setVoicePref(v.id, v.title, v.cover)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow key=keyed notificationclick=noticeOpened testId="app" width="100%" height="100%" viewport-fit="cover" color-scheme="light" accent-color="#14171f"
      for e in stack(nav) key=e.id
        if e.name == "lander"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 overflow="hidden" background-color=(phoneDoor ? "#eceef2" : "#121419") testId="lander"
            status-bar-style=(lit ? "light-content" : "dark-content") status-bar-animation="fade"
            background-image="radial-gradient(ellipse closest-side at 50% 45%, rgba(120,128,150,0.16) 0%, rgba(120,128,150,0) 100%)"
            // The painting, behind everything, fading out and drifting up as the page scrolls.
            view position="absolute" inset=0 pointer-events="none" opacity=(1 - fade) overflow="hidden" display=(phoneDoor ? "none" : "flex")
              image "assets/lander.jpg" alt="" position="absolute" top=0 left=paintLeft width=paintW height=paintH
                translate=`0px ${round(-scrollY * 0.25)}px`
              view position="absolute" inset=0
                background-image=(wide ? "linear-gradient(100deg, rgba(240,240,244,0.55) 0%, rgba(240,240,244,0.18) 38%, rgba(240,240,244,0) 60%)" : "linear-gradient(180deg, rgba(240,240,244,0.5) 0%, rgba(240,240,244,0.15) 45%, rgba(240,240,244,0) 70%)")
              // Fog drifting along the fold, out of which the books rise.
              view position="absolute" left="-15%" right="-15%" bottom=0 height="45%" opacity=0.7
                animation=(still ? "none" : "drift 26s ease-in-out infinite")
                view position="absolute" left="0%" bottom="-35%" width="55%" height="90%"
                  background-image="radial-gradient(ellipse closest-side, rgba(250,250,252,0.9) 0%, rgba(250,250,252,0) 100%)"
                view position="absolute" left="40%" bottom="-45%" width="60%" height="95%"
                  background-image="radial-gradient(ellipse closest-side, rgba(250,250,252,0.85) 0%, rgba(250,250,252,0) 100%)"
            // On a phone the door is its own screen: the painting, the line, and one glass button.
            if phoneDoor
              column position="absolute" inset=0 box-sizing="border-box" justify-content="space-between" testId="door"
                padding="calc(env(safe-area-inset-top) + 40px) 20px calc(env(safe-area-inset-bottom) + 20px)"
                // The books are the screen: one line in the sky, and the stack, large, to tap or throw through.
                column align-items="center" gap=34 flex=1 justify-content="center" padding-bottom=20 font-size="min(-exact-body, 22px)"
                  text "Give great words a voice" role="heading" aria-level=1 font-family="Jost" font-weight=300 font-size="1.75em" letter-spacing="-0.01em" color="#1b1f2b" text-align="center"
                    animation=(still ? "none" : "inkIn 1.1s 0.15s cubic-bezier(.2,.7,.2,1) both") testId="hero-title"
                  button press=tapBook aria-label="Next book" testId="stack" appearance="none" position="relative"
                    width=coverW height=coverH flex-shrink=0 touch-action="pan-y" pan=dragBook panrelease=dropBook cursor="grab"
                    animation=(still ? "none" : "arrive 1.2s 0.1s cubic-bezier(.2,.7,.2,1) both")
                    for g, i in greats key=g.id
                      Volume(book=g, depth=depthOf(i, cur, n), n=n, i=i, w=coverW, h=coverH,
                        dx=(depthOf(i, cur, n) == 0 ? dragX : 0), dy=(depthOf(i, cur, n) == 0 ? dragY : 0), dragging=dragging)
                column gap=12 align-items="stretch" animation=(still ? "none" : "arrive 1s 0.45s cubic-bezier(.2,.7,.2,1) both")
                  if signInError != ""
                    text signInError color="#7a241c" font-size="0.875rem" text-align="center" testId="door-error"
                  // The site needs Exact's button (it holds the popup at the press); the app's is its own, on glass,
                  // and opens a sheet of the providers' own buttons: Apple's, then Google's.
                  if app.ok
                    button commandfor="door-sheet" command="show-modal" testId="door-start" class=Chip height=58 border-radius=18 backgroundMaterial="glass" box-shadow="0 18px 40px -18px rgba(20,24,36,0.45)" -exact-press-haptic="impact-medium"
                      text "Get started" font-family="system-ui" font-weight=600 font-size="1.0625rem" color="#14171f"
                    // A half sheet as tall as its content; our own buttons, so Apple's and Google's read in one type, the app's.
                    dialog id="door-sheet" aria-label="Log in or sign up" testId="door-sheet"
                      column gap=12 align-items="stretch" width=viewport.width box-sizing="border-box" padding="32px 20px calc(env(safe-area-inset-bottom) + 20px)"
                        text "Log in or sign up" role="heading" aria-level=2 font-family="system-ui" font-weight=700 font-size="1.625rem" text-align="center" color="#14171f" margin-bottom=20
                        button press=appleSignIn aria-label="Continue with Apple" testId="sheet-apple" class=Chip width="100%" height=56 border-radius=16 background-color="#000" gap=10 -exact-press-haptic="impact-light"
                          image "symbol:sf/apple.logo" color="#fff" width=19 height=19
                          text "Continue with Apple" font-family="system-ui" font-weight=600 font-size="1.0625rem" color="#fff"
                        button press=googleSignIn aria-label="Continue with Google" testId="sheet-google" class=Chip width="100%" height=56 border-radius=16 background-color="#fff" border="1px solid #d6d8de" gap=10 -exact-press-haptic="impact-light"
                          svg viewBox="0 0 48 48" width=19 height=19 aria-hidden="true"
                            path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
                            path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
                            path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
                            path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
                          text "Continue with Google" font-family="system-ui" font-weight=600 font-size="1.0625rem" color="#14171f"
                        if signInError != ""
                          text signInError color="#7a241c" font-family="system-ui" font-size="0.875rem" text-align="center" testId="sheet-error"
                  else
                    exact-sign-in-button provider="google" theme="filled_black" shape="pill" press=googleSignIn testId="door-google" width="100%" height=52
            else
              scroll id="lander-scroll" position="absolute" top=0 left=0 width="100%" height="100%" scroll=scrolled
                overflow-x="hidden" overflow-y=(gated ? "hidden" : "auto") scrollbar-width="none"
                // The hero, over the painting: the line, and the stack of books to throw through.
                column min-height=viewport.height flex-shrink=0 box-sizing="border-box" align-items="center" justify-content="center" font-size="min(-exact-body, 22px)"
                  gap=(wide ? 44 : gated ? 26 : 32) padding=(wide ? "72px 24px 40px" : "6rem 20px 32px")
                  text "Give great words a voice" role="heading" aria-level=1 font-family="Jost" font-weight=300 text-align="center"
                    font-size=(wide ? `${min(76, round(viewport.width * 0.052)) / 16}em` : "2.5em") line-height=1.05 padding="0.2em 0" margin="-0.2em 0" letter-spacing="-0.02em" color="#1b1f2b"
                    opacity=max(0, 1 - fade * 1.5) animation=(still ? "none" : "inkIn 1.1s 0.15s cubic-bezier(.2,.7,.2,1) both") testId="hero-title"
                  // Tap the top book to throw it aside, or swipe it away in any direction.
                  button press=tapBook aria-label="Next book" testId="stack" appearance="none" position="relative"
                    width=coverW height=coverH flex-shrink=0 touch-action="pan-y" pan=dragBook panrelease=dropBook cursor="grab"
                    animation=(still ? "none" : "arrive 1.4s 0.35s cubic-bezier(.2,.7,.2,1) both")
                    for g, i in greats key=g.id
                      Volume(book=g, depth=depthOf(i, cur, n), n=n, i=i, w=coverW, h=coverH,
                        dx=(depthOf(i, cur, n) == 0 ? dragX : 0), dy=(depthOf(i, cur, n) == 0 ? dragY : 0), dragging=dragging)
                  // The focused book's title, lifted off the painting by a soft pale halo, and the one thing to do with it.
                  for g in focused key=g.id
                    // On a phone the stack's lower books hang below it, so the title stands clear of them.
                    column align-items="center" gap=16 padding-top=(wide ? 20 : 28) position="relative" opacity=max(0, 1 - fade * 1.5)
                      animation=(still ? "none" : "inkIn 500ms cubic-bezier(.2,.7,.2,1) both")
                      view position="absolute" left="-30%" right="-30%" top="-10%" bottom="-25%" pointer-events="none"
                        background-image="radial-gradient(ellipse closest-side, rgba(242,242,246,0.7) 0%, rgba(242,242,246,0.35) 55%, rgba(242,242,246,0) 100%)"
                      column align-items="center" gap=5 position="relative"
                        text g.title font-weight=400 font-size="1.125rem" color="#14171f" text-align="center" line-clamp=1 testId="great-title"
                        text g.author.toUpperCase() font-weight=600 font-size="0.6875rem" letter-spacing="0.06em" color="#2c3140" text-align="center" testId="great-author"
                      if not gated
                        button press=seek(g) testId="seek" position="relative" class=Chip backgroundMaterial="glass"
                          text "Open in Exalt" font-weight=400 font-size="0.9375rem" color="#14171f"
                          image "symbol:forward-chevron" color="#14171f" width="0.6875rem" height="0.6875rem"
                  // The door: Google's own button, the one way in.
                  if gated
                    column align-items="center" gap=10 width="100%" max-width="18.75rem" position="relative" opacity=max(0, 1 - fade * 1.5) testId="door"
                      exact-sign-in-button provider="google" theme="filled_black" shape="pill" press=googleSignIn testId="door-google" width="100%" height=48
                      if signInError != ""
                        text signInError color="#b2463c" font-size="0.875rem" text-align="center" testId="door-error"
                // Below the fold, in the dark: what Exalt is, and signing up.
                column min-height=viewport.height flex-shrink=0 display=(gated ? "none" : "flex") box-sizing="border-box" align-items="center" justify-content="center"
                  padding=(wide ? "120px 24px 7.5rem" : "96px 24px 6rem") gap=44 position="relative"
                  column max-width=640 align-items="center" gap=22 opacity=fade
                    text "Exalt turns any book into audio in a voice you choose."
                      font-family="Jost" font-weight=300 font-size=(wide ? "2rem" : "1.5rem") line-height=1.3 padding="0.1em 0" margin="-0.1em 0" color="#eeebe4" text-align="center" testId="about"
                    text "Generate, listen, and share for free."
                      font-family="Jost" font-weight=400 font-size=(wide ? "1.0625rem" : "0.9375rem") line-height=1.6 color="#9a978f" text-align="center" max-width=520
                  column width="100%" max-width="18.75rem" align-items="stretch" gap=12 opacity=fade
                    if account.signedIn
                      text `Signed in as ${account.name}` font-size="0.9375rem" color="#9a978f" text-align="center" testId="lander-account"
                      link href=path("home") testId="lander-library" padding="13px 26px" border-radius=999 background-color="#eeebe4" display="flex" justify-content="center"
                        -exact-press-scale=0.96 -exact-press-haptic="impact-light"
                        text "Open the library" font-weight=500 font-size="0.9375rem" color="#1b1f2b"
                    else
                      if identities.providers.google.active
                        exact-sign-in-button provider="google" press=googleSignIn testId="lander-google" width="100%" height=46
                      if signInError != ""
                        text signInError color="#e8837b" font-size="0.875rem" text-align="center" testId="lander-sign-in-error"
                      link href=path("home") testId="lander-library" padding="10px 0" display="flex" justify-content="center"
                        text "Or just listen  →" font-size="0.9375rem" color="#eeebe4" border-bottom="1px solid rgba(238,235,228,0.35)" padding-bottom=3
                  // The credit, at the foot of the page.
                  row align-items="center" justify-content="center" gap=5 position="absolute" left=0 right=0 bottom=(wide ? 32 : 40) opacity=fade testId="credit"
                    text "Made with" font-size="0.8125rem" color="#9a978f"
                    text "♥" font-size="0.8125rem" color="#e8837b" aria-label="love"
                    text "by" font-size="0.8125rem" color="#9a978f"
                    link href="https://devinliu.xyz" testId="credit-link"
                      text "Devin Liu" font-size="0.8125rem" color="#eeebe4" border-bottom="1px solid rgba(238,235,228,0.35)" padding-bottom=1
        // Home: a shelf in the fog. Six recent books; the one picked comes forward, its controls under it.
        if e.name == "home"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 overflow="hidden" background-color="#eceef2" status-bar-style="dark-content" testId="home"
            // No words on the shelf: the screen's heading is for VoiceOver alone, in a box too small to see.
            view position="absolute" top=0 left=0 width="0.0625rem" height="0.0625rem" overflow="hidden" pointer-events="none"
              text "Home" role="heading" aria-level=1 testId="home-title"
            if account.signedIn and not wide
              button popovertarget="account-menu" aria-label="Account" testId="account-button" class=Round backgroundMaterial="glass" position="absolute" top="calc(env(safe-area-inset-top) + 8px)" right=16
                image "symbol:person" color="#14171f" width=18 height=18
              column id="account-menu" popover="auto" role="menu" aria-label=account.name
                button press=signOut destructive=true popovertarget="account-menu" popovertargetaction="hide" testId="home-sign-out"
                  text "Sign Out"
            if shelf.length == 0
              // An empty shelf: faint blank covers on the ledge, and one way to fill it.
              view position="absolute" left=(shelfLeft - 14) top=shelfTop width=(rowW + 28) height=12 translate=`0px ${bookH + 5}px` border-radius=6 backgroundMaterial="glass" class=Lift pointer-events="none" aria-hidden="true" testId="no-places"
              for p, i in ["a", "b", "c", "d", "e", "f"].slice(0, shelfCols) key=p
                view aria-hidden="true" pointer-events="none" position="absolute" left=shelfLeft top=shelfTop width=bookW height=bookH
                  translate=`${i * (bookW + shelfGap)}px 0px` border-radius=6 border="1px solid rgba(20,23,31,0.1)" background-color="rgba(255,255,255,0.22)"
            else
              // The ledges the books stand on.
              view position="absolute" left=(shelfLeft - 14) top=shelfTop width=(rowW + 28) height=12 translate=`0px ${bookH + 5}px` border-radius=6 backgroundMaterial="glass" class=Lift pointer-events="none" testId="shelf"
              if shelf.length > shelfCols
                view position="absolute" left=(shelfLeft - 14) top=shelfTop width=(rowW + 28) height=12 translate=`0px ${rowH + bookH + 5}px` border-radius=6 backgroundMaterial="glass" class=Lift pointer-events="none"
              // Everything but the picked book steps back behind a veil; a tap on it puts the book away.
              button press=unpick appearance="none" aria-label="Put back" testId="veil" position="absolute" inset=0 padding=0 border-radius=0 cursor="default" z-index=5
                background-color="rgba(236,238,242,0.86)" opacity=(fore != "" ? 1 : 0) pointer-events=(fore != "" ? "auto" : "none") transition="opacity 320ms ease"
              for s, i in shelf key=s.book
                button press=pick(s.book) appearance="none" aria-label=s.title testId=`shelf-${s.book}` padding=0 cursor="pointer" position="absolute" left=shelfLeft top=shelfTop width=bookW height=bookH
                  z-index=(s.book == fore ? 8 : 2)
                  translate=(s.book == fore ? `${pickX}px ${pickY}px` : `${(i % shelfCols) * (bookW + shelfGap)}px ${floor(i / shelfCols) * rowH}px`)
                  scale=(s.book == fore ? pickScale : 1)
                  transition=(still ? "none" : "translate 620ms cubic-bezier(.2,.9,.25,1.06), scale 620ms cubic-bezier(.2,.9,.25,1.06)")
                  BookCover(src=s.cover, title=s.title, w=bookW)
              // The picked book's controls, on glass at the foot of the screen.
              for s in shelf.filter(x => x.book == fore) key=s.book
                column position="absolute" left=16 right=16 bottom=(wide ? "calc(env(safe-area-inset-bottom) + 12px)" : "calc(env(safe-area-inset-bottom) + 90px)") z-index=9 margin="0 auto" max-width="27.5rem" gap=14 padding="18px 18px 18px 22px" border-radius=34
                  backgroundMaterial="glass" class=Lift testId="picked" animation=(still ? "none" : "arrive 480ms cubic-bezier(.2,.7,.2,1) both")
                  row align-items="center" gap=14
                    button press=openPicked(s) appearance="none" padding=0 text-align="start" cursor="pointer" flex=1 min-width=0 testId="picked-open" -exact-press-opacity=0.6
                      column gap=3
                        text s.title font-weight=400 font-size="1.25rem" color="#14171f" line-clamp=1 testId="picked-title"
                        text s.author.toUpperCase() font-weight=600 font-size="0.625rem" letter-spacing="0.06em" color="#626777" line-clamp=1
                    button press=playPicked(s) appearance="none" aria-label=(s.gen != "" ? "Play" : "Open") testId="picked-play" width=58 height=58 min-width=58 padding=0 flex-shrink=0 border-radius=999
                      display="flex" align-items="center" justify-content="center" background-color="#14171f" cursor="pointer" box-shadow="0 14px 30px -12px rgba(20,23,31,0.55)"
                      -exact-press-scale=0.9 -exact-press-haptic="impact-medium"
                      image (s.gen != "" ? "symbol:play-fill" : "symbol:forward-chevron") color="#f4f2ec" width=20 height=20
                  if s.gen != ""
                    view height=3 background-color="rgba(20,23,31,0.12)" border-radius=2
                      view height=3 width=`${round(s.frac * 100)}%` background-color="#14171f" border-radius=2
                  row justify-content="space-between" gap=12
                    text (s.left != "" ? s.left : s.chapter) font-size="0.8125rem" color="#14171f" line-clamp=1 testId="picked-left"
                    text (s.when != "" ? s.when : s.left != "" ? s.chapter : "") font-size="0.8125rem" color="#626777" line-clamp=1 testId="picked-when"
            if wide
              TopBar(active="home")
        // A book: its cover, lit from behind by itself, what it is, and the audiobooks made of it.
        if e.name == "book"
          column navigationKey=`${e.id}` navigationBar="transparent" navigationScroll="book-scroll" position="absolute" inset=0 background-color="#eceef2" status-bar-style="dark-content" testId="book"
            if detail.book.id == e.params.id and detail.book.cover != ""
              view position="absolute" top=0 left=0 right=0 height=(wide ? 520 : 460) overflow="hidden" pointer-events="none"
                image detail.book.cover alt="" position="absolute" top="-20%" left="-20%" width="140%" height="140%" object-fit="cover" filter="blur(48px) saturate(1.4)" opacity=0.6
                view position="absolute" inset=0 background-image="linear-gradient(180deg, rgba(236,238,242,0.25) 0%, rgba(236,238,242,0.6) 60%, #eceef2 100%)"
            scroll id="book-scroll" position="absolute" top=0 left=0 width="100%" height="100%" overflow-x="hidden" overflow-y="auto"
              if detail.book.id != e.params.id
                column height=viewport.height justify-content="center" align-items="center"
                  progress aria-label="Loading" testId="book-loading"
              else
                view height="env(safe-area-inset-top)" flex-shrink=0
                column margin="0 auto" width="100%" max-width=1000 box-sizing="border-box" padding=(wide ? "104px 48px 96px" : "64px 20px 200px") gap=(wide ? 32 : 36)
                  // The app has the navigation bar's Back; the web draws its own.
                  if not app.ok
                    button press=back aria-label="Back" testId="book-back" class=Chip align-self="flex-start" margin-left=-12 -exact-press-opacity=0.6
                      image "symbol:back" color="#14171f" font="-exact-subheadline"
                      text "Back" font-size="0.9375rem" color="#14171f"
                  view display="flex" flex-direction=(wide ? "row" : "column") gap=(wide ? 56 : 28) align-items=(wide ? "flex-start" : "center")
                    view animation=(still ? "none" : "arrive 800ms cubic-bezier(.2,.7,.2,1) both")
                      BookCover(src=detail.book.cover, title=detail.book.title, w=(wide ? 260 : 190))
                    column flex=1 min-width=0 gap=18 align-items=(wide ? "flex-start" : "center")
                      column gap=10 align-items=(wide ? "flex-start" : "center")
                        if wide
                          text detail.book.title role="heading" aria-level=1 font-weight=700 font-size="2.875rem" line-height=1.5 color="#14171f" text-align=(wide ? "start" : "center") testId="book-title"
                        else
                          text detail.book.title role="heading" aria-level=1 font-weight=700 font-size="min(-exact-large-title, 48px)" line-height=1.5 color="#14171f" text-align=(wide ? "start" : "center") testId="book-title"
                        text detail.book.author.toUpperCase() font-weight=600 font-size="0.75rem" line-height=1.5 letter-spacing="0.06em" color="#4a4f5c" text-align=(wide ? "start" : "center")
                      // The book in numbers: when it came out, its audiobooks, and how far the first is narrated.
                      row gap=(wide ? 40 : 28) align-items="flex-start" flex-wrap="wrap" justify-content=(wide ? "flex-start" : "center") padding-top=4 testId="book-stats"
                        if detail.book.year > 0
                          Stat(value=`${detail.book.year}`, label="Published")
                        Stat(value=`${detail.versions.length}`, label=(detail.versions.length == 1 ? "Audiobook" : "Audiobooks"))
                        for v in leadVersion key=v.id
                          Stat(value=`${v.total}`, label="Chapters")
                          Stat(value=`${v.done}`, label="Narrated")
                      BookAction(playing=bookPlaying, press=bookAction)
                      if detail.book.description != ""
                        text detail.book.description white-space="pre-line" font-size="1rem" line-height=1.65 color="#2c3140" max-width=600 padding-top=6 testId="book-description"
                      link href=goodreads(detail.book) testId="goodreads" -exact-press-opacity=0.55
                        text "Goodreads" font-size="0.9375rem" color="#14171f" border-bottom="1px solid rgba(20,23,31,0.35)" padding-bottom=1
                  column gap=16
                    SectionTitle(label="Audiobooks")
                    if detail.versions.length == 0
                      text "None yet." font-weight=400 font-size="1.25rem" color="#14171f" testId="no-versions"
                    else
                      column
                        for v in detail.versions key=v.id
                          VersionRow(version=v, listen=listen)
                    if playable.length > 0
                      button press=startImport appearance="none" testId="make-another" align-self="flex-start" display="flex" align-items="center" gap=8 padding="6px 0" cursor="pointer" -exact-press-opacity=0.6
                        text "Make another audiobook" font-size="0.9375rem" color="#14171f" border-bottom="1px solid rgba(20,23,31,0.3)" padding-bottom=2
            if wide
              TopBar(active="")
        // Import: where a book comes from before it is narrated. Anyone can search for it in the
        // browser; signed in, upload it or pick a download, then the voice and the consent.
        if e.name == "create"
          column navigationKey=`${e.id}` navigationScroll="create-form" position="absolute" inset=0 display="flex" flex-direction="column" background-color="#eceef2" testId="create"
            // On iOS the navigation bar: its Back, and the title.
            header display="flex" align-items="center" gap=12 padding=(wide ? "18px 7vw" : "12px 20px")
              button id="back" press=back aria-label="Back" testId="create-cancel"
                image "symbol:back"
              text "Import" role="heading" aria-level=1
            scroll id="create-form" flex=1 min-height=0 width="100%" overflow-x="hidden" overflow-y="auto"
              column margin="0 auto" width="100%" max-width=640 box-sizing="border-box" padding=(wide ? "40px 48px 96px" : "12px 20px 72px") gap=(wide ? 44 : 36)
                row gap=20 align-items="center"
                  BookCover(src=detail.book.cover, title=detail.book.title, w=(wide ? 72 : 60))
                  column flex=1 min-width=0 gap=6
                    text detail.book.title font-weight=600 font-size="1.0625rem" color="#14171f" line-clamp=2
                    text detail.book.author font-size="0.9375rem" color="#4a4f5c" line-clamp=1
                // Find it yourself: the browser searches for the book; what it downloads is uploaded below.
                column gap=14 testId="find"
                  SectionTitle(label="Find the book")
                  row gap=10 flex-wrap="wrap"
                    button press=openSearch(libgenSearch(detail.book)) buttonStyle="glass" testId="find-libgen"
                      text "LibGen"
                    button press=openSearch(zlibSearch(detail.book)) buttonStyle="glass" testId="find-zlibrary"
                      text "Z-Library"
                    button press=openSearch(webSearch(detail.book)) buttonStyle="glass" testId="find-web"
                      text "Search the web"
                column gap=14
                  SectionTitle(label="Book file")
                  if pending(bookSources)
                    row gap=12 align-items="center"
                      progress aria-label="Finding book files"
                      text "Finding EPUB and PDF files…" font-size="0.9375rem" color="#6b7080"
                  else if failed(bookSources)
                    text "Book downloads aren’t reachable. Upload a file, or close and reopen this to try again." font-size="0.9375rem" line-height=1.45 color="#6b7080" testId="source-error"
                  else if bookSources.available and bookSources.files.length > 0
                    select value=sourceId change=pickSource aria-label="Book download" testId="book-source" width="100%" box-sizing="border-box"
                      font-size="1.0625rem" color="#14171f" background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.35)" border-radius=0 padding="10px 0" outline="none"
                      option "Download a copy…" value=""
                      for f in bookSources.files key=f.id
                        option f.label value=f.id
                  else
                    text (bookSources.available ? "No EPUB or PDF download found. Upload your own file." : "Book downloads aren’t connected. Upload your own file.") font-size="0.9375rem" line-height=1.45 color="#6b7080" testId="source-empty"
                  if sourceId != ""
                    text "This file will be downloaded and split into chapters, and its first chapter narrated in your voice." font-size="0.875rem" color="#6b7080" testId="source-note"
                  input type="url" value=link input=editLink placeholder="Or paste a link to an EPUB, PDF or TXT" aria-label="Link to a book file" testId="link"
                    autocapitalize="none" autocomplete="off" spellcheck=false
                    width="100%" box-sizing="border-box" appearance="none" font-size="1rem" color="#14171f"
                    background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.35)" border-radius=0 padding="10px 0" outline="none"
                    ::placeholder
                      color="#6b7080"
                  if link.trim() != ""
                    text "The server downloads this file (HTTPS, under 50 MB) and splits it into chapters, and its first chapter is narrated in your voice." font-size="0.875rem" line-height=1.45 color="#6b7080" testId="link-note"
                  row gap=16 align-items="center" padding="10px 0" border-bottom="1px solid rgba(20,23,31,0.08)"
                    text (fileName == "" ? "Or upload an EPUB, PDF or TXT" : fileName) flex=1 min-width=0 line-clamp=1 font-size="1rem"
                      color=(fileName == "" ? "#6b7080" : "#14171f") testId="file-name"
                    button press=chooseFile appearance="none" testId="choose-file" padding="4px 0" cursor="pointer" flex-shrink=0
                      text (fileName == "" ? "Choose  →" : "Change  →") font-size="0.9375rem" color="#14171f" border-bottom="1px solid rgba(20,23,31,0.3)" padding-bottom=2
                    input type="file" id="upload" display="none" change=picked testId="upload"
                column gap=14
                  SectionTitle(label="Narration")
                  select value=model change=pickModel aria-label="Model" testId="model" width="100%" box-sizing="border-box"
                    font-size="1.0625rem" color="#14171f" background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.35)" border-radius=0 padding="10px 0" outline="none"
                    option "Choose a model…" value=""
                    for m in models key=m.id
                      option m.name value=m.id
                  if fishModel
                    select value=voicePref.id change=pickVoice aria-label="Voice" testId="create-voice" width="100%" box-sizing="border-box"
                      font-size="1.0625rem" color="#14171f" background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.35)" border-radius=0 padding="10px 0" outline="none"
                      option "Fish’s default voice" value=""
                      if voicePref.id != "" and voiceList.filter(v => v.id == voicePref.id).length == 0
                        option voicePref.title value=voicePref.id
                      for v in voiceList key=v.id
                        option v.title value=v.id
                  else if voices.length > 0
                    select value=voice change=editVoice aria-label="Voice" testId="voice" width="100%" box-sizing="border-box"
                      font-size="1.0625rem" color="#14171f" background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.35)" border-radius=0 padding="10px 0" outline="none"
                      option "Default voice" value=""
                      for v in voices key=v
                        option v value=v
                column gap=14
                  SectionTitle(label="Shown as")
                  input value=me input=editMe placeholder=(account.name == "" ? "Your name (optional)" : account.name) aria-label="Shown as" testId="me"
                    width="100%" box-sizing="border-box" appearance="none" font-weight=400 font-size="1.25rem" color="#14171f"
                    background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.35)" border-radius=0 padding="8px 0" outline="none"
                    ::placeholder
                      color="#8a8f9c"
                  row gap=12 align-items="flex-start" padding-top=6
                    input type="checkbox" checked=rights change=setRights aria-label="I may share this" testId="rights" accent-color="#14171f" width=18 height=18 margin="2px 0 0" flex-shrink=0
                    column flex=1 min-width=0 gap=4
                      text "I may share this book" font-size="1rem" color="#14171f"
                      text "The audiobook is public. Use only books in the public domain or ones you hold the rights to." font-size="0.875rem" line-height=1.45 color="#6b7080" testId="rights-note"
                column gap=14 align-items="flex-start"
                  row gap=12 align-items="center"
                    button press=create buttonStyle="prominent-glass" testId="create-save" disabled=(not canCreate)
                      text "Make the audiobook"
                    if pending(created)
                      progress aria-label="Making"
                  if refusal != "" or createHint != ""
                    text (refusal != "" ? refusal : createHint) font-size="0.875rem" line-height=1.45 color=(refusal != "" ? "#b2463c" : "#6b7080") testId="create-hint"
                if account.signedIn
                  row gap=16 align-items="center" padding-top=8 border-top="1px solid rgba(20,23,31,0.08)"
                    text `Signed in as ${account.name}` flex=1 min-width=0 line-clamp=1 font-size="0.875rem" color="#6b7080" testId="account"
                    button press=signOut appearance="none" testId="sign-out" padding="4px 0" cursor="pointer"
                      text "Sign out" font-size="0.875rem" color="#4a4f5c" border-bottom="1px solid rgba(20,23,31,0.2)" padding-bottom=2
        // Add a Book, a sheet over Home: first the file (a big box to upload into, or a pasted link),
        // then the book it is, its chapters, and the voice to narrate it.
        if e.name == "add"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="add-form" position="absolute" inset=0 display="flex" flex-direction="column" background-color="#eceef2" testId="add"
            header display="flex" align-items="center" gap=12 padding="12px 20px"
              button id="back" press=back aria-label="Close" testId="add-close"
                image "symbol:close"
              text "Add a Book" role="heading" aria-level=2
            scroll id="add-form" flex=1 min-height=0 width="100%" overflow-x="hidden" overflow-y="auto"
              column margin="0 auto" width="100%" max-width=520 box-sizing="border-box" padding="24px 24px 64px" gap=28
                if not adding
                  // Step one: the file, and under it, tight to its edge, the other ways to one.
                  column gap=12
                    button press=chooseAddFile appearance="none" aria-label="Upload an EPUB, PDF or TXT" testId="add-upload-box" cursor="pointer"
                      width="100%" height=280 box-sizing="border-box" border="1.5px dashed rgba(20,23,31,0.18)" border-radius=28 background-color="rgba(255,255,255,0.45)"
                      display="flex" flex-direction="column" align-items="center" justify-content="center" gap=12 -exact-press-scale=0.98 -exact-press-haptic="impact-light"
                      image "symbol:document" color="#14171f" width=34 height=34
                      text "EPUB, PDF or TXT" font-size="0.875rem" color="#8a8f9c"
                    input type="file" id="add-upload" display="none" change=picked testId="add-upload"
                    row gap=18 justify-content="flex-start" padding-left=4
                      button commandfor="link-sheet" command="show-modal" appearance="none" testId="add-paste" padding="4px 0" cursor="pointer"
                        text "Paste link" font-size="0.9375rem" color="#14171f"
                      button press=openSearch("https://z-library.sk") appearance="none" testId="open-zlibrary" padding="4px 0" cursor="pointer"
                        text "Z-Library" font-size="0.9375rem" color="#6b7080"
                      button press=openSearch("https://libgen.li") appearance="none" testId="open-libgen" padding="4px 0" cursor="pointer"
                        text "LibGen" font-size="0.9375rem" color="#6b7080"
                  // A link: a small sheet of its own, the field and Add.
                  dialog id="link-sheet" aria-label="Paste a link" testId="link-sheet" width="100%"
                    column gap=18 width="100%" max-width=440 margin="0 auto" box-sizing="border-box" padding="28px 24px calc(env(safe-area-inset-bottom) + 20px)"
                      input type="url" value=link input=editLink submit=takeLink autofocus=true placeholder="https://" aria-label="Link to a book file" testId="add-link"
                        autocapitalize="none" autocomplete="off" spellcheck=false enterkeyhint="go"
                        width="100%" box-sizing="border-box" appearance="none" font-size="1.0625rem" color="#14171f"
                        background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.25)" border-radius=0 padding="12px 0" outline="none"
                      if refusal != ""
                        text refusal font-size="0.875rem" color="#b2463c" testId="add-error"
                      button press=takeLink buttonStyle="prominent-glass" testId="add-link-go" width="100%" disabled=(link.trim() == "")
                        text "Add"

                else if pending(preview) or (preview.title == "" and preview.error == "")
                  column height=360 align-items="center" justify-content="center"
                    progress aria-label="Reading the book" testId="add-reading"
                else if not preview.ok
                  column gap=20 align-items="center" padding-top=80
                    text (preview.error != "" ? preview.error : "That file isn’t a book we can read.") font-size="1rem" color="#14171f" text-align="center" testId="add-error"
                    button press=resetAdd appearance="none" testId="add-again" padding="4px 0" cursor="pointer"
                      text "Choose another" font-size="0.9375rem" color="#6b7080"
                else
                  // Step two: the book, in the lander's face, with room around it.
                  column gap=14 align-items="center" padding-top=24 testId="add-book"
                    BookCover(src=preview.cover, title=preview.title, w=168)
                    column gap=8 align-items="center" padding-top=18
                      text preview.title role="heading" aria-level=3 font-family="Jost" font-weight=300 font-size="1.75rem" line-height=1.25 letter-spacing="-0.01em" color="#14171f" text-align="center" testId="add-title"
                      if preview.author != ""
                        text preview.author.toUpperCase() font-family="Jost" font-weight=500 font-size="0.6875rem" letter-spacing="0.26em" color="#6b7080" text-align="center" testId="add-author"
                  column testId="add-chapters"
                    text `${preview.chapters.length} ${preview.chapters.length == 1 ? "chapter" : "chapters"}` font-size="0.8125rem" color="#8a8f9c" padding-bottom=6
                    for c, i in preview.chapters.slice(0, 40) key=i
                      row gap=14 padding="9px 0" border-top="1px solid rgba(20,23,31,0.06)"
                        text `${i + 1}` font-size="0.8125rem" color="#8a8f9c" width="1.75rem" font-variant-numeric="tabular-nums"
                        text c font-size="0.9375rem" color="#14171f" flex=1 min-width=0 line-clamp=1
                  column gap=10
                    select value=model change=pickModel aria-label="Model" testId="model" width="100%" box-sizing="border-box"
                      font-size="1rem" color="#14171f" background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.2)" border-radius=0 padding="10px 0" outline="none"
                      option "Model" value=""
                      for m in models key=m.id
                        option m.name value=m.id
                    if fishModel
                      select value=voicePref.id change=pickVoice aria-label="Voice" testId="create-voice" width="100%" box-sizing="border-box"
                        font-size="1rem" color="#14171f" background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.2)" border-radius=0 padding="10px 0" outline="none"
                        option "Default voice" value=""
                        if voicePref.id != "" and voiceList.filter(v => v.id == voicePref.id).length == 0
                          option voicePref.title value=voicePref.id
                        for v in voiceList key=v.id
                          option v.title value=v.id
                    else if voices.length > 0
                      select value=voice change=editVoice aria-label="Voice" testId="voice" width="100%" box-sizing="border-box"
                        font-size="1rem" color="#14171f" background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.2)" border-radius=0 padding="10px 0" outline="none"
                        option "Default voice" value=""
                        for v in voices key=v
                          option v value=v
                    row gap=10 align-items="center" padding-top=6
                      input type="checkbox" checked=rights change=setRights aria-label="I may share this book" testId="rights" accent-color="#14171f" width=18 height=18 flex-shrink=0
                      text "I may share this book" font-size="0.875rem" color="#6b7080"
                  column gap=12 align-items="center"
                    button press=create buttonStyle="prominent-glass" testId="create-save" disabled=(not canCreate)
                      text "Generate"
                    if pending(created)
                      progress aria-label="Starting"
                    if refusal != ""
                      text refusal font-size="0.875rem" color="#b2463c" text-align="center" testId="create-hint"
                    button press=resetAdd appearance="none" testId="add-again" padding="4px 0" cursor="pointer"
                      text "Choose another" font-size="0.875rem" color="#8a8f9c"
        // The player, in the dark: the cover lights the room, and the controls float on glass.
        if e.name == "play"
          column navigationKey=`${e.id}` navigationBar="none" navigationPresentation="fullscreen" navigationScroll="player" position="absolute" inset=0 background-color="#121419" color-scheme="dark" status-bar-style="light-content" testId="player"
            background-image="radial-gradient(ellipse closest-side at 50% 32%, rgba(140,148,170,0.20) 0%, rgba(140,148,170,0) 100%)"
            if audiobook.id != e.params.gen
              column flex=1 justify-content="center" align-items="center" padding=24
                if failed(audiobook) and not pending(audiobook)
                  text "This audiobook isn’t here any more." font-weight=400 font-size="1.25rem" color="#eeebe4" text-align="center" testId="player-missing"
                else
                  progress aria-label="Loading" testId="player-loading"
            else
              if audiobook.cover != ""
                view position="absolute" top=0 left=0 right=0 height="78%" overflow="hidden" pointer-events="none"
                  image audiobook.cover alt="" position="absolute" top="-20%" left="-20%" width="140%" height="140%" object-fit="cover" filter="blur(56px) saturate(1.5)" opacity=0.7
                  view position="absolute" inset=0 background-image="linear-gradient(180deg, rgba(18,20,25,0.3) 0%, rgba(18,20,25,0.62) 55%, #121419 100%)"
              scroll id="player" position="absolute" top=0 left=0 width="100%" height="100%" overflow-x="hidden" overflow-y="auto" scrollbar-width="none"
                view height="env(safe-area-inset-top)" flex-shrink=0
                column margin="0 auto" width="100%" max-width=560 box-sizing="border-box" padding=(wide ? "80px 32px 80px" : "68px 22px 64px") gap=(wide ? 32 : 30)
                  column align-items="center" gap=28
                    view animation=(still ? "none" : "arrive 900ms cubic-bezier(.2,.7,.2,1) both")
                      scale=(held ? 0.92 : 1) transition="scale 500ms cubic-bezier(.2,.9,.3,1.15)"
                      BookCover(src=audiobook.cover, title=audiobook.title, w=playerCover)
                    column align-items="center" gap=8
                      if wide
                        text audiobook.title role="heading" aria-level=1 font-weight=700 font-size="2rem" line-height=1.5 color="#eeebe4" text-align="center"
                      else
                        text audiobook.title role="heading" aria-level=1 font-weight=700 font-size="min(-exact-title1, 40px)" line-height=1.5 color="#eeebe4" text-align="center"
                      text audiobook.author.toUpperCase() font-weight=600 font-size="0.6875rem" letter-spacing="0.06em" color="#b5b2aa" text-align="center"
                      text trackTitle(audiobook, track) font-size="0.9375rem" color="#d6d3cb" text-align="center" line-height=1.4 line-clamp=2 padding-top=8 testId="now-playing"
                  // Being prepared, or couldn't be: no chapters yet.
                  if audiobook.status != "ready"
                    row gap=12 align-items="center" justify-content="center" padding="18px 20px" border-radius=30 backgroundMaterial="glass" testId="preparing"
                      if audiobook.status != "failed"
                        progress aria-label="Preparing"
                      text (audiobook.status == "failed" ? audiobook.error : "Preparing the book…") font-size="1rem" line-height=1.4
                        color=(audiobook.status == "failed" ? "#f0a093" : "#d6d3cb") text-align="center"
                  else if playSrc != ""
                    column gap=6
                      input type="range" min=0 max=max(1, round(duration)) step=1 value=round(now) input=scrub aria-label="Position" testId="scrub" width="100%" accent-color="#eeebe4"
                      row justify-content="space-between"
                        text clock(now) font-size="0.75rem" color="#b5b2aa" testId="elapsed"
                        text (duration > 0 ? `−${clock(duration - now)}` : "") font-size="0.75rem" color="#b5b2aa"
                    column gap=12
                      row justify-content="space-between" align-items="center" padding="10px 18px" border-radius=999 backgroundMaterial="glass"
                        button press=cycleRate appearance="none" aria-label="Speed" testId="rate" min-width=48 padding="8px 0" cursor="pointer" -exact-press-scale=0.9
                          text rateText(rate) font-weight=500 font-size="0.9375rem" color="#eeebe4" text-align="center"
                        button press=back15 appearance="none" aria-label="Back 15 seconds" testId="back15" padding=8 cursor="pointer" -exact-press-scale=0.88 -exact-press-haptic="impact-light"
                          image "symbol:skip-back-15" color="#eeebe4" width=28 height=28
                        button press=toggle appearance="none" aria-label=(held ? "Play" : "Pause") aria-keyshortcuts="Space" testId="toggle"
                          width=68 height=68 min-width=68 padding=0 flex-shrink=0 border-radius=999 display="flex" align-items="center" justify-content="center" background-color="#eeebe4" cursor="pointer"
                          box-shadow="0 14px 36px -10px rgba(0,0,0,0.6)" -exact-press-scale=0.9 -exact-press-haptic="impact-medium"
                          image (held ? "symbol:play-fill" : "symbol:pause-fill") color="#14171f" width=26 height=26
                        button press=fwd30 appearance="none" aria-label="Forward 30 seconds" testId="fwd30" padding=8 cursor="pointer" -exact-press-scale=0.88 -exact-press-haptic="impact-light"
                          image "symbol:skip-forward-30" color="#eeebe4" width=28 height=28
                        button popovertarget="sleep-menu" appearance="none" aria-label=(sleepMins == 0 ? "Sleep timer" : `Sleep timer: ${sleepText(sleepMins, sleepLeft)}`) testId="sleep"
                          min-width=48 padding="8px 0" cursor="pointer" display="flex" justify-content="center" -exact-press-scale=0.9 -exact-press-haptic="selection"
                          image "symbol:moon" color=(sleepMins != 0 ? "#eeebe4" : "#8f8c85") width=20 height=20
                      if sleepMins != 0
                        text sleepText(sleepMins, sleepLeft) font-size="0.8125rem" color="#d6d3cb" text-align="center" testId="sleep-left"
                    // The sleep timer's choices, as the platform's menu; a choice checks it.
                    column id="sleep-menu" popover="auto" role="menu" aria-label="Sleep timer"
                      button press=setSleep(0) aria-checked=(sleepMins == 0) popovertarget="sleep-menu" popovertargetaction="hide" testId="sleep-off"
                        text "Off"
                      button press=setSleep(15) aria-checked=(sleepMins == 15) popovertarget="sleep-menu" popovertargetaction="hide" testId="sleep-15"
                        text "15 minutes"
                      button press=setSleep(30) aria-checked=(sleepMins == 30) popovertarget="sleep-menu" popovertargetaction="hide" testId="sleep-30"
                        text "30 minutes"
                      button press=setSleep(60) aria-checked=(sleepMins == 60) popovertarget="sleep-menu" popovertargetaction="hide" testId="sleep-60"
                        text "1 hour"
                      button press=setSleep(-1) aria-checked=(sleepMins == -1) popovertarget="sleep-menu" popovertargetaction="hide" testId="sleep-chapter"
                        text "End of chapter"
                  // A chapter with no audio yet: the player stops here and offers to narrate it.
                  else
                    column gap=12 align-items="center" padding="22px 20px" border-radius=30 backgroundMaterial="glass" testId="not-narrated"
                      text `Chapter ${track + 1} isn’t narrated yet.` font-weight=400 font-size="1.25rem" line-height=1.45 color="#eeebe4" text-align="center"
                      if inFlight(trackStatus(audiobook, track))
                        row gap=10 align-items="center"
                          progress aria-label="Narrating"
                          text "Narrating. It plays here when it’s ready." font-size="0.9375rem" color="#d6d3cb"
                      else if trackStatus(audiobook, track) == "unavailable"
                        text "Its text wasn’t kept. Make a new audiobook of this book to hear it." font-size="0.9375rem" line-height=1.45 color="#d6d3cb" text-align="center"
                      else
                        button press=generate(track) buttonStyle="glass" aria-label=`Generate chapter ${track + 1}` testId="generate-current" disabled=(atLimit or genPending)
                          text "Generate"
                  if genRefusal != ""
                    text genRefusal font-size="0.875rem" line-height=1.45 color="#f0a093" text-align="center" testId="generate-error"
                  column padding="20px 20px 8px" border-radius=30 backgroundMaterial="glass" testId="chapters"
                    row align-items="baseline" gap=12 padding-bottom=8
                      text "CHAPTERS" flex=1 font-weight=600 font-size="0.6875rem" letter-spacing="0.06em" color="#b5b2aa"
                      if account.signedIn and audiobook.mine > 0
                        text `${audiobook.mine} of ${audiobook.limit} in progress` font-size="0.8125rem" color=(atLimit ? "#eeebe4" : "#b5b2aa") testId="in-progress"
                    for c in audiobook.chapters key=c.idx
                      row align-items="center" column-gap=12 flex-wrap="wrap" border-top="1px solid rgba(238,235,228,0.1)" testId=`chapter-${c.idx}`
                        // Narrated: a tap plays it (the one playing shows its waveform). Not yet: its row offers Generate.
                        if c.src != ""
                          button press=playTrack(c.idx) appearance="none" text-align="start" display="flex" align-items="center" gap=16 padding="13px 0" flex="1 1 10rem" min-width=0
                            cursor="pointer" aria-current=(c.idx == track ? "true" : "false") testId=`track-${c.idx}` -exact-press-opacity=0.6
                            ChapterLine(chapter=c, current=(c.idx == track), kept=(keptAt(offline, audiobook.id, c.idx) != ""))
                            image (c.idx == track ? "symbol:waveform" : "symbol:play-fill") color="#eeebe4" font="-exact-callout" flex-shrink=0
                        else
                          row align-items="center" gap=16 padding="13px 0" flex="1 1 10rem" min-width=0 testId=`track-${c.idx}`
                            ChapterLine(chapter=c, current=(c.idx == track), kept=false)
                        if c.status == "idle" or c.status == "failed"
                          button press=generate(c.idx) buttonStyle="glass" aria-label=`Generate chapter ${c.idx + 1}` testId=`generate-${c.idx}` disabled=(atLimit or genPending) flex-shrink=0 margin-bottom=6
                            text (c.status == "failed" ? "Retry" : "Generate")
                        else if inFlight(c.status)
                          progress aria-label=`Narrating chapter ${c.idx + 1}` flex-shrink=0
                    if atLimit
                      text `${audiobook.limit} of ${audiobook.limit} in progress. Generate again when one finishes.` font-size="0.8125rem" line-height=1.45 color="#b5b2aa" padding="10px 0 6px" testId="at-limit"
                  // Download: the narrated chapters kept on this device, to play without a connection.
                  if narratedHere > 0 or anyKept
                    column gap=14 padding="18px 20px" border-radius=30 backgroundMaterial="glass" testId="download-box"
                      row gap=14 align-items="center"
                        image (keptHere > 0 and keptHere >= narratedHere ? "symbol:checkmark" : savingHere ? "symbol:download-pending" : "symbol:download") color="#eeebe4" font-size="1.25rem" flex-shrink=0
                        column flex=1 min-width=0 gap=3
                          text savedTitle(keptHere, narratedHere, savingHere) font-size="1rem" color="#eeebe4" testId="download-state"
                          if not savingHere
                            text savedNote(keptHere, narratedHere) font-size="0.8125rem" line-height=1.4 color="#b5b2aa"
                      if savingHere
                        progress value=keptHere max=max(1, narratedHere) aria-label="Downloading" testId="download-progress" width="100%" accent-color="#eeebe4"
                      else
                        row gap=10 flex-wrap="wrap"
                          if keptHere < narratedHere
                            button press=download buttonStyle="glass" testId="download" disabled=(pending(savedAll) or pending(unsaved))
                              text (keptHere > 0 ? "Download the rest" : "Download")
                          if anyKept
                            button press=unsave buttonStyle="glass" testId="remove-download" disabled=(pending(savedAll) or pending(unsaved))
                              text "Remove download"
                      if saveError != ""
                        text saveError font-size="0.8125rem" line-height=1.45 color="#f0a093" testId="download-error"
                  // Its maker may delete it: its audio goes for everyone.
                  if audiobook.owner
                    if confirmDelete
                      column gap=12 align-items="center" padding="18px 20px" border-radius=30 backgroundMaterial="glass" testId="delete-confirm-box"
                        text "Delete this audiobook? Its chapters are removed for everyone." font-size="0.9375rem" line-height=1.45 color="#eeebe4" text-align="center"
                        row gap=12
                          button press=remove appearance="none" testId="delete-confirm" disabled=pending(removed) padding="0 20px" height=40 border-radius=999 background-color="#f0a093" cursor="pointer" -exact-press-haptic="impact-medium"
                            text "Delete" font-weight=500 font-size="0.9375rem" color="#14171f"
                          button press=keepIt appearance="none" testId="delete-cancel" padding="0 20px" height=40 border-radius=999 border="1px solid rgba(238,235,228,0.35)" cursor="pointer"
                            text "Keep it" font-size="0.9375rem" color="#eeebe4"
                    else
                      button press=askDelete appearance="none" testId="delete" align-self="center" padding="6px 0" cursor="pointer"
                        text "Delete this audiobook" font-size="0.875rem" color="#b5b2aa" border-bottom="1px solid rgba(238,235,228,0.25)" padding-bottom=2
                  text `${audiobook.model} · ${audiobook.by}` font-size="0.8125rem" color="#9a978f" text-align="center"
            row align-items="center" padding=(wide ? "24px 7vw" : "8px 16px") position="absolute" top="env(safe-area-inset-top)" left=0 right=0 z-index=5 pointer-events="none"
              button press=back buttonStyle="glass" aria-label="Close" testId="player-back" pointer-events="auto"
                image (app.ok ? "symbol:sf/chevron.down" : "symbol:back")
      // The one player, for every screen: it keeps playing while the listener browses. The lock
      // screen's skips are the player's own, back 15 and ahead 30.
      if playSrc != ""
        audio id="player-audio" src=playSrc paused=held playbackRate=rate preload="auto"
          timeupdate=tick durationchange=gotDuration loadedmetadata=resumeAt ended=chapterEnded play=played pause=stopped
          metadata=MediaMetadata(title=trackTitle(audiobook, track), artist=audiobook.author, album=audiobook.title, artwork=audiobook.cover)
          seekbackwardOffset=15 seekforwardOffset=30
          seekbackward=back15 seekforward=fwd30 nexttrack=nextTrack previoustrack=prevTrack testId="audio"
      // The bar at the foot: Home's + on the right, and what's playing grown out of it, one
      // Liquid Glass group, so the player swells from the + and they merge while close.
      if (wide or phoneDock) and (miniOn or top(nav).name == "home")
        row position="absolute" left=0 right=0 bottom=0 justify-content="center" pointer-events="none" z-index=20 testId="dock"
          padding=(wide ? "0 16px 24px" : "0 16px clamp(14px, calc(env(safe-area-inset-bottom) - 8px), 40px)")
          row width="100%" max-width="25rem" align-items="center" justify-content="flex-end" gap=10 glassGroup=16 pointer-events="none"
            // The mini player: the chapter playing, to pause or play; a tap on it opens the player.
            if miniOn
              row flex=1 min-width=0 box-sizing="border-box" align-items="center" gap=6 padding=6 border-radius=999 position="relative" overflow="hidden"
                backgroundMaterial="glass" pointer-events="auto" testId="mini-player"
                button press=openPlayer appearance="none" aria-label=`Now playing: ${trackTitle(audiobook, track)}, ${audiobook.title}` testId="mini-open" text-align="start" cursor="pointer"
                  flex=1 min-width=0 display="flex" align-items="center" gap=12 padding="0 4px 0 0" -exact-press-opacity=0.7 -exact-press-haptic="impact-light"
                  if audiobook.cover != ""
                    image audiobook.cover alt="" width=44 height=44 border-radius=999 object-fit="cover" flex-shrink=0
                  else
                    view width=44 height=44 border-radius=999 background-color="#2a2d36" flex-shrink=0
                  column flex=1 min-width=0 gap=1 font-size="min(-exact-subheadline, 20px)"
                    text trackTitle(audiobook, track) font-size="1em" color="#14171f" line-clamp=1 testId="mini-title"
                    text audiobook.title font-size="0.8em" color="#5c6170" line-clamp=1 testId="mini-book"
                button press=toggle appearance="none" aria-label=(held ? "Play" : "Pause") testId="mini-toggle" disabled=(playSrc == "")
                  width=44 height=44 min-width=44 padding=0 flex-shrink=0 border-radius=999 display="flex" align-items="center" justify-content="center"
                  background-color="#14171f" opacity=(playSrc == "" ? 0.35 : 1) cursor="pointer" -exact-press-scale=0.9 -exact-press-haptic="impact-medium"
                  image (held ? "symbol:play-fill" : "symbol:pause-fill") color="#f4f2ec" font-size="min(-exact-subheadline, 18px)"
                // How far into the chapter: a hairline along the capsule's foot.
                view position="absolute" left=28 right=28 bottom=0 height=2 border-radius=1 background-color="rgba(20,23,31,0.1)" pointer-events="none"
                  view height=2 border-radius=1 background-color="#14171f" width=`${duration > 0 ? round(min(1, now / duration) * 100) : 0}%`
            // Add a book: a file, a link, or one found on Z-Library or LibGen.
            if top(nav).name == "home"
              button press=startAdd aria-label="Add a book" testId="home-add" class=Round width=56 height=56 min-width=56 flex-shrink=0 backgroundMaterial="glass" pointer-events="auto" -exact-press-haptic="impact-light"
                image "symbol:add" color="#14171f" width=22 height=22
      // A chapter this listener asked for is ready: a notice at the top, to play it.
      if notice != ""
        row position="absolute" top="calc(env(safe-area-inset-top) + 10px)" left=16 right=16 margin="0 auto" max-width="25rem" box-sizing="border-box" z-index=30
          align-items="center" gap=10 padding="8px 8px 8px 20px" border-radius=999 backgroundMaterial="glass" class=Lift color-scheme="light" role="status" testId="notice"
          animation=(still ? "none" : "dockIn 420ms cubic-bezier(.2,.9,.3,1.1) both")
          column flex=1 min-width=0 gap=1 font-size="min(-exact-subheadline, 20px)"
            text notice font-size="1em" color="#14171f" line-clamp=1 testId="notice-title"
            text `Ready to play · ${noticeBook}` font-size="0.8em" color="#5c6170" line-clamp=1
          button press=noticePlay appearance="none" aria-label=`Play ${notice}` testId="notice-play"
            height=40 padding="0 18px" flex-shrink=0 border-radius=999 display="flex" align-items="center" gap=6 background-color="#14171f" cursor="pointer" -exact-press-scale=0.94
            image "symbol:play-fill" color="#f4f2ec" font-size="min(-exact-caption1, 16px)"
            text "Play" font-weight=500 font-size="min(-exact-subheadline, 20px)" color="#f4f2ec"
          button press=clearNotice appearance="none" aria-label="Dismiss" testId="notice-close" class=Round width=40 height=40
            image "symbol:close" color="#5c6170" font-size="min(-exact-caption1, 16px)"
      // One sheet to log in or sign up, for whatever needs an account: Generate, a chapter, Make.
      // The app's own buttons, as the door's sheet has; the site needs Exact's (it holds the popup at the press).
      dialog id="account-sheet" aria-label="Log in or sign up" close=sheetClosed testId="account-sheet"
        column gap=12 align-items="stretch" width="100%" max-width=440 margin="0 auto" box-sizing="border-box" padding="32px 20px calc(env(safe-area-inset-bottom) + 20px)"
          text "Log in or sign up" role="heading" aria-level=2 font-family="system-ui" font-weight=700 font-size="1.625rem" text-align="center" color="#14171f" margin-bottom=20
          if app.ok
            button press=appleSignIn aria-label="Continue with Apple" testId="account-apple" class=Chip width="100%" height=56 border-radius=16 background-color="#000" gap=10 -exact-press-haptic="impact-light"
              image "symbol:sf/apple.logo" color="#fff" width=19 height=19
              text "Continue with Apple" font-family="system-ui" font-weight=600 font-size="1.0625rem" color="#fff"
            button press=googleSignIn aria-label="Continue with Google" testId="account-google" class=Chip width="100%" height=56 border-radius=16 background-color="#fff" border="1px solid #d6d8de" gap=10 -exact-press-haptic="impact-light"
              GoogleMark()
              text "Continue with Google" font-family="system-ui" font-weight=600 font-size="1.0625rem" color="#14171f"
          else
            exact-sign-in-button provider="google" theme="filled_black" shape="pill" press=googleSignIn testId="account-site-google" width="100%" height=52
          if signInError != ""
            text signInError color="#7a241c" font-family="system-ui" font-size="0.875rem" text-align="center" testId="account-error"

// What floats: a capsule to press, a round button, the ink pill of a screen's one main action.
style Chip
  appearance="none" display="flex" align-items="center" justify-content="center" gap=8 height=42 padding="0 18px" border-radius=999
  box-sizing="border-box" flex-shrink=0 cursor="pointer" -exact-press-scale=0.95 -exact-press-haptic="selection"
style Round
  appearance="none" display="flex" align-items="center" justify-content="center" width=44 height=44 padding=0 border-radius=999
  flex-shrink=0 cursor="pointer" -exact-press-scale=0.9 -exact-press-haptic="selection"
style Pill
  appearance="none" display="flex" align-items="center" justify-content="center" gap=10 height=50 padding="0 28px" border-radius=999
  background-color="#14171f" cursor="pointer" box-shadow="0 14px 30px -12px rgba(20,23,31,0.55)" -exact-press-scale=0.95 -exact-press-haptic="impact-medium"
style Lift
  box-shadow="0 12px 30px -14px rgba(20,24,36,0.32)"

// Google's "G", in its own colours.
component GoogleMark
  view
    svg viewBox="0 0 48 48" width=19 height=19 aria-hidden="true"
      path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
      path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
      path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
      path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"

// A chapter's line in the player's list: its number, its title (the one playing set heavier), and
// how its narration is going when it isn't narrated.
component ChapterLine
  props
    chapter: Chapter
    current: bool
    kept: bool
  view
    row flex=1 min-width=0 align-items="center" gap=16
      text `${chapter.idx + 1}` font-size="0.8125rem" color="#eeebe4" width=24 flex-shrink=0
      column flex=1 min-width=0 gap=2
        text chapter.title line-clamp=2 font-weight=(current ? 500 : 400) font-size="1rem" line-height=1.4 color="#eeebe4"
        if chapter.status != "ready" and chapterNote(chapter) != ""
          text (chapter.status == "failed" and chapter.error != "" ? chapter.error : chapterNote(chapter)) line-clamp=2 font-size="0.8125rem"
            color=(chapter.status == "failed" ? "#f6b8ad" : "#eeebe4") testId=`chapter-note-${chapter.idx}`
        else if kept
          row gap=5 align-items="center" testId=`chapter-kept-${chapter.idx}`
            image "symbol:checkmark" color="#b5b2aa" font-size="0.625rem"
            text "Downloaded" font-size="0.75rem" color="#b5b2aa"

// One of a book's numbers: the figure, and what it counts.
component Stat
  props
    value: string
    label: string
  view
    column gap=2 align-items="center" min-width=56
      text value font-weight=400 font-size="1.375rem" line-height=1.4 color="#14171f"
      text label.toUpperCase() font-weight=500 font-size="0.6875rem" letter-spacing="0.18em" color="#4a4f5c"

// A book's one action, on the platform's glass filled with the accent: Play once it has a narrated
// chapter, Generate (to Import) until then.
component BookAction
  props
    playing: bool
    press: action
  view
    if playing
      button press=press buttonStyle="prominent-glass" testId="listen"
        image "symbol:play-fill"
        text "Play"
    else
      button press=press buttonStyle="prominent-glass" testId="make"
        image "symbol:sparkles"
        text "Generate"

component TopBar
  props
    active: string
  view
    row align-items="center" gap=30 padding="22px 7vw" position="absolute" top=0 left=0 right=0 z-index=5
      background-color="rgba(236,238,242,0.72)" backdrop-filter="blur(14px)" border-bottom="1px solid rgba(20,23,31,0.06)"
      link href=path("lander") testId="top-exalt"
        text "EXALT" font-family="Jost" font-weight=500 font-size="0.875rem" letter-spacing="0.5em" color="#14171f"
      view flex=1
      link href=path("home") testId="top-home" padding="4px 0"
        text "Home" font-size="0.9375rem" color=(active == "home" ? "#14171f" : "#626777")
          border-bottom=(active == "home" ? "1px solid #14171f" : "1px solid transparent") padding-bottom=2

component SectionTitle
  props
    label: string
  view
    view font-size="min(-exact-body, 30px)"
      text label.toUpperCase() role="heading" aria-level=2 font-weight=600 font-size="0.6875em" letter-spacing="0.06em" color="#626777"

// A cover as a book: page edges under it and light along the spine. Without art, its title on cloth.
component BookCover
  props
    src: string
    title: string
    w: number
  view
    view position="relative" width=w height=round(w * 1.5) flex-shrink=0 border-radius=3 background-color="#2a2d36"
      box-shadow="1px 1px 0 #f3eee2, 2px 2px 0 #d6ccb5, 3px 3px 0 #efe8d8, 4px 4px 0 #c4b99f, 0 22px 34px -16px rgba(8,10,18,0.55)"
      if src != ""
        image src alt="" width="100%" height="100%" object-fit="cover" border-radius=3
      else
        column position="absolute" inset=0 padding=round(w * 0.12) justify-content="center" align-items="center"
          text title font-family="Jost" font-weight=300 font-size=max(11, round(w * 0.1)) line-height=1.2 color="#eeebe4" text-align="center" line-clamp=5
      view position="absolute" inset=0 border-radius=3 pointer-events="none"
        background-image="linear-gradient(90deg, rgba(0,0,0,0.28) 0%, rgba(255,255,255,0.12) 2.4%, rgba(0,0,0,0.06) 4.5%, rgba(0,0,0,0) 8%), linear-gradient(118deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 45%)"

component BookCard
  props
    book: Book
    w: number
  view
    link href=path("book", book.id) testId=`book-${book.id}` -exact-press-scale=0.96 -exact-press-haptic="selection"
      column gap=10
        BookCover(src=book.cover, title=book.title, w=w)
        column gap=2
          text book.title font-size="0.9375rem" color="#14171f" line-clamp=2
          text book.author font-size="0.8125rem" color="#626777" line-clamp=1
          if book.versions > 0
            text versionsText(book.versions) font-size="0.75rem" color="#4a4f5c"

component PlaceCard
  props
    place: Place
    resume: action
  view
    button press=resume(place) appearance="none" padding=0 text-align="start" cursor="pointer" flex-shrink=0 width=150 testId=`place-${place.gen}` -exact-press-scale=0.96 -exact-press-haptic="impact-light"
      column gap=10
        BookCover(src=place.cover, title=place.title, w=140)
        column gap=4
          text place.title font-size="0.9375rem" color="#14171f" line-clamp=1
          text `Chapter ${place.track + 1} of ${place.tracks}` font-size="0.8125rem" color="#626777"
          view height=2 width=140 background-color="rgba(20,23,31,0.12)" border-radius=1 margin-top=4
            view height=2 width=`${round(placeFrac(place) * 100)}%` background-color="#14171f" border-radius=1

component MineCard
  props
    item: Mine
    open: action
    w: number
  view
    button press=open(item) appearance="none" padding=0 text-align="start" cursor="pointer" testId=`mine-${item.gen}` -exact-press-scale=0.96 -exact-press-haptic="selection"
      column gap=10
        view position="relative" width=w
          BookCover(src=item.cover, title=item.title, w=w)
          if item.status != "ready"
            view position="absolute" inset=0 border-radius=3 background-color="rgba(18,20,25,0.45)"
        column gap=2
          text item.title font-size="0.9375rem" color="#14171f" line-clamp=2
          text mineText(item) font-size="0.8125rem" color=(item.status == "failed" ? "#a83a30" : "#5c6170")

component ResultRow
  props
    book: Book
  view
    link href=path("book", book.id) testId=`book-${book.id}` -exact-press-opacity=0.55 -exact-press-haptic="selection"
      row gap=18 align-items="center" padding="14px 0" border-bottom="1px solid rgba(20,23,31,0.08)"
        BookCover(src=book.cover, title=book.title, w=48)
        column flex=1 min-width=0 gap=3
          text book.title font-size="1.125rem" color="#14171f" line-clamp=1
          text byline(book) font-size="0.875rem" color="#626777" line-clamp=1
          if book.versions > 0
            text versionsText(book.versions) font-size="0.8125rem" color="#4a4f5c"
        image "symbol:forward-chevron" color="#9a9eab" width="0.75rem" height="0.75rem"

component SuggestionRow
  props
    book: Book
  view
    link href=path("book", book.id) role="option" testId=`suggest-${book.id}` padding="8px 16px" -exact-press-opacity=0.55 -exact-press-haptic="selection"
      row gap=12 align-items="center" flex=1 min-width=0
        BookCover(src=book.cover, title=book.title, w=28)
        column flex=1 min-width=0 gap=1
          text book.title font-size="0.9375rem" color="#14171f" line-clamp=1
          text byline(book) font-size="0.8125rem" color="#626777" line-clamp=1

component VersionRow
  props
    version: Version
    listen: action
  view
    // A prepared version opens the player, its chapters listed there to play or narrate.
    if version.status == "ready"
      button press=listen(version.id) appearance="none" text-align="start" display="flex" align-items="center" gap=16 padding="16px 0"
        border-bottom="1px solid rgba(20,23,31,0.08)" cursor="pointer" testId=`version-${version.id}` -exact-press-opacity=0.6 -exact-press-haptic="impact-medium"
        view width=40 height=40 border-radius=999 display="flex" align-items="center" justify-content="center" background-color=(version.done > 0 ? "#14171f" : "transparent") flex-shrink=0
          if version.done > 0
            image "symbol:play-fill" color="#f4f2ec" width=14 height=14
          else
            progress aria-label="Narrating"
        column flex=1 min-width=0 gap=2
          text `Read by ${readBy(version)}` font-size="1rem" color="#14171f" line-clamp=1
          text `${version.by} · ${statusText(version)}` font-size="0.8125rem" color="#5c6170" testId=`status-${version.id}`
        image "symbol:forward-chevron" color="#6b7080" width=12 height=12 flex-shrink=0
    else
      row testId=`version-${version.id}` align-items="center" gap=16 padding="16px 0" border-bottom="1px solid rgba(20,23,31,0.08)"
        view width=40 height=40 display="flex" align-items="center" justify-content="center" flex-shrink=0
          if version.status != "failed"
            progress aria-label="Preparing"
        column flex=1 min-width=0 gap=2
          text `Read by ${readBy(version)}` font-size="1rem" color="#14171f" line-clamp=1
          text statusText(version) font-size="0.8125rem" color=(version.status == "failed" ? "#a83a30" : "#5c6170") testId=`status-${version.id}`

// A voice's face: its picture, or its initial on a plain disc.
component VoiceFace
  props
    title: string
    cover: string
    size: number
  view
    if cover != ""
      image cover alt="" width=size height=size border-radius=999 object-fit="cover" flex-shrink=0
    else
      view width=size height=size border-radius=999 background-color="#d9dce3" display="flex" align-items="center" justify-content="center" flex-shrink=0
        text (title == "" ? "·" : title.slice(0, 1).toUpperCase()) font-weight=400 font-size=round(size * 0.42) color="#4a4f5c"

component VoiceRow
  props
    voice: Voice
    chosen: bool
    playing: bool
    audition: action
    choose: action
  view
    row gap=16 align-items="center" padding="16px 0" border-bottom="1px solid rgba(20,23,31,0.08)" testId=`voice-${voice.id}`
      VoiceFace(title=voice.title, cover=voice.cover, size=52)
      column flex=1 min-width=0 gap=3
        text voice.title font-size="1.0625rem" color="#14171f" line-clamp=1 text-overflow="ellipsis"
        if voice.description != ""
          text voice.description font-size="0.875rem" color="#626777" line-clamp=1 text-overflow="ellipsis"
      if voice.sample != ""
        button press=audition(voice.sample) aria-label=(playing ? "Stop sample" : "Hear sample") testId=`hear-${voice.id}` class=Round backgroundMaterial="glass"
          image (playing ? "symbol:stop-fill" : "symbol:play-fill") color="#14171f" width=13 height=13
      button press=choose(voice) testId=`use-${voice.id}` class=Chip height=40 padding="0 16px" min-width=64
        backgroundMaterial=(chosen ? "none" : "glass") background-color=(chosen ? "#14171f" : "rgba(20,23,31,0)")
        text (chosen ? "✓ Selected" : "Use") font-weight=500 font-size="0.875rem" color=(chosen ? "#f4f2ec" : "#14171f")

// The search field: a lit box with a glass, that lifts on focus and shows its own working —
// a turning ring where the clear button sits, and a line sweeping along its foot.
component SearchField
  props
    value: string
    hint: string
    label: string
    id: string
    focused: bool
    busy: bool
    still: bool
    big: bool
    edit: action
    enter: action
    focus: action
    blur: action
    clear: action
  view
    row position="relative" align-items="center" gap=12 width="100%" box-sizing="border-box" min-height=(big ? "3.75rem" : "3.375rem") padding="0 16px 0 18px"
      border-radius=999 overflow="hidden" backgroundMaterial="glass"
      box-shadow=(focused ? "0 16px 36px -16px rgba(20,24,36,0.45)" : "0 10px 26px -16px rgba(20,24,36,0.3)")
      transition="box-shadow 260ms ease"
      image "symbol:search" color=(focused ? "#14171f" : "#6b7080") width="1.25rem" height="1.25rem" flex-shrink=0
      // A text field with a search keyboard: the box draws its own glass and clear button.
      input type="text" inputmode="search" enterkeyhint="search" autocomplete="off" value=value input=edit submit=enter focus=focus blur=blur placeholder=hint
        aria-label=label testId=id flex=1 min-width=0 height="100%" box-sizing="border-box" appearance="none"
        font-weight=400 font-size=(big ? "1.375rem" : "1.1875rem") color="#14171f" background-color="transparent"
        border="none" border-radius=0 padding=0 outline="none"
        ::placeholder
          color="#8a8f9c"
      if busy
        if still
          text "Searching…" font-size="0.8125rem" color="#626777" flex-shrink=0 testId=`${id}-busy`
        else
          view width=18 height=18 box-sizing="border-box" border-radius=999 flex-shrink=0 testId=`${id}-busy`
            border="2px solid rgba(20,23,31,0.14)" border-top-color="#14171f" animation="spin 700ms linear infinite"
      else if value != ""
        button press=clear appearance="none" aria-label="Clear" testId=`${id}-clear` width=28 height=28 border-radius=999 flex-shrink=0
          display="flex" align-items="center" justify-content="center" background-color="rgba(20,23,31,0.07)" cursor="pointer"
          animation=(still ? "none" : "popIn 180ms ease both")
          image "symbol:close" color="#4a4f5c" width=10 height=10
      if busy and not still
        view position="absolute" left=0 bottom=0 width="35%" height=2 pointer-events="none"
          background-image="linear-gradient(90deg, rgba(20,23,31,0) 0%, rgba(20,23,31,0.75) 50%, rgba(20,23,31,0) 100%)"
          animation="sweep 1.1s ease-in-out infinite"

// A row still to come: the shape of a book or a voice, breathing, each a beat after the last.
component SkeletonRow
  props
    i: number
    still: bool
    face: bool
  view
    row gap=18 align-items="center" padding=(face ? "16px 0" : "14px 0") border-bottom="1px solid rgba(20,23,31,0.08)"
      animation=(still ? "none" : `breathe 1.3s ${i * 130}ms ease-in-out infinite`)
      view width=(face ? 52 : 48) height=(face ? 52 : 72) border-radius=(face ? 999 : 3) background-color="#d5d9e1" flex-shrink=0
      column flex=1 min-width=0 gap=9
        view height=14 width=`${62 - i * 8}%` border-radius=4 background-color="#d5d9e1"
        view height=10 width=`${40 - i * 4}%` border-radius=4 background-color="#dfe2e8"

keyframes spin
  to rotate="360deg"
keyframes sweep
  from translate="-100% 0px"
  to translate="290% 0px"
keyframes breathe
  50% opacity=0.4
keyframes popIn
  from opacity=0 scale=0.6
keyframes arrive
  from opacity=0 translate="0px 40px"
keyframes inkIn
  from opacity=0 translate="0px 10px"
// The dock changing what it holds: it gathers in from below, as a glass bar does.
keyframes dockIn
  from opacity=0 scale=0.9 translate="0px 14px"
keyframes drift
  50% translate="6% -2%"

// A book lying face up in the stack: its cover, its page edges under it, a sheen of light
// on the one in focus and shade on the ones below.
component Volume
  props
    book: Great
    depth: number
    n: number
    i: number
    w: number
    h: number
    dx: number
    dy: number
    dragging: bool
  view
    view position="absolute" left=0 top=0 width=w height=h z-index=volZ(depth, n) testId=`great-${book.id}`
      translate=`${volX(depth, n, i, w) + dx}px ${volY(depth, n, h) + dy}px` rotate=`${volRot(depth, n, i) + dx * 0.05}deg`
      scale=(dragging and depth == 0 ? 1.03 : 1 - min(depth, 5) * 0.012) opacity=volOpacity(depth, n)
      transition=(dragging and depth == 0 ? "scale 200ms ease" : "translate -exact-spring(150, 20, 1), rotate -exact-spring(150, 20, 1), scale -exact-spring(150, 20, 1), opacity 650ms ease")
      border-radius=3 background-color="#2a2d36"
      box-shadow="1px 1px 0 #f3eee2, 2px 2px 0 #ddd4bf, 3px 3px 0 #f3eee2, 4px 4px 0 #d6ccb5, 5px 5px 0 #efe8d8, 6px 6px 0 #c4b99f, 0 30px 50px -12px rgba(8,10,18,0.6)"
      image book.cover alt=(depth == 0 ? `${book.title}, ${book.author}` : "") width="100%" height="100%" object-fit="cover" border-radius=3
      view position="absolute" inset=0 border-radius=3 pointer-events="none"
        background-image="linear-gradient(90deg, rgba(0,0,0,0.30) 0%, rgba(255,255,255,0.12) 2.2%, rgba(0,0,0,0.06) 4%, rgba(0,0,0,0) 7%), linear-gradient(118deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0) 45%)"
      view position="absolute" inset=0 border-radius=3 pointer-events="none" background-color="#0b0d14"
        opacity=(min(depth, 5) * 0.1) transition="opacity 420ms ease"
