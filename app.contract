// Exalt: open audiobooks. Every book is one record (a Google Books volume or Open Library work); anyone can upload
// an EPUB, PDF or TXT of it and make an audiobook with the voice model they choose, which
// then sits on that book's page for everyone. app.ts asks server/index.ts for all of it.
// Listening needs no account; making an audiobook needs Sign in with Google.
use EmptyState from "exact:content"
use getIdentityCapabilities, IdentityCapabilities from "@exact/sign-in"
use getClientCapabilities, ClientCapabilities from "@exact/passkeys"

// The lander's face: Jost (SIL Open Font License), cut to static weights.
font "Jost"
  300 = "assets/fonts/Jost-Light.ttf"
  300 italic = "assets/fonts/Jost-LightItalic.ttf"
  400 = "assets/fonts/Jost-Regular.ttf"
  500 = "assets/fonts/Jost-Medium.ttf"

routes nav
  lander "/"
    home "/home"
      explore "/explore"
      voices "/voices"
      book "/book/:id"
        create "/book/:id/create"
      play "/play/:gen"

shape Book
  id: string
  title: string
  author: string
  year: number
  cover: string
  description: string
  versions: number

shape Version
  id: string
  by: string
  model: string
  voice: string
  status: string
  done: number
  total: number
  error: string
  sample: string
  voiceName: string

shape BookDetail
  book: Book
  versions: Version[]

shape BookSource
  id: string
  label: string

shape BookSources
  available: bool
  files: BookSource[]

shape Model
  id: string
  name: string
  voices: string[]

shape Track
  idx: number
  title: string
  src: string

shape Audiobook
  id: string
  book: string
  title: string
  author: string
  cover: string
  by: string
  model: string
  tracks: Track[]

shape Reply
  ok: bool
  error: string

shape Account
  signedIn: bool
  name: string

// Where the listener left off in an audiobook (kept on this device).
shape Place
  gen: string
  book: string
  title: string
  author: string
  cover: string
  track: number
  tracks: number
  time: number
  duration: number

// An audiobook the signed-in listener made.
shape Mine
  gen: string
  book: string
  title: string
  author: string
  cover: string
  status: string
  done: number
  total: number
  model: string
  voice: string

// A voice from Fish Audio's library (read through OpenRouter's Fish models), and the listener's choice.
shape Voice
  id: string
  title: string
  description: string
  cover: string
  sample: string
  languages: string
  uses: number

shape VoicePref
  id: string
  title: string
  cover: string

// One of the lander's great books: its Penguin cover ships in assets/covers.
shape Great
  id: string
  title: string
  author: string
  era: string
  cover: string

shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool

// The lander's stack. A book's depth is how far below the top it lies (0 is the one in focus);
// the last depth is the book just turned away, thrown off to the left, so going back brings it
// down onto the top again. The rest settle under the top at a slant of their own.
fn depthOf(i: number, cur: number, n: number): number = (i - cur + n) % n
fn gone(d: number, n: number): bool = d == n - 1 and n > 1
fn slant(i: number): number = ((i * 47) % 13 - 6) * 0.85
fn volX(d: number, n: number, i: number, w: number): number = gone(d, n) ? -w * 2.1 : d == 0 ? 0 : ((i * 29) % 9 - 4) * 4
fn volY(d: number, n: number, h: number): number = gone(d, n) ? -h * 0.12 : min(d, 5) * 8
fn volRot(d: number, n: number, i: number): number = gone(d, n) ? -26 : d == 0 ? slant(i) * 0.2 : slant(i)
fn volOpacity(d: number, n: number): number = gone(d, n) ? 0 : d > 5 ? 0 : 1
fn volZ(d: number, n: number): number = gone(d, n) ? n + 1 : n - d
fn mag(x: number): number = max(x, -x)

fn two(n: number): string = n < 10 ? `0${n}` : `${n}`
fn clock(s: number): string = s >= 3600 ? `${floor(s / 3600)}:${two(floor(s / 60) % 60)}:${two(floor(s) % 60)}` : `${floor(max(0, s) / 60)}:${two(floor(max(0, s)) % 60)}`
fn placeFrac(p: Place): number = p.tracks == 0 ? 0 : min(1, (p.track + (p.duration > 0 ? p.time / p.duration : 0)) / p.tracks)
fn mineText(m: Mine): string = m.status == "ready" ? `${m.total} ${m.total == 1 ? "chapter" : "chapters"}` : m.status == "failed" ? "Didn’t finish" : m.status == "queued" ? "Waiting to start…" : m.total == 0 ? "Preparing book…" : `Voicing ${m.done} of ${m.total}…`
fn readBy(v: Version): string = v.voiceName != "" ? v.voiceName : v.model
fn nextRate(r: number): number = r == 1 ? 1.25 : r == 1.25 ? 1.5 : r == 1.5 ? 2 : r == 2 ? 0.75 : 1
fn rateText(r: number): string = r == 1 ? "1×" : r == 1.25 ? "1.25×" : r == 1.5 ? "1.5×" : r == 2 ? "2×" : "0.75×"
fn byline(b: Book): string = b.year > 0 ? `${b.author} · ${b.year}` : b.author
fn versionsText(n: number): string = n == 0 ? "" : n == 1 ? "1 audiobook" : `${n} audiobooks`
fn statusText(v: Version): string = v.status == "ready" ? `${v.total} ${v.total == 1 ? "chapter" : "chapters"}` : v.status == "failed" ? v.error : v.status == "queued" ? "Waiting to start…" : v.total == 0 ? "Preparing book…" : `Voicing ${v.done} of ${v.total}…`
fn goodreads(b: Book): string = `https://www.goodreads.com/search?q=${encodeURIComponent(b.title + " " + b.author)}`
fn trackTitle(a: Audiobook, i: number): string = match a.tracks.at(i) { case some(t) => t.title, case none => "" }
fn trackSrc(a: Audiobook, i: number): string = match a.tracks.at(i) { case some(t) => t.src, case none => "" }

component App
  state query = ""
  state asked = ""
  state me = "" persist
  state filePath = ""
  state fileName = ""
  state sourceId = ""
  state model = ""
  state voice = ""
  state rights = false
  state refusal = ""
  state track = 0
  // The lander: a hero over the painting, and a stack of books lying across the fold. Scrolling
  // fades the painting out and brings the stack into focus, one book at a time.
  resource greats = loadGreats() as shape Great[] else empty()
  resource viewport = exactViewport() as shape Viewport
  state cur = 0
  state dragX = 0
  state dragY = 0
  state dragging = false
  state moved = false
  state scrollY = 0
  derive n = greats.length
  derive wide = viewport.width >= 820
  derive coverH = round(min(viewport.height * (wide ? 0.46 : 0.4), 440))
  derive coverW = min(round(coverH / 1.55), round(viewport.width * 0.62))
  derive focused = greats.slice(cur, cur + 1)
  derive still = viewport.prefersReducedMotion
  // 0 with the painting in full, 1 once it has scrolled most of the way off.
  derive fade = min(1, max(0, scrollY / max(1, viewport.height * 0.6)))
  derive lit = fade > 0.5
  // The painting covers the screen. On a narrow one it is drawn a little taller and slides
  // so the wanderer stands at the right, under the book's name.
  derive paintH = wide ? max(viewport.height, viewport.width / 1.777) : viewport.height * 1.15
  derive paintW = paintH * 1.777
  derive paintLeft = wide ? (viewport.width - paintW) / 2 : max(viewport.width - paintW, min(0, viewport.width * 0.86 - paintW * 0.83))
  resource listening = loadListening() as shape Book[] else empty()
  resource found = searchBooks(asked) as shape Book[] else empty()
  // Under the field while typing: a few books for what has been typed so far.
  state suggestFor = ""
  state suggestOpen = false
  state leaving = false
  resource suggestions = suggestBooks(suggestFor) as shape Book[] else empty()
  resource models = loadModels() as shape Model[] else empty()
  resource detail = loadBook(bookId) as shape BookDetail else empty()
  resource bookSources = loadBookSources(top(nav).name == "create" ? bookId : "") as shape BookSources else empty(available=false, files=[])
  resource audiobook = loadAudiobook(genId) as shape Audiobook else empty()
  mutation created as shape Reply refreshes detail, listening, account, mine then afterCreate
  // Home: where the listener left off, what they made, and the voice they read in.
  resource places = loadPlaces() as shape Place[] else empty()
  mutation placed as shape Reply refreshes places
  resource mine = loadMine() as shape Mine[] else empty()
  resource voicePref = loadVoicePref() as shape VoicePref else empty(id="", title="", cover="")
  mutation prefSet as shape Reply refreshes voicePref
  state voiceQuery = ""
  state voiceAsked = ""
  resource voiceList = loadVoices(voiceAsked) as shape Voice[] else empty()
  state auditioning = ""
  // The player: paused or not, where it is, how long the chapter is, how fast it reads.
  state held = true
  state now = 0
  state duration = 0
  state rate = 1
  state resumeTime = 0
  derive fishModel = model.startsWith("fish-audio/")
  derive mineWorking = mine.filter(m => m.status == "queued" or m.status == "working").length > 0
  derive playerCover = wide ? min(240, round(viewport.height * 0.28)) : min(220, round(viewport.width * 0.56))
  // The account: the provider's buttons sign in, with a nonce fetched before the press.
  resource account = currentAccount() as shape Account else empty(signedIn=false, name="")
  resource identities = getIdentityCapabilities() as shape IdentityCapabilities
  mutation nonce as shape Reply
  mutation signedIn as shape Reply refreshes account, mine
  mutation left as shape Reply refreshes account, mine
  derive signInError = match signedIn { case some(r) => r.error, case none => "" }
  derive bookId = match stack(nav).filter(e => e.name == "book" or e.name == "create").at(-1) { case some(e) => e.params.id, case none => "" }
  derive genId = match stack(nav).filter(e => e.name == "play").at(-1) { case some(e) => e.params.gen, case none => "" }
  derive working = detail.versions.filter(v => v.status == "queued" or v.status == "working").length > 0
  derive ready = detail.versions.filter(v => v.status == "ready")
  derive voices = match first(models.filter(m => m.id == model)) { case some(m) => m.voices, case none => [] }
  derive createError = match created { case some(r) => r.error, case none => "" }
  derive canCreate = account.signedIn and (filePath != "" or sourceId != "") and model != "" and rights and not pending(created)
  derive createHint = pending(created) ? (sourceId != "" ? "Downloading book and preparing audiobook…" : "Uploading…") : filePath == "" and sourceId == "" ? "Choose a book file or upload your own." : model == "" ? "Choose a voice model." : not rights ? "Confirm you may share it." : ""
  derive showSuggestions = suggestOpen and suggestFor.length >= 2 and suggestFor == query.trim() and suggestFor != asked and suggestions.length > 0
  derive searchError = pending(found) ? "" : match failure(found) { case some(f) => "Search isn’t reachable right now. Try again.", case none => "" }

  // While playing, the place is kept every so often (and at every pause and chapter's end).
  task keeping when top(nav).name == "play" and not held
    every(15000, keepPlace)
  task voiceSearching when voiceQuery.trim() != voiceAsked key=voiceQuery
    after(300, takeVoiceQuery)

  // A drag's end can be followed by a click on the stack; it is spent a moment later either way.
  task settling when moved and not dragging
    after(250, clearMoved)

  // While an audiobook is being made, its page follows the progress.
  task poll mount
    every(3000, pull)

  // Suggestions follow the typing: a short pause asks for a few books (the server keeps each
  // search, so typing back costs nothing). Enter asks for every result.
  task suggesting when query.trim() != suggestFor key=query
    after(200, takeSuggest)
  // Leaving the field closes them, a moment later, so a tap on one still lands.
  task closing when leaving
    after(200, closeSuggest)

  task prepareIdentity mount
    after(1, getNonce)

  action getNonce
    send nonce = identityNonce()
  action googleSignIn
    send signedIn = signInWith("google")
  action signOut
    send left = signOut()
    // A sheet still up is for the session that is ending: its answer is dropped.
    send signedIn = idle()
  action pull
    if working
      refresh detail
    if mineWorking
      refresh mine
  action search(v: string)
    query = v
    suggestOpen = true
    if v.trim() == ""
      asked = ""
  action ask
    asked = query.trim()
    suggestOpen = false
  action takeSuggest
    suggestFor = query.trim()
  action fieldFocus
    leaving = false
    suggestOpen = true
  action fieldBlur
    leaving = true
  action closeSuggest
    leaving = false
    suggestOpen = false
  action back
    if top(nav).name == "play"
      keepPlace()
    nav = back(nav)
  action next
    if n > 0
      cur = (cur + 1) % n
  action prev
    if n > 0
      cur = (cur + n - 1) % n
  // On the lander, ← and → turn the stack.
  action keyed(key: string)
    if top(nav).name == "lander"
      if key == "ArrowRight"
        next()
      else if key == "ArrowLeft"
        prev()
  // A tap throws the top book aside; one that ends a drag does not.
  action tapBook
    if moved
      moved = false
    else
      next()
  action dragBook(dx: number, dy: number)
    dragging = true
    dragX = dx
    dragY = dy
    moved = moved or max(mag(dx), mag(dy)) > 6
  // A throw to the left turns to the next book, to the right back to the last; a short one settles.
  action dropBook(vx: number, vy: number)
    if n > 0 and (dragX < -70 or vx < -600)
      cur = (cur + 1) % n
    else if n > 0 and (dragX > 70 or vx > 600)
      cur = (cur + n - 1) % n
    dragging = false
    dragX = 0
    dragY = 0
  action clearMoved
    moved = false
  action scrolled(x: number, y: number)
    scrollY = y
  action enter
    nav = push(nav, path("home"))
  // A book on the stack opens Explore searching for it.
  action seek(g: Great)
    query = g.title
    asked = `${g.title} ${g.author}`
    suggestOpen = false
    nav = go(nav, path("explore"))
  action follow(url: string)
    nav = go(nav, url)
  action openCreate
    sourceId = ""
    filePath = ""
    fileName = ""
    rights = false
    refusal = ""
    model = match first(models) { case some(m) => (model == "" ? m.id : model), case none => model }
    nav = push(nav, path("create", bookId))
  action chooseFile
    showPicker("upload")
  action pickSource(v: string)
    sourceId = v
    filePath = ""
    fileName = ""
    refusal = ""
  action picked(files: Picked[])
    sourceId = match first(files) { case some(f) => "", case none => sourceId }
    filePath = match first(files) { case some(f) => f.path, case none => filePath }
    fileName = match first(files) { case some(f) => f.name, case none => fileName }
  action pickModel(v: string)
    model = v
    voice = ""
  action editVoice(v: string)
    voice = v
  action editMe(v: string)
    me = v
  action setRights(on: bool)
    rights = on
  action create
    if canCreate
      send created = createAudiobook(bookId, filePath, fileName, sourceId, model, fishModel ? voicePref.id : voice.trim(), fishModel ? voicePref.title : voice.trim(), me.trim(), rights)
  action afterCreate
    refusal = createError
    if createError == "" and top(nav).name == "create"
      nav = back(nav)
  // Listening picks up where this device left off, if it has been here before.
  action listen(id: string)
    track = match first(places.filter(p => p.gen == id)) { case some(p) => p.track, case none => 0 }
    resumeTime = match first(places.filter(p => p.gen == id)) { case some(p) => p.time, case none => 0 }
    now = 0
    duration = 0
    held = false
    nav = push(nav, path("play", id))
  action resume(p: Place)
    listen(p.gen)
  action openMine(m: Mine)
    if m.status == "ready"
      listen(m.gen)
    else
      nav = push(nav, path("book", m.book))
  action playTrack(i: number)
    track = i
    now = 0
    duration = 0
    held = false
  action nextTrack
    let following = track + 1
    if following < audiobook.tracks.length
      // A chapter's end pauses the element first (HTML fires `pause` before `ended`): play on.
      track = following
      now = 0
      duration = 0
      held = false
      keepAt(following, 0, 0)
    else
      held = true
      keepPlace()
  action prevTrack
    if now > 5 or track == 0
      fastSeek("player-audio", 0)
    else
      track = track - 1
      now = 0
      duration = 0
  action keepPlace
    keepAt(track, now, duration)
  action keepAt(tr: number, t: number, d: number)
    if audiobook.id != "" and audiobook.id == genId
      send placed = savePlace(audiobook.id, audiobook.book, audiobook.title, audiobook.author, audiobook.cover, tr, audiobook.tracks.length, t, d)
  action tick(t: number)
    now = t
  action gotDuration(d: number)
    duration = d
  action resumeAt
    if resumeTime > 0
      fastSeek("player-audio", resumeTime)
      resumeTime = 0
  action scrub(v: number)
    now = v
    fastSeek("player-audio", v)
  action toggle
    held = not held
  action played
    held = false
  action stopped
    held = true
    keepPlace()
  action back15
    fastSeek("player-audio", max(0, now - 15))
  action fwd30
    fastSeek("player-audio", min(max(0, duration - 1), now + 30))
  action cycleRate
    rate = nextRate(rate)
  // Voices: browse or search Fish Audio's community library, hear a sample, choose one.
  action editVoiceQuery(v: string)
    voiceQuery = v
  action takeVoiceQuery
    voiceAsked = voiceQuery.trim()
  action audition(src: string)
    auditioning = auditioning == src ? "" : src
  action auditionEnded
    auditioning = ""
  action chooseVoice(v: Voice)
    send prefSet = setVoicePref(v.id, v.title, v.cover)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow key=keyed testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "lander"
          column navigationKey=`${e.id}` position="absolute" inset=0 overflow="hidden" background-color="#121419" testId="lander"
            background-image="radial-gradient(ellipse closest-side at 50% 45%, rgba(120,128,150,0.16) 0%, rgba(120,128,150,0) 100%)"
            // The painting, behind everything, fading out and drifting up as the page scrolls.
            view position="absolute" inset=0 pointer-events="none" opacity=(1 - fade) overflow="hidden"
              image "assets/lander.jpg" alt="" position="absolute" top=0 left=paintLeft width=paintW height=paintH
                translate=`0px ${round(-scrollY * 0.25)}px`
              view position="absolute" inset=0
                background-image=(wide ? "linear-gradient(100deg, rgba(240,240,244,0.55) 0%, rgba(240,240,244,0.18) 38%, rgba(240,240,244,0) 60%)" : "linear-gradient(180deg, rgba(240,240,244,0.5) 0%, rgba(240,240,244,0.15) 45%, rgba(240,240,244,0) 70%)")
              // Fog drifting along the fold, out of which the books rise.
              view position="absolute" left="-15%" right="-15%" bottom=0 height="45%" opacity=0.7
                animation=(still ? "none" : "drift 26s ease-in-out infinite")
                view position="absolute" left="0%" bottom="-35%" width="55%" height="90%"
                  background-image="radial-gradient(ellipse closest-side, rgba(250,250,252,0.9) 0%, rgba(250,250,252,0) 100%)"
                view position="absolute" left="40%" bottom="-45%" width="60%" height="95%"
                  background-image="radial-gradient(ellipse closest-side, rgba(250,250,252,0.85) 0%, rgba(250,250,252,0) 100%)"
            scroll id="lander-scroll" position="absolute" top=0 left=0 width="100%" height="100%" scroll=scrolled
              overflow-x="hidden" overflow-y="auto" scrollbar-width="none"
              // The hero, over the painting: the line, and the stack of books to throw through.
              column height=viewport.height box-sizing="border-box" align-items="center" justify-content="center"
                gap=(wide ? 44 : 32) padding=(wide ? "72px 24px 40px" : "72px 20px 32px")
                text "Give great words a voice" role="heading" aria-level=1 font-family="Jost" font-weight=300 text-align="center"
                  font-size=(wide ? min(76, round(viewport.width * 0.052)) : 40) line-height=1.05 letter-spacing="-0.02em" color="#1b1f2b"
                  opacity=max(0, 1 - fade * 1.5) animation=(still ? "none" : "inkIn 1.1s 0.15s cubic-bezier(.2,.7,.2,1) both") testId="hero-title"
                // Tap the top book to throw it aside, or swipe it away in any direction.
                button press=tapBook aria-label="Next book" testId="stack" appearance="none" position="relative"
                  width=coverW height=coverH flex-shrink=0 touch-action="pan-y" pan=dragBook panrelease=dropBook cursor="grab"
                  animation=(still ? "none" : "arrive 1.4s 0.35s cubic-bezier(.2,.7,.2,1) both")
                  for g, i in greats key=g.id
                    Volume(book=g, depth=depthOf(i, cur, n), n=n, i=i, w=coverW, h=coverH,
                      dx=(depthOf(i, cur, n) == 0 ? dragX : 0), dy=(depthOf(i, cur, n) == 0 ? dragY : 0), dragging=dragging)
                // The focused book's title, lifted off the painting by a soft pale halo, and the one thing to do with it.
                for g in focused key=g.id
                  column align-items="center" gap=14 padding-top=(wide ? 20 : 16) position="relative" opacity=max(0, 1 - fade * 1.5)
                    animation=(still ? "none" : "inkIn 500ms cubic-bezier(.2,.7,.2,1) both")
                    view position="absolute" left="-30%" right="-30%" top="-10%" bottom="-25%" pointer-events="none"
                      background-image="radial-gradient(ellipse closest-side, rgba(242,242,246,0.7) 0%, rgba(242,242,246,0.35) 55%, rgba(242,242,246,0) 100%)"
                    column align-items="center" gap=5 position="relative"
                      text g.title font-family="Jost" font-weight=400 font-size=18 color="#14171f" text-align="center" line-clamp=1 testId="great-title"
                      text g.author.toUpperCase() font-family="Jost" font-weight=500 font-size=11 letter-spacing="0.26em" color="#2c3140" text-align="center" testId="great-author"
                    button press=seek(g) appearance="none" testId="seek" position="relative" padding="4px 0" cursor="pointer"
                      text "Open in Exalt  →" font-family="Jost" font-weight=400 font-size=14 color="#14171f"
                        border-bottom="1px solid rgba(20,23,31,0.35)" padding-bottom=2
              // Below the fold, in the dark: what Exalt is, and signing up.
              column min-height=viewport.height box-sizing="border-box" align-items="center" justify-content="center"
                padding=(wide ? "120px 24px" : "96px 24px") gap=44 position="relative"
                column max-width=640 align-items="center" gap=22 opacity=fade
                  text "Exalt turns any book into audio in a voice you choose."
                    font-family="Jost" font-weight=300 font-size=(wide ? 32 : 24) line-height=1.3 color="#eeebe4" text-align="center" testId="about"
                  text "Generate, listen, and share for free."
                    font-family="Jost" font-weight=400 font-size=(wide ? 17 : 15) line-height=1.6 color="#9a978f" text-align="center" max-width=520
                column width="100%" max-width=300 align-items="stretch" gap=12 opacity=fade
                  if account.signedIn
                    text `Signed in as ${account.name}` font-family="Jost" font-size=15 color="#9a978f" text-align="center" testId="lander-account"
                    link href=path("home") testId="lander-library" padding="13px 26px" border-radius=999 background-color="#eeebe4" display="flex" justify-content="center"
                      text "Open the library" font-family="Jost" font-weight=500 font-size=15 color="#1b1f2b"
                  else
                    if identities.providers.google.active
                      exact-sign-in-button provider="google" press=googleSignIn testId="lander-google" width="100%" height=46
                    if signInError != ""
                      text signInError color="#e8837b" font-family="Jost" font-size=14 text-align="center" testId="lander-sign-in-error"
                    link href=path("home") testId="lander-library" padding="10px 0" display="flex" justify-content="center"
                      text "Or just listen  →" font-family="Jost" font-size=15 color="#eeebe4" border-bottom="1px solid rgba(238,235,228,0.35)" padding-bottom=3
                // The credit, at the foot of the page.
                row align-items="center" justify-content="center" gap=5 position="absolute" left=0 right=0 bottom=(wide ? 32 : 24) opacity=fade testId="credit"
