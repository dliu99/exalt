                      column gap=10 align-items=(wide ? "flex-start" : "center")
                        text detail.book.title role="heading" aria-level=1 font-family="Jost" font-weight=300 font-size=(wide ? 46 : 32) line-height=1.1 letter-spacing="-0.02em" color="#14171f" text-align=(wide ? "start" : "center") testId="book-title"
                        text (detail.book.year > 0 ? `${detail.book.author.toUpperCase()} · ${detail.book.year}` : detail.book.author.toUpperCase()) font-family="Jost" font-weight=500 font-size=12 letter-spacing="0.24em" color="#4a4f5c" text-align=(wide ? "start" : "center")
                      row gap=22 align-items="center" flex-wrap="wrap" justify-content=(wide ? "flex-start" : "center") padding-top=6
                        for v in ready.slice(0, 1) key=v.id
                          button press=listen(v.id) appearance="none" testId="listen" padding="0 26px" height=46 border-radius=999 display="flex" align-items="center" gap=10 background-color="#14171f" cursor="pointer"
                            image "symbol:play-fill" color="#f4f2ec" width=14 height=14
                            text "Listen" font-family="Jost" font-weight=500 font-size=15 color="#f4f2ec"
                        if ready.length == 0
