                            text "Make the audiobook" font-family="Jost" font-weight=500 font-size=15 color="#f4f2ec"
                        else
                          button press=openCreate appearance="none" testId="make" padding="4px 0" cursor="pointer"
                            text "Make another  →" font-family="Jost" font-size=15 color="#14171f" border-bottom="1px solid rgba(20,23,31,0.3)" padding-bottom=2
                        link href=goodreads(detail.book) testId="goodreads"
                          text "Reviews on Goodreads  ↗" font-family="Jost" font-size=15 color="#4a4f5c"
                      if detail.book.description != ""
                        text detail.book.description white-space="pre-line" font-family="Jost" font-size=16 line-height=1.65 color="#2c3140" max-width=600 padding-top=10 testId="book-description"
                  column gap=16
                    SectionTitle(label="Audiobooks")
                    if detail.versions.length == 0
                      text "No one has made an audiobook of this yet." font-family="Jost" font-weight=300 font-size=20 color="#14171f" testId="no-versions"
                    else
                      column
                        for v in detail.versions key=v.id
                          VersionRow(version=v, listen=listen)
            TopBar(active="", wide=wide)
