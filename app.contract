                    button press=signOut appearance="none" testId="sign-out" padding="4px 0" cursor="pointer"
                      text "Sign out" font-family="Jost" font-size=14 color="#4a4f5c" border-bottom="1px solid rgba(20,23,31,0.2)" padding-bottom=2
            header display="flex" align-items="center" padding=(wide ? "22px 7vw" : "14px 20px") position="absolute" top=0 left=0 right=0 z-index=5
              appearance="none" background-color="rgba(236,238,242,0.72)" backdrop-filter="blur(14px)" border-bottom="1px solid rgba(20,23,31,0.06)"
