                    text "Sign in to make an audiobook. Listening needs no account." font-family="Jost" font-weight=300 font-size=20 color="#14171f" line-height=1.35 testId="sign-in-note"
                    if identities.providers.google.active
                      exact-sign-in-button provider="google" press=googleSignIn testId="google-sign-in" width="100%" height=44
                    if signInError != ""
