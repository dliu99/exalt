          column navigationKey=`${e.id}` navigationScroll="player" position="absolute" inset=0 background-color="#121419" testId="player"
            background-image="radial-gradient(ellipse closest-side at 50% 32%, rgba(140,148,170,0.20) 0%, rgba(140,148,170,0) 100%)"
            if audiobook.id != e.params.gen
              column flex=1 justify-content="center" align-items="center"
                progress aria-label="Loading" testId="player-loading"
            else
              scroll id="player" position="absolute" top=0 left=0 width="100%" height="100%" overflow-x="hidden" overflow-y="auto" scrollbar-width="none"
                column margin="0 auto" width="100%" max-width=560 box-sizing="border-box" padding=(wide ? "80px 32px 80px" : "72px 24px 64px") gap=(wide ? 32 : 40)
                  column align-items="center" gap=28
                    view animation=(still ? "none" : "arrive 900ms cubic-bezier(.2,.7,.2,1) both")
                      BookCover(src=audiobook.cover, title=audiobook.title, w=playerCover)
                    column align-items="center" gap=8
                      text audiobook.title role="heading" aria-level=1 font-family="Jost" font-weight=300 font-size=(wide ? 32 : 26) line-height=1.15 color="#eeebe4" text-align="center"
                      text audiobook.author.toUpperCase() font-family="Jost" font-weight=500 font-size=11 letter-spacing="0.26em" color="#9a978f" text-align="center"
                      text trackTitle(audiobook, track) font-family="Jost" font-size=15 color="#c9c6be" text-align="center" line-clamp=1 padding-top=8 testId="now-playing"
                  column gap=6
