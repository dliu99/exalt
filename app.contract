          column navigationKey=`${e.id}` navigationScroll="book-scroll" position="absolute" inset=0 background-color="#eceef2" testId="book"
            scroll id="book-scroll" position="absolute" top=0 left=0 width="100%" height="100%" overflow-x="hidden" overflow-y="auto"
              if detail.book.id != e.params.id
