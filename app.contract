// Exalt: audiobooks of your own books. A signed-in person imports an EPUB, PDF or TXT (a file, or
// a link to one), the server narrates its first chapter and the rest on request, and it joins
// their library, shared in the public Browse feed unless they keep it private. app.ts asks
// server/index.ts for all of it. On the site anyone can listen to what is shared; importing and
// narrating a chapter need an account.
use EmptyState from "exact:content"
use getIdentityCapabilities, IdentityCapabilities from "@exact/sign-in"
use getClientCapabilities, ClientCapabilities from "@exact/passkeys"
use openBrowser, BrowserResult from "@exact/in-app-browser"
use showNotification, notificationStatus, requestNotificationPermission, notificationclick, NotificationStatus, NotificationEvent from "@exact/notifications"

// The lander's face: Jost (SIL Open Font License), cut to static weights.
font "Jost"
  300 = "assets/fonts/Jost-Light.ttf"
  300 italic = "assets/fonts/Jost-LightItalic.ttf"
  400 = "assets/fonts/Jost-Regular.ttf"
  500 = "assets/fonts/Jost-Medium.ttf"

// One stack on Home, the library: the lander and the player push over it, and Add a Book is a sheet.
routes nav
  home "/home"
    lander "/"
    add "/import"
    play "/play/:gen"

shape Model
  id: string
  name: string
  voices: string[]

// One chapter of an audiobook: narrated (`ready`, with its audio), `idle` until someone asks for it,
// `queued` or `working` (narrating, `progress` of the way; its audio plays from the first part
// narrated) once they have, `failed`, or `unavailable` (its text wasn't kept).
shape Chapter
  idx: number
  title: string
  src: string
  status: string
  progress: number
  error: string

// One audiobook to play.
shape Audiobook
  id: string
  title: string
  author: string
  cover: string
  by: string
  voice: string
  public: bool
  // Its preparation: queued or working (splitting the book), ready, or failed (error).
  status: string
  done: number
  total: number
  active: number
  error: string
  chapters: Chapter[]
  // The signed-in listener's chapters waiting or narrating, of how many they may have at once.
  mine: number
  limit: number
  // Whether the signed-in listener made it (and may delete it).
  owner: bool

shape Reply
  ok: bool
  error: string

shape Account
  signedIn: bool
  name: string

// Where the listener left off in an audiobook (on this device, and the account's).
shape Place
  gen: string
  title: string
  author: string
  cover: string
  track: number
  tracks: number
  time: number
  duration: number
  at: number

// An audiobook in the signed-in person's library, finished or not.
shape Mine
  id: string
  title: string
  author: string
  cover: string
  status: string
  done: number
  total: number
  active: number
  error: string
  public: bool
  voice: string

// A narrated chapter kept on this device, to play without a connection (under app:/cache/offline).
shape Offline
  gen: string
  idx: number
  path: string

// A chapter this listener asked to have narrated that can be heard now (`ready`: its first part is
// narrated, so it plays while the rest is), or couldn't be narrated (`status`).
// `key` is how it was asked for: "gen/idx".
shape Ready
  key: string
  gen: string
  idx: number
  title: string
  book: string
  status: string

// Whether Exalt is on screen: a chapter that's ready while it isn't gets the system's notification.
shape Page
  visibilityState: string

// What a file or a link is, read before anything is made: Add a Book's second step.
// An import's answer: the new audiobook, whose chapters open next.
shape Imported
  ok: bool
  error: string
  gen: string

shape ImportPreview
  ok: bool
  error: string
  title: string
  author: string
  cover: string
  chapters: string[]
  // About how many words the book holds, for its reading time and pages.
  words: number
  // What the server kept of a file it read (a link's download), so Generate needn't fetch it again; "" when the phone read it.
  token: string

// An audiobook someone shared, in Browse.
shape Shared
  id: string
  title: string
  author: string
  cover: string
  by: string
  voice: string

// A voice from Fish Audio's library (read through OpenRouter's Fish models), and the listener's choice.
shape Voice
  id: string
  title: string
  description: string
  cover: string
  sample: string
  languages: string
  uses: number

shape VoicePref
  id: string
  title: string
  cover: string

// One of the lander's great books: its Penguin cover ships in assets/covers.
shape Great
  id: string
  title: string
  author: string
  cover: string

shape Time
  epochAtZero: number
  utcOffset: number

shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool

// The lander's stack. A book's depth is how far below the top it lies (0 is the one in focus);
// the last depth is the book just turned away, thrown off to the left, so going back brings it
// down onto the top again. The rest settle under the top at a slant of their own.
fn depthOf(i: number, cur: number, n: number): number = (i - cur + n) % n
fn gone(d: number, n: number): bool = d == n - 1 and n > 1
fn slant(i: number): number = ((i * 47) % 13 - 6) * 0.85
fn volX(d: number, n: number, i: number, w: number): number = gone(d, n) ? -w * 2.1 : d == 0 ? 0 : ((i * 29) % 9 - 4) * 4
fn volY(d: number, n: number, h: number): number = gone(d, n) ? -h * 0.12 : min(d, 5) * 8
fn volRot(d: number, n: number, i: number): number = gone(d, n) ? -26 : d == 0 ? slant(i) * 0.2 : slant(i)
fn volOpacity(d: number, n: number): number = gone(d, n) ? 0 : d > 5 ? 0 : 1
fn volZ(d: number, n: number): number = gone(d, n) ? n + 1 : n - d
fn mag(x: number): number = max(x, -x)

fn two(n: number): string = n < 10 ? `0${n}` : `${n}`
fn clock(s: number): string = s >= 3600 ? `${floor(s / 3600)}:${two(floor(s / 60) % 60)}:${two(floor(s) % 60)}` : `${floor(max(0, s) / 60)}:${two(floor(max(0, s)) % 60)}`
fn nextRate(r: number): number = r == 1 ? 1.25 : r == 1.25 ? 1.5 : r == 1.5 ? 2 : r == 2 ? 0.75 : 1
fn rateText(r: number): string = r == 1 ? "1×" : r == 1.25 ? "1.25×" : r == 1.5 ? "1.5×" : r == 2 ? "2×" : "0.75×"
fn trackTitle(a: Audiobook, i: number): string = match a.chapters.at(i) { case some(t) => t.title, case none => "" }
fn trackSrc(a: Audiobook, i: number): string = match a.chapters.at(i) { case some(t) => t.src, case none => "" }
fn trackStatus(a: Audiobook, i: number): string = match a.chapters.at(i) { case some(t) => t.status, case none => "" }
fn inFlight(status: string): bool = status == "queued" or status == "working"
// What a chapter that isn't narrated says on its row.
fn chapterNote(c: Chapter): string = c.status == "queued" ? "Waiting…" : c.status == "working" ? `Narrating… ${round(c.progress * 100)}%` : c.status == "unavailable" ? "Unavailable" : c.status == "failed" ? "Didn’t finish" : ""
// A chapter asked for is kept as "gen/idx".
fn keyGen(k: string): string = match k.split("/").at(0) { case some(g) => g, case none => "" }
fn keyIdx(k: string): number = match k.split("/").at(1) { case some(s) => (match parseNumber(s) { case some(n) => n, case none => 0 }), case none => 0 }
// Where a chapter's download is on this device, or "".
fn keptAt(kept: Offline[], gen: string, idx: number): string = match kept.filter(o => o.gen == gen and o.idx == idx).at(0) { case some(o) => o.path, case none => "" }
// The sleep timer: 0 is off, -1 the end of the chapter, else minutes (counted down in seconds while playing).
fn sleepText(mins: number, left: number): string = mins == -1 ? "Pausing at the end of this chapter" : `Pausing in ${clock(left)}`
// A download: what it says, and the line under it.
fn savedTitle(kept: number, narrated: number, saving: bool): string = saving ? `Downloading · ${kept} of ${narrated}` : kept > 0 and kept >= narrated ? "Downloaded" : kept > 0 ? `${kept} of ${narrated} chapters downloaded` : "Listen offline"
fn savedNote(kept: number, narrated: number): string = kept > 0 and kept >= narrated ? `${chaptersText(kept)} on this device, to play without a connection` : kept > 0 ? "Download the rest to hear them offline too" : `Save ${narrated == 1 ? "the narrated chapter" : `the ${narrated} narrated chapters`} to this device`
// A library row's one quiet line: how the narration goes, or where the listener is.
fn chaptersText(n: number): string = `${n} ${n == 1 ? "chapter" : "chapters"}`
fn narratedText(done: number, total: number): string = done >= total ? chaptersText(total) : `${done} of ${total} chapters narrated`
fn spanText(s: number): string = s >= 3600 ? `${floor(s / 3600)}h ${round((s % 3600) / 60)}m` : `${max(1, round(s / 60))}m`
// What is left, the chapters still to come taken to run as long as this one.
fn leftOf(p: Place): number = max(0, p.duration - p.time) + (p.tracks - p.track - 1) * p.duration
fn placeText(p: Place): string = p.duration > 0 ? `Chapter ${p.track + 1} of ${p.tracks} · ${spanText(leftOf(p))} left` : `Chapter ${p.track + 1} of ${p.tracks}`
fn workText(m: Mine): string = m.status == "queued" ? "Waiting…" : m.status == "failed" ? (m.error == "" ? "Didn’t finish" : `Didn’t finish: ${m.error}`) : "Preparing…"
fn statusOf(m: Mine, ps: Place[]): string = m.status != "ready" ? workText(m) : m.active > 0 ? `Narrating… · ${narratedText(m.done, m.total)}` : match first(ps.filter(p => p.gen == m.id)) { case some(p) => placeText(p), case none => `Ready · ${narratedText(m.done, m.total)}` }
fn readBy(voice: string, by: string): string = voice == "" ? by : `Read by ${voice} · ${by}`

component App
  // The lander: a hero over the painting, and a stack of books lying across the fold. Scrolling
  // fades the painting out and brings the stack into focus, one book at a time.
  resource greats = loadGreats() as shape Great[] else empty()
  resource viewport = exactViewport() as shape Viewport
  state cur = 0
  state dragX = 0
  state dragY = 0
  state dragging = false
  state moved = false
  state scrollY = 0
  // A drag far enough to turn the book is felt as it crosses the line.
  state armed = false
  derive n = greats.length
  derive wide = viewport.width >= 820
  // Whatever is loaded plays on in the mini player, over Home; it shares a glass bar with the +.
  derive miniOn = here and not playerOpen and top(nav).name == "home"
  // Room under the shelf for the bar at the foot.
  derive dockRoom = 112
  derive coverH = round(min(viewport.height * (wide ? (gated ? 0.42 : 0.46) : gated ? 0.45 : 0.4), 440))
  derive coverW = min(round(coverH / 1.55), round(viewport.width * 0.66))
  derive focused = greats.slice(cur, cur + 1)
  derive still = viewport.prefersReducedMotion
  // 0 with the painting in full, 1 once it has scrolled most of the way off.
  derive fade = min(1, max(0, scrollY / max(1, viewport.height * 0.6)))
  derive lit = fade > 0.5
  // The painting covers the screen. On a narrow one it is drawn a little taller and slides
  // so the wanderer stands at the right, under the book's name.
  derive paintH = wide ? max(viewport.height, viewport.width / 1.777) : viewport.height * 1.15
  derive paintW = paintH * 1.777
  derive paintLeft = wide ? (viewport.width - paintW) / 2 : max(viewport.width - paintW, min(0, viewport.width * 0.86 - paintW * 0.83))
  // The app opens on signing in; the site lets anyone through to listen.
  resource app = isApp() as shape Reply else empty(ok=false, error="")
  // The door: where the server keeps accounts, nothing opens without signing in, on the site as in the app.
  resource door = accountRequired() as shape Reply else empty(ok=true, error="")
  derive gated = door.ok and not account.signedIn and identities.providers.google.active
  // On a phone the door is a plain screen of its own: no painting, no wordmark.
  derive phoneDoor = gated and not wide
  // The account: the provider's buttons sign in, with a nonce fetched before the press.
  resource account = currentAccount() as shape Account else empty(signedIn=false, name="")
  resource identities = getIdentityCapabilities() as shape IdentityCapabilities
  mutation nonce as shape Reply
  mutation signedIn as shape Reply refreshes account, library, places, audiobook
  mutation left as shape Reply refreshes account, library, places, audiobook
  derive signInError = match signedIn { case some(r) => r.error, case none => "" }

  // Library: the person's audiobooks, newest first, and where they are in each.
  resource library = loadLibrary() as shape Mine[] else empty()
  resource places = loadPlaces() as shape Place[] else empty()
  resource time = exactTime() as shape Time
  mutation placed as shape Reply refreshes places
  // A row's long-press menu and alerts act on the row they came from.
  state aimed = ""
  state renameTitle = ""
  state changeMessage = ""
  mutation shared as shape Reply refreshes library, audiobook then afterShared
  mutation renamed as shape Reply refreshes library, places, audiobook then afterRenamed
  mutation removed as shape Reply refreshes library, places then afterRemoved
  derive aimedPublic = library.filter(m => m.id == aimed and m.public).length > 0
  derive aimedTitle = match first(library.filter(m => m.id == aimed)) { case some(m) => m.title, case none => "" }
  derive working = library.filter(m => m.status == "queued" or m.status == "working" or m.active > 0).length > 0

  // Import: a file or a link to one, its title and author if the file's are wrong, a voice, and whether to share it.
  resource models = loadModels() as shape Model[] else empty()
  resource voicePref = loadVoicePref() as shape VoicePref else empty(id="", title="", cover="")
  state filePath = ""
  state fileName = ""
  // A pasted link to a book file, which the server downloads (server/link.ts).
  state link = ""
  // Add a Book: a link is taken at Add, in its own sheet; then the book it is is read.
  state linkTaken = ""
  state importTitle = ""
  state importAuthor = ""
  state model = ""
  state voice = ""
  // Shared audiobooks have no screen here (no Browse): an import stays private.
  state share = false
  state rights = false
  state refusal = ""
  mutation imported as shape Imported refreshes library then afterImport
  // The model in effect: the one chosen, or the first until one is.
  derive chosenModel = model != "" ? model : match first(models) { case some(m) => m.id, case none => "" }
  derive fishModel = chosenModel.startsWith("fish-audio/")
  derive voices = match first(models.filter(m => m.id == chosenModel)) { case some(m) => m.voices, case none => [] }
  derive importError = match imported { case some(r) => r.error, case none => "" }
  // Why Narrate waits, the first thing missing; nothing once it can go.
  derive linkOk = link.trim() == "" or link.trim().startsWith("https://")
  derive importHint = pending(imported) ? (link.trim() != "" ? "Downloading the book…" : "Uploading…") : not account.signedIn ? "Sign in to narrate." : fileName == "" and link.trim() == "" ? "Choose an EPUB, PDF or TXT file, or paste a link to one." : not linkOk ? "Paste a link that starts with https://." : chosenModel == "" ? "Choose a voice." : share and not rights ? "Confirm you have the right to share this book, or keep it private." : ""
  derive canImport = importHint == ""
  // The composer's chips: the model's name and the voice's.
  derive modelName = match first(models.filter(m => m.id == chosenModel)) { case some(m) => match m.name.split(" (").at(0) { case some(n) => n.replaceAll("Fish Audio ", ""), case none => m.name }, case none => "Model" }
  derive voiceName = fishModel ? (voicePref.id == "" ? "Default" : voicePref.title) : (voice == "" ? "Default" : voice)
  derive adding = filePath != "" or linkTaken != ""
  // About how long the book takes to hear, at a narrator's 155 words a minute.
  derive listenMins = max(1, round(preview.words / 155))
  derive listenText = listenMins >= 60 ? `${floor(listenMins / 60)} h ${listenMins % 60} min` : `${listenMins} min`
  // What the wait is: a link is fetched by the server; a file is read on the phone (a PDF by the server).
  derive linkHost = match linkTaken.split("/").at(2) { case some(h) => h, case none => "" }
  derive readingText = linkTaken != "" ? `Downloading from ${linkHost}…` : fileName.toLowerCase().endsWith(".pdf") ? "Reading the PDF…" : "Reading the book…"
  resource preview = previewImport(adding ? filePath : "", adding ? fileName : "", adding ? linkTaken : "") as shape ImportPreview else empty(ok=false, error="", title="", author="", cover="", chapters=[], token="", words=0)
  // Z-Library and LibGen open over the app (Safari's view on iOS), and Done comes back.
  mutation browser as shape BrowserResult

  // Voices.
  mutation prefSet as shape Reply refreshes voicePref
  state voiceQuery = ""
  state voiceAsked = ""
  state voiceOn = false
  resource voiceList = loadVoices(voiceAsked) as shape Voice[] else empty()
  state auditioning = ""
  derive voiceBusy = voiceQuery.trim() != voiceAsked or pending(voiceList)

  // What plays: one audiobook at a time, held at App level so it keeps playing while the listener
  // browses. The player shows it; a copy downloaded with it answers when the server can't.
  state loaded = ""
  resource audiobook = loadAudiobook(loaded) as shape Audiobook else empty()
  // The player: paused or not, where it is, how long the chapter is, how fast it reads.
  state track = 0
  state held = true
  state now = 0
  state duration = 0
  state rate = 1
  state resumeTime = 0
  // The source last given the element, and for which chapter ("gen/idx"): the same chapter from
  // another source (its download arriving, or removed) carries on where it was.
  state heardSrc = ""
  state heardKey = ""
  // The sleep timer: 0 off, minutes, or -1 for the end of the chapter; the seconds left, counted while playing.
  state sleepMins = 0
  state sleepLeft = 0
  derive genId = match stack(nav).filter(e => e.name == "play").at(-1) { case some(e) => e.params.gen, case none => "" }
  derive playerOpen = top(nav).name == "play"
  derive playerCover = wide ? min(240, round(viewport.height * 0.28)) : min(220, round(viewport.width * 0.56))
  // The loaded audiobook's record has arrived; until it has, nothing plays (the last one's chapters aren't its).
  derive here = loaded != "" and audiobook.id == loaded
  derive keptSrc = here ? keptAt(offline, loaded, track) : ""
  derive playSrc = not here ? "" : keptSrc != "" ? keptSrc : trackSrc(audiobook, track)
  // Being prepared, or with chapters waiting or narrating.
  derive narrating = inFlight(audiobook.status) or audiobook.chapters.filter(c => inFlight(c.status)).length > 0

  // A chapter narrated on request: anyone signed in may ask on a shared audiobook, its owner on a
  // private one, a few at a time. Signed out, the press asks for an account first and carries on.
  mutation generated as shape Reply refreshes audiobook, library then afterGenerate
  state genRefusal = ""
  state pendingAuth = ""
  state pendingChapter = 0
  derive atLimit = account.signedIn and audiobook.limit > 0 and audiobook.mine >= audiobook.limit
  derive genPending = pending(generated)
  // Chapters this listener asked for ("gen/idx"), until they're narrated, and the notice when one is.
  state wanted: string[] = [] persist
  state askedKey = ""
  resource readyNow = chaptersReady(wanted.join(",")) as shape Ready[] else empty()
  state notice = ""
  state noticeBook = ""
  state noticeKey = ""
  resource page = exactPage() as shape Page
  resource noteStatus = notificationStatus() as shape NotificationStatus
  mutation notePerm as shape NotificationStatus
  // A ready chapter not yet announced.
  derive fresh = readyNow.filter(r => wanted.filter(w => w == r.key).length > 0)
  derive freshKey = match first(fresh) { case some(r) => r.key, case none => "" }
  derive away = page.visibilityState != "visible"

  // Downloads: the chapters kept on this device, and the audiobook being saved.
  resource offline = loadOffline() as shape Offline[] else empty()
  mutation savedAll as shape Reply refreshes offline then afterSave
  mutation unsaved as shape Reply refreshes offline then afterUnsave
  state saving = ""
  state saveError = ""
  // What a download takes: the chapters narrated in full (one still narrating plays as a live stream, not a file).
  derive narratedHere = audiobook.chapters.filter(c => c.status == "ready" and c.src != "").length
  derive keptHere = audiobook.chapters.filter(c => c.status == "ready" and c.src != "" and keptAt(offline, audiobook.id, c.idx) != "").length
  derive anyKept = offline.filter(o => o.gen == audiobook.id).length > 0
  derive savingHere = pending(savedAll) and saving == audiobook.id

  // While playing, wherever the listener is, the place is kept every so often (and at every pause and chapter's end).
  task keeping when loaded != "" and not held
    every(15000, keepPlace)
  // The player opened at its address (a reload, a link) loads that audiobook.
  task adopting when playerOpen and genId != loaded
    after(1, adopt)
  task resourcing when playSrc != heardSrc
    after(1, heardIt)
  // The sleep timer counts while playing; a pause holds it. Stopped at a chapter that isn't narrated
  // there's nothing to pause, so it runs out.
  task sleeping when sleepLeft > 0 and (not held or playSrc == "")
    every(1000, sleepTick)
  // A download shows each chapter as it lands.
  task watchingSave when pending(savedAll)
    every(1000, refreshOffline)
  task announcing when freshKey != "" key=freshKey
    after(1, announce)
  task noticing when notice != "" key=noticeKey
    after(8000, clearNotice)
  // Signed in from the sheet: what was asked for goes ahead.
  task carryingOn when account.signedIn and pendingAuth != ""
    after(1, carryOn)
  task voiceSearching when voiceQuery.trim() != voiceAsked key=voiceQuery
    after(300, takeVoiceQuery)

  // A drag's end can be followed by a click on the stack; it is spent a moment later either way.
  task settling when moved and not dragging
    after(250, clearMoved)

  // While a book is being narrated, the library follows the progress.
  task poll mount
    every(3000, pull)

  task prepareIdentity mount
    after(1, getNonce)
  // In the app, signing in opens the library, and signing out comes back to the door.
  task entering when app.ok and account.signedIn and top(nav).name == "lander"
    after(1, enter)
  // The site bars only what needs an account; anyone can listen to what is shared.
  task barring when gated and top(nav).name != "lander" and (app.ok or top(nav).name == "home" or top(nav).name == "add")
    after(1, toDoor)

  action getNonce
    send nonce = identityNonce()
  action googleSignIn
    send signedIn = signInWith("google")
  action appleSignIn
    send signedIn = signInWith("apple")
  action signOut
    send left = signOut()
    // A sheet still up is for the session that is ending: its answer is dropped.
    send signedIn = idle()
  // A session the server dropped shows as signed out (app.ts forgets it), so the account follows.
  action pull
    if account.signedIn
      refresh account
    if working
      refresh library
    // What's loaded is watched while its chapters narrate, and while the player waits at one that isn't narrated (someone may narrate it).
    if loaded != "" and (narrating or (playerOpen and trackSrc(audiobook, track) == ""))
      refresh audiobook
    // So are the chapters this listener asked for, wherever they are.
    if wanted.length > 0
      refresh readyNow
  action retryLibrary
    refresh library
    refresh account
  action back
    if top(nav).name == "play"
      keepPlace()
    nav = back(nav)
  action next
    if n > 0
      cur = (cur + 1) % n
      haptic("selection")
  action prev
    if n > 0
      cur = (cur + n - 1) % n
  // On the lander, ← and → turn the stack.
  action keyed(key: string)
    if top(nav).name == "lander"
      if key == "ArrowRight"
        next()
      else if key == "ArrowLeft"
        prev()
  // A tap throws the top book aside; one that ends a drag does not.
  action tapBook
    if moved
      moved = false
    else
      next()
  action dragBook(dx: number, dy: number)
    dragging = true
    dragX = dx
    dragY = dy
    moved = moved or max(mag(dx), mag(dy)) > 6
    let over = mag(dx) > 70
    if over and not armed
      haptic("impact-light")
    armed = over
  // A throw to the left turns to the next book, to the right back to the last; a short one settles.
  action dropBook(vx: number, vy: number)
    if n > 0 and (dragX < -70 or vx < -600)
      cur = (cur + 1) % n
    else if n > 0 and (dragX > 70 or vx > 600)
      cur = (cur + n - 1) % n
    dragging = false
    armed = false
    dragX = 0
    dragY = 0
  action clearMoved
    moved = false
  action scrolled(x: number, y: number)
    scrollY = y
  action enter
    // The app's sign-in sheet, if it is still up.
    if app.ok
      close("door-sheet")
    if top(nav).name == "lander"
      nav = push(nav, path("home"))
  action toDoor
    nav = go(nav, path("lander"))
  // A book on the stack opens the app.
  action seek(g: Great)
    nav = go(nav, path("home"))
  action follow(url: string)
    nav = go(nav, url)

  // Import. A draft is kept until it is narrated, so a trip to Voices doesn't lose it.
  // Home's +: Add a Book. Signed out, the sheet to log in opens first, and Add follows it.
  action openImport
    refusal = ""
    if account.signedIn
      resetAdd()
      nav = push(nav, path("add"))
    else
      pendingAuth = "import"
      haptic("selection")
      showModal("account-sheet")
  action resetAdd
    filePath = ""
    fileName = ""
    link = ""
    linkTaken = ""
    importTitle = ""
    importAuthor = ""
    refusal = ""
  action takeLink
    if link.trim().startsWith("https://")
      linkTaken = link.trim()
      refusal = ""
      close("link-sheet")
      haptic("selection")
    else
      refusal = "Paste a link that starts with https://."
  action openLibrary(url: string)
    haptic("selection")
    send browser = openBrowser(url=url)
  // The voice, picked as the model is: the recommended voices, and the one chosen before.
  action pickVoice(id: string)
    haptic("selection")
    match first(voiceList.filter(v => v.id == id))
      case some(v)
        send prefSet = setVoicePref(v.id, v.title, v.cover)
      case none
        send prefSet = setVoicePref("", "", "")
  action chooseFile
    showPicker("upload")
  // A file and a link are two ways to the book: one sets the other aside.
  action picked(files: Picked[])
    filePath = match first(files) { case some(f) => f.path, case none => filePath }
    fileName = match first(files) { case some(f) => f.name, case none => fileName }
    link = match first(files) { case some(f) => "", case none => link }
    refusal = ""
  action editLink(v: string)
    link = v
    refusal = ""
    if v.trim() != ""
      filePath = ""
      fileName = ""
  action editTitle(v: string)
    importTitle = v
  action editAuthor(v: string)
    importAuthor = v
  action pickModel(v: string)
    model = v
    voice = ""
  action editVoice(v: string)
    voice = v
  action setShare(on: bool)
    share = on
  action setRights(on: bool)
    rights = on
  action narrate
    if canImport
      send imported = importBook(filePath, fileName, link.trim(), chosenModel, fishModel ? voicePref.id : voice, fishModel ? voicePref.title : voice, importTitle.trim(), importAuthor.trim(), share, share and rights, preview.token)
  action afterImport
    refusal = importError
    haptic(importError == "" ? "success" : "error")
    if importError == ""
      filePath = ""
      fileName = ""
      link = ""
      importTitle = ""
      importAuthor = ""
      linkTaken = ""
      rights = false
      // The new audiobook opens at once: its chapters, narrating.
      let made = match imported { case some(r) => r.gen, case none => "" }
      if made != ""
        loadVersion(made, true)
      if top(nav).name == "add"
        nav = made != "" ? push(back(nav), path("play", made)) : back(nav)

  // Library rows: tap a finished one to listen, long-press for its menu, swipe to delete.
  action openMine(m: Mine)
    if m.status != "failed"
      listen(m.id)
  action aim(id: string)
    aimed = id
  action askRemove(id: string)
    aimed = id
    showModal("remove-alert")
  action remove
    send removed = deleteAudiobook(aimed)
  // Sharing asks the person to confirm the right to share; keeping private asks nothing.
  action toggleShare
    if aimedPublic
      send shared = setSharing(aimed, false, false)
    else
      showModal("share-alert")
  action shareAimed
    send shared = setSharing(aimed, true, true)
  action askRename
    renameTitle = aimedTitle
    showModal("rename-alert")
  action editRenameTitle(v: string)
    renameTitle = v
  action rename
    if renameTitle.trim() != ""
      send renamed = renameAudiobook(aimed, renameTitle.trim())
  action afterShared
    refused(match shared { case some(r) => r.error, case none => "" })
  action afterRenamed
    refused(match renamed { case some(r) => r.error, case none => "" })
  // A deleted audiobook stops playing if it was, and its download goes with it.
  action afterRemoved
    let said = match removed { case some(r) => r.error, case none => "" }
    refused(said)
    if said == ""
      send unsaved = removeDownload(aimed)
      if aimed == loaded
        held = true
        loaded = ""
        if playerOpen
          nav = back(nav)
  // A change the server refused says why, in an alert.
  action refused(message: string)
    if message != ""
      changeMessage = message
      haptic("error")
      showModal("change-alert")


  // Loading an audiobook picks up where the listener left off, if they've been here before; the one
  // playing keeps its place first.
  action loadVersion(id: string, play: bool)
    keepPlace()
    loaded = id
    track = match first(places.filter(p => p.gen == id)) { case some(p) => p.track, case none => 0 }
    resumeTime = match first(places.filter(p => p.gen == id)) { case some(p) => p.time, case none => 0 }
    now = 0
    duration = 0
    held = not play
    genRefusal = ""
    saveError = ""
  // Listening opens the player; the audiobook already loaded carries on where it is.
  action listen(id: string)
    if id != loaded
      loadVersion(id, true)
    else if playSrc != ""
      held = false
    nav = push(nav, path("play", id))
  // Opened at its address, the player loads its audiobook, paused until a press.
  action adopt
    if genId != loaded
      loadVersion(genId, false)
  action openPlayer
    nav = push(nav, path("play", loaded))
  action resume(p: Place)
    listen(p.gen)
  // A chapter played from its notice: its audiobook loaded if it isn't, the player opened at it.
  action playChapter(gen: string, idx: number)
    notice = ""
    if gen != loaded
      keepPlace()
      loaded = gen
      genRefusal = ""
      saveError = ""
    else
      refresh audiobook
    track = idx
    now = 0
    duration = 0
    resumeTime = 0
    held = false
    if playerOpen and genId != gen
      nav = go(nav, path("play", gen))
    else if not playerOpen
      nav = push(nav, path("play", gen))
  // A narrated chapter in the list plays from its start; the one playing carries on.
  action playTrack(i: number)
    haptic("selection")
    if i != track
      track = i
      now = 0
      duration = 0
      resumeTime = 0
      keepAt(i, 0, 0)
    held = trackSrc(audiobook, i) == ""
  // At a chapter's end the next one plays; one that isn't narrated yet stops the player there, and offers Generate.
  action nextTrack
    advance(false)
  // A chapter's end: the sleep timer set for it pauses there, at the start of the next.
  action chapterEnded
    if sleepMins == -1
      sleepMins = 0
      advance(true)
    else
      advance(false)
  action advance(stop: bool)
    let following = track + 1
    if following < audiobook.chapters.length
      // A chapter's end pauses the element first (HTML fires `pause` before `ended`): play on.
      track = following
      now = 0
      duration = 0
      resumeTime = 0
      held = stop or trackSrc(audiobook, following) == ""
      keepAt(following, 0, 0)
    else
      held = true
      keepPlace()
  action prevTrack
    if now > 5 or track == 0
      fastSeek("player-audio", 0)
    else
      track = track - 1
      now = 0
      duration = 0
      resumeTime = 0
  action keepPlace
    keepAt(track, now, duration)
  action keepAt(tr: number, t: number, d: number)
    if here
      send placed = savePlace(audiobook.id, audiobook.title, audiobook.author, audiobook.cover, tr, audiobook.chapters.length, t, d, time.epochAtZero + performanceNow())
  // The element's source changed: for the same chapter (a download landing, or removed), it resumes where it was.
  action heardIt
    let key = `${loaded}/${track}`
    if heardSrc != "" and playSrc != "" and heardKey == key and now > 0
      resumeTime = now
    heardSrc = playSrc
    heardKey = key
  action tick(t: number)
    now = t
  action gotDuration(d: number)
    duration = d
  action resumeAt
    if resumeTime > 0
      fastSeek("player-audio", resumeTime)
      resumeTime = 0
  action scrub(v: number)
    now = v
    fastSeek("player-audio", v)
  action toggle
    held = not held
  action played
    held = false
  action stopped
    held = true
    keepPlace()
  // A skip moves the clock at once; the element follows.
  action back15
    let to = max(0, now - 15)
    now = to
    fastSeek("player-audio", to)
  action fwd30
    let to = duration > 0 ? min(max(0, duration - 1), now + 30) : now + 30
    now = to
    fastSeek("player-audio", to)
  action cycleRate
    rate = nextRate(rate)
    haptic("selection")
  // Narrate a chapter: signed out, the player asks for an account first.
  action generate(i: number)
    genRefusal = ""
    if not account.signedIn
      pendingChapter = i
      pendingAuth = "chapter"
      haptic("selection")
      showModal("account-sheet")
    else if not genPending
      haptic("impact-light")
      askedKey = `${audiobook.id}/${i}`
      askToNotify()
      send generated = generateChapter(audiobook.id, i)
  // Signed in from the sheet: the chapter asked for is narrated.
  action carryOn
    let what = pendingAuth
    pendingAuth = ""
    close("account-sheet")
    if what == "import"
      openImport()
    else if what == "chapter" and here
      askedKey = `${audiobook.id}/${pendingChapter}`
      send generated = generateChapter(audiobook.id, pendingChapter)
  // Dismissed without signing in: nothing carries on later.
  action sheetClosed
    if not account.signedIn
      pendingAuth = ""
  // A chapter asked for is watched until it's narrated, to say so.
  action afterGenerate
    let said = match generated { case some(r) => r.error, case none => "" }
    genRefusal = said
    haptic(said == "" ? "success" : "error")
    if said == "" and askedKey != ""
      wanted = wanted.filter(w => w != askedKey).concat([askedKey])
  // The first chapter asked for asks, at the press, whether Exalt may say when one is ready.
  action askToNotify
    if noteStatus.available and noteStatus.state == "prompt" and not pending(notePerm)
      send notePerm = requestNotificationPermission()
  // A chapter this listener asked for is ready: a notice here, and the system's while Exalt is in the background.
  action announce
    match first(fresh)
      case some(r)
        wanted = wanted.filter(w => w != r.key)
        // The audiobook playing learns of its new chapter at once, wherever the listener is.
        if r.gen == loaded
          refresh audiobook
        if r.status == "ready"
          if away and noteStatus.state == "granted"
            showNotification(title=`${r.title} is ready`, body=`${r.book} · tap to play it`, tag=r.key, data=r.key)
          if not (playerOpen and r.gen == loaded and r.idx == track)
            notice = r.title
            noticeBook = r.book
            noticeKey = r.key
      case none
        notice = notice
  action noticePlay
    haptic("impact-medium")
    playChapter(keyGen(noticeKey), keyIdx(noticeKey))
  action clearNotice
    notice = ""
  // The system's notification, pressed: its chapter plays.
  action noticeOpened(tag: string, e: NotificationEvent)
    playChapter(keyGen(tag), keyIdx(tag))
  // The sleep timer, from the player's menu.
  action setSleep(m: number)
    haptic("selection")
    sleepMins = m
    sleepLeft = m > 0 ? m * 60 : 0
  action sleepTick
    if sleepLeft <= 1
      sleepLeft = 0
      sleepMins = 0
      held = true
      keepPlace()
    else
      sleepLeft = sleepLeft - 1
  // Downloads: an audiobook's narrated chapters to this device, one after another, and removed again.
  action download
    haptic("impact-light")
    saving = audiobook.id
    saveError = ""
    send savedAll = downloadVersion(audiobook.id)
  action afterSave
    let failed = match savedAll { case some(r) => r.error, case none => "" }
    saveError = failed
    saving = ""
    haptic(failed == "" ? "success" : "error")
  action unsave
    haptic("selection")
    saveError = ""
    send unsaved = removeDownload(audiobook.id)
  action afterUnsave
    saveError = match unsaved { case some(r) => r.error, case none => "" }
  action refreshOffline
    refresh offline
  // Voices: browse or search Fish Audio's community library, hear a sample, choose one.
  action editVoiceQuery(v: string)
    voiceQuery = v
  action takeVoiceQuery
    voiceAsked = voiceQuery.trim()
  action clearVoiceQuery
    voiceQuery = ""
    voiceAsked = ""
  action voiceFocus
    voiceOn = true
  action voiceBlur
    voiceOn = false
  action audition(src: string)
    auditioning = auditioning == src ? "" : src
  action auditionEnded
    auditioning = ""
  action chooseVoice(v: Voice)
    haptic("success")
    send prefSet = setVoicePref(v.id, v.title, v.cover)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow key=keyed notificationclick=noticeOpened testId="app" width="100%" height="100%" viewport-fit="cover" color-scheme="light" accent-color="light-dark(#14171f, #14171f)"
      for e in stack(nav) key=e.id
        if e.name == "lander"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 overflow="hidden" background-color=(phoneDoor ? "light-dark(#eceef2, #eceef2)" : "light-dark(#121419, #121419)") testId="lander"
            status-bar-style=(lit ? "light-content" : "dark-content") status-bar-animation="fade"
            background-image="radial-gradient(ellipse closest-side at 50% 45%, rgba(120,128,150,0.16) 0%, rgba(120,128,150,0) 100%)"
            // The painting, behind everything, fading out and drifting up as the page scrolls.
            view position="absolute" inset=0 pointer-events="none" opacity=(1 - fade) overflow="hidden" display=(phoneDoor ? "none" : "flex")
              image "assets/lander.jpg" alt="" position="absolute" top=0 left=paintLeft width=paintW height=paintH
                translate=`0px ${round(-scrollY * 0.25)}px`
              view position="absolute" inset=0
                background-image=(wide ? "linear-gradient(100deg, rgba(240,240,244,0.55) 0%, rgba(240,240,244,0.18) 38%, rgba(240,240,244,0) 60%)" : "linear-gradient(180deg, rgba(240,240,244,0.5) 0%, rgba(240,240,244,0.15) 45%, rgba(240,240,244,0) 70%)")
              // Fog drifting along the fold, out of which the books rise.
              view position="absolute" left="-15%" right="-15%" bottom=0 height="45%" opacity=0.7
                animation=(still ? "none" : "drift 26s ease-in-out infinite")
                view position="absolute" left="0%" bottom="-35%" width="55%" height="90%"
                  background-image="radial-gradient(ellipse closest-side, rgba(250,250,252,0.9) 0%, rgba(250,250,252,0) 100%)"
                view position="absolute" left="40%" bottom="-45%" width="60%" height="95%"
                  background-image="radial-gradient(ellipse closest-side, rgba(250,250,252,0.85) 0%, rgba(250,250,252,0) 100%)"
            // On a phone the door is its own screen: the painting, the line, and one glass button.
            if phoneDoor
              column position="absolute" inset=0 box-sizing="border-box" justify-content="space-between" testId="door"
                padding="calc(env(safe-area-inset-top) + 40px) 20px calc(env(safe-area-inset-bottom) + 20px)"
                // The books are the screen: one line in the sky, and the stack, large, to tap or throw through.
                column align-items="center" gap=34 flex=1 justify-content="center" padding-bottom=20 font-size="min(-exact-body, 22px)"
                  text "Give great words a voice" role="heading" aria-level=1 font-family="Jost" font-weight=300 font-size="1.75em" letter-spacing="-0.01em" color="light-dark(#1b1f2b, #1b1f2b)" text-align="center"
                    animation=(still ? "none" : "inkIn 1.1s 0.15s cubic-bezier(.2,.7,.2,1) both") testId="hero-title"
                  button press=tapBook aria-label="Next book" testId="stack" appearance="none" position="relative"
                    width=coverW height=coverH flex-shrink=0 touch-action="pan-y" pan=dragBook panrelease=dropBook cursor="grab"
                    animation=(still ? "none" : "arrive 1.2s 0.1s cubic-bezier(.2,.7,.2,1) both")
                    for g, i in greats key=g.id
                      Volume(book=g, depth=depthOf(i, cur, n), n=n, i=i, w=coverW, h=coverH,
                        dx=(depthOf(i, cur, n) == 0 ? dragX : 0), dy=(depthOf(i, cur, n) == 0 ? dragY : 0), dragging=dragging)
                column gap=12 align-items="stretch" animation=(still ? "none" : "arrive 1s 0.45s cubic-bezier(.2,.7,.2,1) both")
                  if signInError != ""
                    text signInError color="light-dark(#7a241c, #7a241c)" font-family="Jost" font-size="0.875rem" text-align="center" testId="door-error"
                  // The site needs Exact's button (it holds the popup at the press); the app's is its own, on glass,
                  // and opens a sheet of the providers' own buttons: Apple's, then Google's.
                  if app.ok
                    button commandfor="door-sheet" command="show-modal" testId="door-start" class=Chip height=58 border-radius=18 backgroundMaterial="glass" box-shadow="0 18px 40px -18px rgba(20,24,36,0.45)" -exact-press-haptic="impact-medium"
                      text "Get started" font-family="system-ui" font-weight=600 font-size="1.0625rem" color="light-dark(#14171f, #14171f)"
                    // A half sheet as tall as its content: Apple's own button (never drawn by hand), then Google's.
                    dialog id="door-sheet" aria-label="Log in or sign up" testId="door-sheet"
                      column gap=12 align-items="stretch" width=viewport.width box-sizing="border-box" padding="32px 20px calc(env(safe-area-inset-bottom) + 20px)"
                        text "Log in or sign up" role="heading" aria-level=2 font-family="system-ui" font-weight=700 font-size="1.625rem" text-align="center" color="light-dark(#14171f, #14171f)" margin-bottom=20
                        exact-sign-in-button provider="apple" press=appleSignIn testId="sheet-apple" width="100%" height=56
                        button press=googleSignIn aria-label="Continue with Google" testId="sheet-google" class=Chip width="100%" height=56 border-radius=16 background-color="light-dark(#fff, #fff)" border="1px solid light-dark(#d6d8de, #d6d8de)" gap=10 -exact-press-haptic="impact-light"
                          GoogleMark()
                          text "Continue with Google" font-family="system-ui" font-weight=600 font-size="1.0625rem" color="light-dark(#14171f, #14171f)"
                        if signInError != ""
                          text signInError color="light-dark(#7a241c, #7a241c)" font-family="system-ui" font-size="0.875rem" text-align="center" testId="sheet-error"
                  else
                    exact-sign-in-button provider="google" theme="filled_black" shape="pill" press=googleSignIn testId="door-google" width="100%" height=52
            else
              scroll id="lander-scroll" position="absolute" top=0 left=0 width="100%" height="100%" scroll=scrolled z-index=1
                overflow-x="hidden" overflow-y=(gated ? "hidden" : "auto") scrollbar-width="none"
                // The hero, over the painting: the line, and the stack of books to throw through.
                column min-height=viewport.height flex-shrink=0 box-sizing="border-box" align-items="center" justify-content="center" font-size="min(-exact-body, 22px)"
                  gap=(wide ? 44 : gated ? 26 : 32) padding=(wide ? "72px 24px 40px" : "calc(env(safe-area-inset-top) + 96px) 20px 32px")
                  text "Give great words a voice" role="heading" aria-level=1 font-family="Jost" font-weight=300 text-align="center"
                    font-size=(wide ? `${min(76, round(viewport.width * 0.052)) / 16}em` : "2.5em") line-height=1.05 padding="0.2em 0" margin="-0.2em 0" letter-spacing="-0.02em" color="light-dark(#1b1f2b, #1b1f2b)"
                    opacity=max(0, 1 - fade * 1.5) animation=(still ? "none" : "inkIn 1.1s 0.15s cubic-bezier(.2,.7,.2,1) both") testId="hero-title"
                  // Tap the top book to throw it aside, or swipe it away in any direction.
                  button press=tapBook aria-label="Next book" testId="stack" appearance="none" position="relative"
                    width=coverW height=coverH flex-shrink=0 touch-action="pan-y" pan=dragBook panrelease=dropBook cursor="grab"
                    animation=(still ? "none" : "arrive 1.4s 0.35s cubic-bezier(.2,.7,.2,1) both")
                    for g, i in greats key=g.id
                      Volume(book=g, depth=depthOf(i, cur, n), n=n, i=i, w=coverW, h=coverH,
                        dx=(depthOf(i, cur, n) == 0 ? dragX : 0), dy=(depthOf(i, cur, n) == 0 ? dragY : 0), dragging=dragging)
                  // The focused book's title, lifted off the painting by a soft pale halo, and the one thing to do with it.
                  for g in focused key=g.id
                    // On a phone the stack's lower books hang below it, so the title stands clear of them.
                    column align-items="center" gap=16 padding-top=(wide ? 20 : 28) position="relative" opacity=max(0, 1 - fade * 1.5)
                      animation=(still ? "none" : "inkIn 500ms cubic-bezier(.2,.7,.2,1) both")
                      view position="absolute" left="-30%" right="-30%" top="-10%" bottom="-25%" pointer-events="none"
                        background-image="radial-gradient(ellipse closest-side, rgba(242,242,246,0.7) 0%, rgba(242,242,246,0.35) 55%, rgba(242,242,246,0) 100%)"
                      column align-items="center" gap=5 position="relative"
                        text g.title font-family="Jost" font-weight=400 font-size="1.125rem" color="light-dark(#14171f, #14171f)" text-align="center" line-clamp=1 testId="great-title"
                        text g.author.toUpperCase() font-family="Jost" font-weight=500 font-size="0.6875rem" letter-spacing="0.26em" color="light-dark(#2c3140, #2c3140)" text-align="center" testId="great-author"
                      if not gated
                        button press=seek(g) testId="seek" position="relative" class=Chip backgroundMaterial="glass"
                          text "Open in Exalt" font-family="Jost" font-weight=400 font-size="0.9375rem" color="light-dark(#14171f, #14171f)"
                          image "symbol:forward-chevron" color="light-dark(#14171f, #14171f)" width="0.6875rem" height="0.6875rem"
                  // The door: Google's own button, the one way in.
                  if gated
                    column align-items="center" gap=10 width="100%" max-width="18.75rem" position="relative" opacity=max(0, 1 - fade * 1.5) testId="door"
                      exact-sign-in-button provider="google" theme="filled_black" shape="pill" press=googleSignIn testId="door-google" width="100%" height=48
                      if signInError != ""
                        text signInError color="light-dark(#b2463c, #b2463c)" font-family="Jost" font-size="0.875rem" text-align="center" testId="door-error"
                // Below the fold, in the dark: what Exalt is, and signing up.
                column min-height=viewport.height flex-shrink=0 display=(gated ? "none" : "flex") box-sizing="border-box" align-items="center" justify-content="center"
                  padding=(wide ? "120px 24px 120px" : "96px 24px 96px") gap=44 position="relative"
                  column max-width=640 align-items="center" gap=22 opacity=fade
                    text "Import a book you own, and Exalt reads it aloud in a voice you choose."
                      font-family="Jost" font-weight=300 font-size=(wide ? "min(-exact-title1, 44px)" : "min(-exact-title2, 30px)") line-height=1.3 padding="0.1em 0" margin="-0.1em 0" color="light-dark(#eeebe4, #eeebe4)" text-align="center" testId="about"
                    text "Generate, listen, and share for free."
                      font-family="Jost" font-weight=400 font-size=(wide ? "min(-exact-body, 22px)" : "min(-exact-subheadline, 20px)") line-height=1.6 color="light-dark(#9a978f, #9a978f)" text-align="center" max-width=520
                  column width="100%" max-width="18.75rem" align-items="stretch" gap=12 opacity=fade
                    if account.signedIn
                      text `Signed in as ${account.name}` font-family="Jost" font-size="0.9375rem" color="light-dark(#9a978f, #9a978f)" text-align="center" testId="lander-account"
                      link href=path("home") testId="lander-library" padding="13px 26px" border-radius=999 background-color="light-dark(#eeebe4, #eeebe4)" display="flex" justify-content="center"
                        -exact-press-scale=0.96 -exact-press-haptic="impact-light"
                        text "Open the library" font-family="Jost" font-weight=500 font-size="0.9375rem" color="light-dark(#1b1f2b, #1b1f2b)"
                    else
                      if identities.providers.google.active
                        exact-sign-in-button provider="google" press=googleSignIn testId="lander-google" width="100%" height=46
                      if signInError != ""
                        text signInError color="light-dark(#e8837b, #e8837b)" font-family="Jost" font-size="0.875rem" text-align="center" testId="lander-sign-in-error"
                  // The credit, at the foot of the page.
                  row align-items="center" justify-content="center" gap=5 position="absolute" left=0 right=0 bottom=(wide ? 32 : 40) opacity=fade testId="credit"
                    text "Made with" font-family="Jost" font-size="min(-exact-footnote, 16px)" color="light-dark(#9a978f, #9a978f)"
                    text "♥" font-size="min(-exact-footnote, 16px)" color="light-dark(#e8837b, #e8837b)" aria-label="love"
                    text "by" font-family="Jost" font-size="min(-exact-footnote, 16px)" color="light-dark(#9a978f, #9a978f)"
                    link href="https://devinliu.xyz" testId="credit-link"
                      text "Devin Liu" font-family="Jost" font-size="min(-exact-footnote, 16px)" color="light-dark(#eeebe4, #eeebe4)" border-bottom="1px solid light-dark(rgba(238,235,228,0.35), rgba(238,235,228,0.35))" padding-bottom=1
        // Home, the library: covers on a shelf and no words. A tap opens the book's chapters in the
        // player; a long press has Rename and Delete. The + and what's playing float at the foot.
        if e.name == "home"
          column navigationKey=`${e.id}` navigationBar="none" navigationScroll="library-shelf" position="absolute" inset=0 status-bar-style="dark-content" background-color="light-dark(#eceef2, #eceef2)" testId="home"
            text "Library" role="heading" aria-level=1 position="absolute" width="0.0625rem" height="0.0625rem" overflow="hidden" opacity=0 testId="home-title"
            if account.signedIn
              button popovertarget="account-menu" aria-label="Account" testId="account-button" class=Round backgroundMaterial="glass" position="absolute" top="calc(env(safe-area-inset-top) + 8px)" right=16 z-index=3
                image "symbol:person" color="light-dark(#14171f, #14171f)" width=18 height=18
              column id="account-menu" popover="auto" role="menu" aria-label=account.name
                button press=signOut destructive=true popovertarget="account-menu" popovertargetaction="hide" testId="home-sign-out"
                  image "symbol:sign-out"
                  text "Sign Out"
            scroll id="library-shelf" flex=1 min-height=0 width="100%" overflow-x="hidden" overflow-y="auto"
              column margin="0 auto" width="100%" max-width="47.5rem" box-sizing="border-box" padding=(wide ? "120px 40px 140px" : "calc(env(safe-area-inset-top) + 76px) 24px 140px")
                if failed(library) and library.length == 0
                  EmptyState(symbol="symbol:alert", title="Can’t Open Your Library", message="The server didn’t answer. Try again in a moment.")
                    button press=retryLibrary testId="library-retry"
                      text "Try Again"
                else if library.length == 0
                  // Nothing yet: faint blank covers on the shelf.
                  row gap=(wide ? 28 : 18) aria-hidden="true" testId="library-empty"
                    for p in ["a", "b", "c"] key=p
                      view flex=1 aspect-ratio="2 / 3" border-radius=6 border="1px solid light-dark(rgba(20,23,31,0.1), rgba(20,23,31,0.1))" background-color="light-dark(rgba(255,255,255,0.4), rgba(255,255,255,0.4))"
                else
                  view display="grid" grid-template-columns=(wide ? "repeat(5, 1fr)" : "repeat(3, 1fr)") gap=(wide ? 28 : 18) row-gap=(wide ? 36 : 26) testId="library"
                    for m in library key=m.id
                      button press=openMine(m) contextmenu=aim(m.id) contextPopover="row-menu" appearance="none" padding=0 cursor="pointer" testId=`mine-${m.id}`
                        aria-label=`${m.title}, ${statusOf(m, places)}` position="relative" -exact-press-scale=0.96 -exact-press-haptic="selection"
                        view width="100%" aspect-ratio="2 / 3" border-radius=4 overflow="hidden" background-color="light-dark(#2a2d36, #2a2d36)"
                          box-shadow="0 14px 24px -14px rgba(8,10,18,0.5)" opacity=(m.status == "failed" ? 0.45 : 1)
                          if m.cover != ""
                            image m.cover alt="" width="100%" height="100%" object-fit="cover"
                          else
                            column position="absolute" inset=0 padding=10 justify-content="center" align-items="center"
                              text m.title font-family="Jost" font-weight=300 font-size="0.8125rem" line-height=1.2 color="light-dark(#eeebe4, #eeebe4)" text-align="center" line-clamp=5
                          // Narrating: how much of it is done, a hairline along the cover's foot.
                          if m.status != "ready" or m.active > 0
                            view position="absolute" left=0 right=0 bottom=0 height=3 background-color="light-dark(rgba(255,255,255,0.35), rgba(255,255,255,0.35))"
                              view height=3 background-color="light-dark(#f4f2ec, #f4f2ec)" width=`${m.total > 0 ? round(m.done / m.total * 100) : 0}%` testId=`mine-status-${m.id}`
            column id="row-menu" popover="auto" role="menu" aria-label=aimedTitle
              button press=askRename popovertarget="row-menu" popovertargetaction="hide" testId="menu-rename"
                image "symbol:pencil"
                text "Rename…"
              hr
              button press=askRemove(aimed) destructive=true popovertarget="row-menu" popovertargetaction="hide" testId="menu-delete"
                image "symbol:delete"
                text "Delete"
            if wide
              TopBar(active="home")
        // Add a Book, a sheet over Home: first the file (a big box to upload into, or a pasted link),
        // then the book it is, its chapters, and the voice to narrate it.
        if e.name == "add"
          column navigationKey=`${e.id}` navigationBar="none" navigationScroll="add-form" position="absolute" inset=0 display="flex" flex-direction="column" color-scheme="light" status-bar-style="dark-content" background-color="light-dark(#eceef2, #eceef2)" testId="add"
            // A page of its own, no bar: its way back floats on glass, as Home's account does.
            text "Add a Book" role="heading" aria-level=1 position="absolute" width="0.0625rem" height="0.0625rem" overflow="hidden" opacity=0
            scroll id="add-form" flex=1 min-height=0 width="100%" overflow-x="hidden" overflow-y="auto"
              column margin="0 auto" width="100%" max-width=520 box-sizing="border-box" padding="calc(env(safe-area-inset-top) + 76px) 24px 64px" gap=28
                if not adding
                  // Step one: the file, and under it, tight to its edge, the other ways to one.
                  column gap=12
                    button press=chooseFile appearance="none" aria-label="Upload an EPUB, PDF or TXT" testId="choose-file" cursor="pointer"
                      width="100%" height=280 box-sizing="border-box" border="1.5px dashed light-dark(rgba(20,23,31,0.18), rgba(20,23,31,0.18))" border-radius=28 background-color="light-dark(rgba(255,255,255,0.45), rgba(255,255,255,0.45))"
                      display="flex" flex-direction="column" align-items="center" justify-content="center" gap=12 -exact-press-scale=0.98 -exact-press-haptic="impact-light"
                      image "symbol:document" color="light-dark(#14171f, #14171f)" width=34 height=34
                      text "EPUB, PDF or TXT" font-size="0.875rem" color="light-dark(#8a8f9c, #8a8f9c)"
                    input type="file" id="upload" display="none" change=picked testId="upload"
                    row gap=24 justify-content="flex-start" padding-left=4 padding-top=4
                      button commandfor="link-sheet" command="show-modal" appearance="none" testId="add-paste" padding="10px 0" min-height=44 cursor="pointer"
                        text "Paste link" font-size="1.0625rem" color="light-dark(#14171f, #14171f)"
                      button press=openLibrary("https://z-library.sk") appearance="none" testId="open-zlibrary" padding="10px 0" min-height=44 cursor="pointer"
                        text "Z-Library" font-size="1.0625rem" color="light-dark(#6b7080, #6b7080)"
                      button press=openLibrary("https://libgen.li") appearance="none" testId="open-libgen" padding="10px 0" min-height=44 cursor="pointer"
                        text "LibGen" font-size="1.0625rem" color="light-dark(#6b7080, #6b7080)"
                  // A link: a small sheet of its own, the field and Add.
                  dialog id="link-sheet" aria-label="Paste a link" testId="link-sheet" width="100%"
                    column gap=18 width="100%" max-width=440 margin="0 auto" box-sizing="border-box" padding="28px 24px calc(env(safe-area-inset-bottom) + 20px)"
                      input type="url" value=link input=editLink submit=takeLink autofocus=true placeholder="https://" aria-label="Link to a book file" testId="link"
                        autocapitalize="none" autocomplete="off" spellcheck=false enterkeyhint="go"
                        width="100%" box-sizing="border-box" appearance="none" font-size="1.0625rem" color="light-dark(#14171f, #14171f)"
                        background-color="transparent" border="none" border-bottom="1px solid light-dark(rgba(20,23,31,0.25), rgba(20,23,31,0.25))" border-radius=0 padding="12px 0" outline="none"
                      if refusal != ""
                        text refusal font-size="0.875rem" color="-exact-system-red" testId="add-error"
                      button press=takeLink appearance="none" testId="add-link-go" disabled=(link.trim() == "")
                        width="100%" height=54 border-radius=999 display="flex" align-items="center" justify-content="center" cursor="pointer"
                        background-color="light-dark(#14171f, #14171f)" opacity=(link.trim() == "" ? 0.35 : 1) -exact-press-scale=0.97 -exact-press-haptic="impact-medium"
                        text "Add" font-size="1.0625rem" font-weight=600 color="light-dark(#f4f2ec, #f4f2ec)"
                else if failed(preview)
                  column gap=20 align-items="center" padding-top=80
                    text "Exalt couldn’t read that file. Try another, or paste a link to it." font-size="1rem" color="light-dark(#14171f, #14171f)" text-align="center" testId="add-error"
                    button press=resetAdd appearance="none" testId="add-again" padding="10px 16px" cursor="pointer"
                      text "Choose another" font-size="0.9375rem" color="light-dark(#6b7080, #6b7080)"
                else if pending(preview) or (preview.title == "" and preview.error == "")
                  column height=360 align-items="center" justify-content="center" gap=16
                    progress aria-label=readingText testId="add-reading"
                    text readingText font-size="0.9375rem" color="light-dark(#6b7080, #6b7080)" text-align="center" testId="add-reading-text"
                else if not preview.ok
                  column gap=20 align-items="center" padding-top=80
                    text (preview.error != "" ? preview.error : "That file isn’t a book Exalt can read.") font-size="1rem" color="light-dark(#14171f, #14171f)" text-align="center" testId="add-error"
                    button press=resetAdd appearance="none" testId="add-again" padding="4px 0" cursor="pointer"
                      text "Choose another" font-size="0.9375rem" color="light-dark(#6b7080, #6b7080)"
                else
                  // Step two: the book, in the lander's face, with room around it.
                  column gap=14 align-items="center" padding-top=24 testId="add-book"
                    BookCover(src=preview.cover, title=preview.title, w=168, flat=false)
                    column gap=8 align-items="center" padding-top=18
                      text preview.title role="heading" aria-level=3 font-family="Jost" font-weight=300 font-size="1.75rem" line-height=1.25 letter-spacing="-0.01em" color="light-dark(#14171f, #14171f)" text-align="center" testId="add-title"
                      if preview.author != ""
                        text preview.author.toUpperCase() font-family="Jost" font-weight=500 font-size="0.6875rem" letter-spacing="0.26em" color="light-dark(#6b7080, #6b7080)" text-align="center" testId="add-author"
                    // The book in numbers: about how long it is to hear, and its pages.
                    text `${listenText}  ·  ${max(1, round(preview.words / 275))} pp.` padding-top=14 font-size="0.9375rem" font-weight=500 color="light-dark(#4a4f5c, #4a4f5c)" font-variant-numeric="tabular-nums" text-align="center" testId="add-stats"
                  column testId="add-chapters"
                    for c, i in preview.chapters key=i
                      row padding="11px 0" border-top=(i == 0 ? "none" : "1px solid light-dark(rgba(20,23,31,0.06), rgba(20,23,31,0.06))")
                        text c font-size="0.9375rem" color="light-dark(#14171f, #14171f)" flex=1 min-width=0 line-clamp=1
                  column gap=14 align-items="center" padding-bottom=120
                    if refusal != ""
                      text refusal font-size="0.9375rem" color="-exact-system-red" text-align="center" testId="import-hint"
                    button press=resetAdd appearance="none" testId="add-again" padding="10px 16px" cursor="pointer"
                      text "Choose another" font-size="0.9375rem" color="light-dark(#6b7080, #6b7080)"
            // Step two's composer, on one glass bar at the foot: the model and the voice, each a menu, and Generate.
            if adding and preview.ok and not pending(preview)
              row position="absolute" left=16 right=16 bottom="calc(env(safe-area-inset-bottom) + 12px)" max-width="32rem" margin="0 auto" box-sizing="border-box"
                align-items="center" gap=4 padding=8 border-radius=999 backgroundMaterial="glass" class=Lift testId="composer"
                button popovertarget="model-menu" appearance="none" aria-label=`Voice model: ${modelName}` testId="model" class=Pill flex-shrink=1
                  text modelName font-size="0.9375rem" font-weight=500 color="light-dark(#14171f, #14171f)" line-clamp=1 min-width=0
                  image "symbol:sf/chevron.down" color="light-dark(#6b7080, #6b7080)" width=10 height=10 flex-shrink=0
                column id="model-menu" popover="auto" role="menu" aria-label="Voice model"
                  for m in models key=m.id
                    button press=pickModel(m.id) popovertarget="model-menu" popovertargetaction="hide" testId=`model-${m.id}`
                      if m.id == chosenModel
                        image "symbol:checkmark"
                      text m.name
                if fishModel or voices.length > 0
                  button popovertarget="voice-menu" appearance="none" aria-label=`Voice: ${voiceName}` testId="import-voice" class=Pill flex-shrink=1
                    image "symbol:waveform" color="light-dark(#14171f, #14171f)" width=16 height=16 flex-shrink=0
                    text voiceName font-size="0.9375rem" font-weight=500 color="light-dark(#14171f, #14171f)" line-clamp=1 min-width=0
                    image "symbol:sf/chevron.down" color="light-dark(#6b7080, #6b7080)" width=10 height=10 flex-shrink=0
                  column id="voice-menu" popover="auto" role="menu" aria-label="Voice"
                    if fishModel
                      button press=pickVoice("") popovertarget="voice-menu" popovertargetaction="hide" testId="voice-default"
                        if voicePref.id == ""
                          image "symbol:checkmark"
                        text "Default voice"
                      if voicePref.id != "" and voiceList.filter(v => v.id == voicePref.id).length == 0
                        button press=pickVoice(voicePref.id) popovertarget="voice-menu" popovertargetaction="hide"
                          image "symbol:checkmark"
                          text voicePref.title
                      for v in voiceList key=v.id
                        button press=pickVoice(v.id) popovertarget="voice-menu" popovertargetaction="hide" testId=`voice-${v.id}`
                          if v.id == voicePref.id
                            image "symbol:checkmark"
                          text v.title
                    else
                      button press=editVoice("") popovertarget="voice-menu" popovertargetaction="hide" testId="voice-default"
                        if voice == ""
                          image "symbol:checkmark"
                        text "Default voice"
                      for v in voices key=v
                        button press=editVoice(v) popovertarget="voice-menu" popovertargetaction="hide"
                          if v == voice
                            image "symbol:checkmark"
                          text v
                button press=narrate appearance="none" testId="narrate" disabled=(not canImport) aria-label="Generate"
                  height=48 padding="0 20px" flex-shrink=0 margin-left="auto" border-radius=999 display="flex" align-items="center" justify-content="center" gap=8
                  background-color="light-dark(#14171f, #14171f)" opacity=(canImport ? 1 : 0.35) cursor="pointer" -exact-press-scale=0.95 -exact-press-haptic="impact-medium"
                  if pending(imported)
                    progress aria-label="Starting" color="light-dark(#f4f2ec, #f4f2ec)"
                  else
                    text "Generate" font-size="1rem" font-weight=600 color="light-dark(#f4f2ec, #f4f2ec)"
            button id="back" press=back aria-label="Back" testId="import-cancel" class=Round backgroundMaterial="glass" position="absolute" top="calc(env(safe-area-inset-top) + 8px)" left=16 z-index=5 -exact-press-haptic="impact-light"
              image "symbol:back" color="light-dark(#14171f, #14171f)" width=18 height=18
        // The player, in the dark: the cover lights the room, and the controls float on glass. What it
        // plays is App's (below), so leaving it keeps the chapter playing in the mini player.
        if e.name == "play"
          column navigationKey=`${e.id}` navigationBar="none" navigationScroll="player" position="absolute" inset=0 background-color="light-dark(#121419, #121419)" color-scheme="dark" status-bar-style="light-content" testId="player"
            background-image="radial-gradient(ellipse closest-side at 50% 32%, rgba(140,148,170,0.20) 0%, rgba(140,148,170,0) 100%)"
            if audiobook.id != e.params.gen
              if failed(audiobook) and not pending(audiobook)
                column flex=1 min-height=0 justify-content="center" testId="player-gone"
                  EmptyState(symbol="symbol:alert", title="Can’t Play This", message="It was removed or made private.")
                    button press=back testId="player-gone-back"
                      text "Back"
              else
                column flex=1 justify-content="center" align-items="center"
                  progress aria-label="Loading" testId="player-loading"
            else
              if audiobook.cover != ""
                view position="absolute" top=0 left=0 right=0 height="78%" overflow="hidden" pointer-events="none"
                  image audiobook.cover alt="" position="absolute" top="-20%" left="-20%" width="140%" height="140%" object-fit="cover" filter="blur(56px) saturate(1.5)" opacity=0.7
                  view position="absolute" inset=0 background-image="linear-gradient(180deg, rgba(18,20,25,0.3) 0%, rgba(18,20,25,0.62) 55%, #121419 100%)"
              scroll id="player" position="absolute" top=0 left=0 width="100%" height="100%" overflow-x="hidden" overflow-y="auto" scrollbar-width="none"
                view height="env(safe-area-inset-top)" flex-shrink=0
                column margin="0 auto" width="100%" max-width="35rem" box-sizing="border-box" padding=(wide ? "32px 32px 80px" : "8px 22px 64px") gap=(wide ? 32 : 30)
                  button press=back aria-label="Back" testId="player-back" class=Round backgroundMaterial="glass" align-self="flex-start" margin-left=-6
                    image "symbol:back" color="light-dark(#eeebe4, #eeebe4)" width=18 height=18
                  column align-items="center" gap=28 margin-top=(wide ? 0 : -14)
                    view animation=(still ? "none" : "arrive 900ms cubic-bezier(.2,.7,.2,1) both")
                      scale=(held ? 0.92 : 1) transition="scale 500ms cubic-bezier(.2,.9,.3,1.15)"
                      BookCover(src=audiobook.cover, title=audiobook.title, w=playerCover, flat=false)
                    column align-items="center" gap=8
                      text audiobook.title role="heading" aria-level=1 font-weight=700 font-size=(wide ? "2rem" : "min(-exact-title1, 40px)") line-height=1.5 color="light-dark(#eeebe4, #eeebe4)" text-align="center"
                      text audiobook.author.toUpperCase() font-weight=600 font-size="0.6875rem" letter-spacing="0.06em" color="light-dark(#b5b2aa, #b5b2aa)" text-align="center"
                      text trackTitle(audiobook, track) font-size="0.9375rem" color="light-dark(#d6d3cb, #d6d3cb)" text-align="center" line-height=1.4 line-clamp=2 padding-top=8 testId="now-playing"
                      row justify-content="center" align-items="center" flex-wrap="wrap" gap=8 testId="player-credit"
                        if audiobook.public
                          image "symbol:people" color="light-dark(#b5b2aa, #b5b2aa)" aria-label="Shared publicly" font-size="0.8125rem" testId="player-shared"
                        text readBy(audiobook.voice, audiobook.by) font-size="0.8125rem" color="light-dark(#b5b2aa, #b5b2aa)" text-align="center"
                  // Being prepared, or couldn't be: no chapters yet.
                  if audiobook.status != "ready"
                    row gap=12 align-items="center" justify-content="center" padding="18px 20px" border-radius=30 backgroundMaterial="glass" testId="preparing"
                      if audiobook.status != "failed"
                        progress aria-label="Preparing"
                      text (audiobook.status == "failed" ? audiobook.error : "Preparing the book…") font-size="1rem" line-height=1.4
                        color=(audiobook.status == "failed" ? "light-dark(#f0a093, #f0a093)" : "light-dark(#d6d3cb, #d6d3cb)") text-align="center"
                  else if playSrc != ""
                    column gap=6
                      input type="range" min=0 max=max(1, round(duration)) step=1 value=round(now) input=scrub aria-label="Position" testId="scrub" width="100%" accent-color="light-dark(#eeebe4, #eeebe4)"
                      row justify-content="space-between"
                        text clock(now) font-size="0.75rem" color="light-dark(#b5b2aa, #b5b2aa)" testId="elapsed"
                        text (duration > 0 ? `−${clock(duration - now)}` : "") font-size="0.75rem" color="light-dark(#b5b2aa, #b5b2aa)"
                    column gap=12
                      row justify-content="space-between" align-items="center" padding="10px 18px" border-radius=999 backgroundMaterial="glass"
                        button press=cycleRate appearance="none" aria-label="Speed" testId="rate" width="3rem" min-height=44 padding="8px 0" cursor="pointer" -exact-press-scale=0.9
                          text rateText(rate) font-weight=500 font-size="0.9375rem" color="light-dark(#eeebe4, #eeebe4)" text-align="center"
                        button press=back15 appearance="none" aria-label="Back 15 seconds" testId="back15" padding=8 cursor="pointer" -exact-press-scale=0.88 -exact-press-haptic="impact-light"
                          image "symbol:skip-back-15" color="light-dark(#eeebe4, #eeebe4)" width=28 height=28
                        button press=toggle appearance="none" aria-label=(held ? "Play" : "Pause") aria-keyshortcuts="Space" testId="toggle"
                          width=68 height=68 min-width=68 padding=0 flex-shrink=0 border-radius=999 display="flex" align-items="center" justify-content="center" background-color="light-dark(#eeebe4, #eeebe4)" cursor="pointer"
                          box-shadow="0 14px 36px -10px rgba(0,0,0,0.6)" -exact-press-scale=0.9 -exact-press-haptic="impact-medium"
                          image (held ? "symbol:play-fill" : "symbol:pause-fill") color="light-dark(#14171f, #14171f)" width=26 height=26
                        button press=fwd30 appearance="none" aria-label="Forward 30 seconds" testId="fwd30" padding=8 cursor="pointer" -exact-press-scale=0.88 -exact-press-haptic="impact-light"
                          image "symbol:skip-forward-30" color="light-dark(#eeebe4, #eeebe4)" width=28 height=28
                        button popovertarget="sleep-menu" appearance="none" aria-label=(sleepMins == 0 ? "Sleep timer" : `Sleep timer: ${sleepText(sleepMins, sleepLeft)}`) testId="sleep"
                          width="3rem" min-height=44 padding="8px 0" align-items="center" cursor="pointer" display="flex" justify-content="center" -exact-press-scale=0.9 -exact-press-haptic="selection"
                          image "symbol:moon" color=(sleepMins != 0 ? "light-dark(#eeebe4, #eeebe4)" : "light-dark(#8f8c85, #8f8c85)") width=20 height=20
                      if sleepMins != 0
                        text sleepText(sleepMins, sleepLeft) font-size="0.8125rem" color="light-dark(#d6d3cb, #d6d3cb)" text-align="center" testId="sleep-left"
                    // The sleep timer's choices, as the platform's menu; a choice checks it.
                    column id="sleep-menu" popover="auto" role="menu" aria-label="Sleep timer"
                      button press=setSleep(0) aria-checked=(sleepMins == 0) popovertarget="sleep-menu" popovertargetaction="hide" testId="sleep-off"
                        text "Off"
                      button press=setSleep(15) aria-checked=(sleepMins == 15) popovertarget="sleep-menu" popovertargetaction="hide" testId="sleep-15"
                        text "15 minutes"
                      button press=setSleep(30) aria-checked=(sleepMins == 30) popovertarget="sleep-menu" popovertargetaction="hide" testId="sleep-30"
                        text "30 minutes"
                      button press=setSleep(60) aria-checked=(sleepMins == 60) popovertarget="sleep-menu" popovertargetaction="hide" testId="sleep-60"
                        text "1 hour"
                      button press=setSleep(-1) aria-checked=(sleepMins == -1) popovertarget="sleep-menu" popovertargetaction="hide" testId="sleep-chapter"
                        text "End of chapter"
                  // A chapter with no audio yet: the player stops here and offers to narrate it.
                  else
                    column gap=12 align-items="center" padding="22px 20px" border-radius=30 backgroundMaterial="glass" testId="not-narrated"
                      text `Chapter ${track + 1} isn’t narrated yet.` font-weight=400 font-size="1.25rem" line-height=1.45 color="light-dark(#eeebe4, #eeebe4)" text-align="center"
                      if inFlight(trackStatus(audiobook, track))
                        row gap=10 align-items="center"
                          progress aria-label="Narrating"
                          text "Narrating. It plays here in a moment." font-size="0.9375rem" color="light-dark(#d6d3cb, #d6d3cb)"
                      else if trackStatus(audiobook, track) == "unavailable"
                        text "Its text wasn’t kept. Import the book again to hear it." font-size="0.9375rem" line-height=1.45 color="light-dark(#d6d3cb, #d6d3cb)" text-align="center"
                      else
                        button press=generate(track) buttonStyle="glass" aria-label=`Generate chapter ${track + 1}` testId="generate-current" disabled=(atLimit or genPending) max-width="100%"
                          text (trackStatus(audiobook, track) == "failed" ? "Retry" : "Generate") font-size="min(-exact-body, 30px)"
                  if genRefusal != ""
                    text genRefusal font-size="0.875rem" line-height=1.45 color="light-dark(#f0a093, #f0a093)" text-align="center" testId="generate-error"
                  // The chapters: a narrated one plays at a tap; one that isn't offers Generate (Retry when it failed).
                  column padding="20px 20px 8px" border-radius=30 backgroundMaterial="glass" testId="chapters"
                    row align-items="baseline" gap=12 padding-bottom=8
                      text "CHAPTERS" flex=1 font-weight=600 font-size="0.6875rem" letter-spacing="0.06em" color="light-dark(#b5b2aa, #b5b2aa)"
                      if account.signedIn and audiobook.mine > 0
                        text `${audiobook.mine} of ${audiobook.limit} in progress` font-size="0.8125rem" color=(atLimit ? "light-dark(#eeebe4, #eeebe4)" : "light-dark(#b5b2aa, #b5b2aa)") testId="in-progress"
                    for c in audiobook.chapters key=c.idx
                      row align-items="center" column-gap=12 flex-wrap="wrap" border-top="1px solid light-dark(rgba(238,235,228,0.1), rgba(238,235,228,0.1))" testId=`chapter-${c.idx}`
                        if c.src != ""
                          button press=playTrack(c.idx) appearance="none" text-align="start" display="flex" align-items="center" gap=16 padding="13px 0" flex="1 1 10rem" min-width=0
                            cursor="pointer" aria-current=(c.idx == track ? "true" : "false") testId=`track-${c.idx}` -exact-press-opacity=0.6
                            ChapterLine(chapter=c, current=(c.idx == track), kept=(keptAt(offline, audiobook.id, c.idx) != ""))
                            image (c.idx == track ? "symbol:waveform" : "symbol:play-fill") color="light-dark(#eeebe4, #eeebe4)" font="-exact-callout" flex-shrink=0
                        else
                          row align-items="center" gap=16 padding="13px 0" flex="1 1 10rem" min-width=0 testId=`track-${c.idx}`
                            ChapterLine(chapter=c, current=(c.idx == track), kept=false)
                        if c.status == "idle" or c.status == "failed"
                          button press=generate(c.idx) buttonStyle="glass" aria-label=`Generate chapter ${c.idx + 1}` testId=`generate-${c.idx}` disabled=(atLimit or genPending) flex-shrink=0 max-width="100%" margin-bottom=6
                            text (c.status == "failed" ? "Retry" : "Generate") font-size="min(-exact-body, 30px)"
                        else if inFlight(c.status)
                          progress aria-label=`Narrating chapter ${c.idx + 1}` flex-shrink=0
                    if atLimit
                      text `${audiobook.limit} of ${audiobook.limit} in progress. Generate again when one finishes.` font-size="0.8125rem" line-height=1.45 color="light-dark(#b5b2aa, #b5b2aa)" padding="10px 0 6px" testId="at-limit"
                  // Download: the narrated chapters kept on this device, to play without a connection.
                  if narratedHere > 0 or anyKept
                    column gap=14 padding="18px 20px" border-radius=30 backgroundMaterial="glass" testId="download-box"
                      row gap=14 align-items="center" flex-wrap="wrap"
                        image (keptHere > 0 and keptHere >= narratedHere ? "symbol:checkmark" : savingHere ? "symbol:download-pending" : "symbol:download") color="light-dark(#eeebe4, #eeebe4)" font-size="1.25rem" flex-shrink=0
                        column flex="1 1 10rem" min-width=0 gap=3
                          text savedTitle(keptHere, narratedHere, savingHere) font-size="1rem" color="light-dark(#eeebe4, #eeebe4)" testId="download-state"
                          if not savingHere
                            text savedNote(keptHere, narratedHere) font-size="0.8125rem" line-height=1.4 color="light-dark(#b5b2aa, #b5b2aa)"
                      if savingHere
                        progress value=keptHere max=max(1, narratedHere) aria-label="Downloading" testId="download-progress" width="100%" accent-color="light-dark(#eeebe4, #eeebe4)"
                      else
                        row gap=10 flex-wrap="wrap"
                          if keptHere < narratedHere
                            button press=download buttonStyle="glass" testId="download" disabled=(pending(savedAll) or pending(unsaved))
                              text (keptHere > 0 ? "Download the rest" : "Download")
                          if anyKept
                            button press=unsave buttonStyle="glass" testId="remove-download" disabled=(pending(savedAll) or pending(unsaved))
                              text "Remove download"
                      if saveError != ""
                        text saveError font-size="0.8125rem" line-height=1.45 color="light-dark(#f0a093, #f0a093)" testId="download-error"
                  // Its maker may delete it, as from the library: it goes for everyone.
                  if audiobook.owner
                    button press=askRemove(audiobook.id) appearance="none" testId="delete" align-self="center" padding="6px 0" cursor="pointer"
                      text "Delete this audiobook" font-size="0.875rem" color="light-dark(#b5b2aa, #b5b2aa)" border-bottom="1px solid light-dark(rgba(238,235,228,0.25), rgba(238,235,228,0.25))" padding-bottom=2
      // The one player, for every screen: it keeps playing while the listener browses. The lock
      // screen's skips are the player's own, back 15 and ahead 30.
      if playSrc != ""
        audio id="player-audio" src=playSrc paused=held playbackRate=rate preload="auto"
          timeupdate=tick durationchange=gotDuration loadedmetadata=resumeAt ended=chapterEnded play=played pause=stopped
          metadata=MediaMetadata(title=trackTitle(audiobook, track), artist=audiobook.author, album=audiobook.title, artwork=audiobook.cover)
          seekbackwardOffset=15 seekforwardOffset=30
          seekbackward=back15 seekforward=fwd30 nexttrack=nextTrack previoustrack=prevTrack testId="audio"
      // The bar at the foot of Home: the + on the right, and what's playing grown out of it, one
      // Liquid Glass group, so the player swells from the + and they merge while close.
      if top(nav).name == "home"
        row position="absolute" left=0 right=0 bottom=0 justify-content="center" pointer-events="none" z-index=20 testId="dock"
          padding=(wide ? "0 16px 24px" : "0 16px clamp(14px, calc(env(safe-area-inset-bottom) - 8px), 40px)")
          row width="100%" max-width="25rem" align-items="center" justify-content="flex-end" gap=10 glassGroup=16 pointer-events="none"
            // The mini player: the chapter playing, to pause or play; a tap on it opens the player.
            if miniOn
              row flex=1 min-width=0 box-sizing="border-box" align-items="center" gap=6 padding=6 border-radius=999 position="relative" overflow="hidden"
                backgroundMaterial="glass" pointer-events="auto" testId="mini-player"
                button press=openPlayer appearance="none" aria-label=`Now playing: ${trackTitle(audiobook, track)}, ${audiobook.title}` testId="mini-open" text-align="start" cursor="pointer"
                  flex=1 min-width=0 display="flex" align-items="center" gap=12 padding="0 4px 0 0" -exact-press-opacity=0.7 -exact-press-haptic="impact-light"
                  if audiobook.cover != ""
                    image audiobook.cover alt="" width=44 height=44 border-radius=999 object-fit="cover" flex-shrink=0
                  else
                    view width=44 height=44 border-radius=999 background-color="light-dark(#2a2d36, #2a2d36)" flex-shrink=0
                  column flex=1 min-width=0 gap=1 font-size="min(-exact-subheadline, 20px)"
                    text trackTitle(audiobook, track) font-size="1em" color="light-dark(#14171f, #14171f)" line-clamp=1 testId="mini-title"
                    text audiobook.title font-size="0.8em" color="light-dark(#5c6170, #5c6170)" line-clamp=1 testId="mini-book"
                button press=toggle appearance="none" aria-label=(held ? "Play" : "Pause") testId="mini-toggle" disabled=(playSrc == "")
                  width=44 height=44 min-width=44 padding=0 flex-shrink=0 border-radius=999 display="flex" align-items="center" justify-content="center"
                  background-color="light-dark(#14171f, #14171f)" opacity=(playSrc == "" ? 0.35 : 1) cursor="pointer" -exact-press-scale=0.9 -exact-press-haptic="impact-medium"
                  image (held ? "symbol:play-fill" : "symbol:pause-fill") color="light-dark(#f4f2ec, #f4f2ec)" font-size="min(-exact-subheadline, 18px)"
                // How far into the chapter: a hairline along the capsule's foot.
                view position="absolute" left=28 right=28 bottom=0 height=2 border-radius=1 background-color="light-dark(rgba(20,23,31,0.1), rgba(20,23,31,0.1))" pointer-events="none"
                  view height=2 border-radius=1 background-color="light-dark(#14171f, #14171f)" width=`${duration > 0 ? round(min(1, now / duration) * 100) : 0}%`
            // Add a book: a file, a link, or one found on Z-Library or LibGen.
            button press=openImport aria-label="Add a book" testId="import" class=Round width=56 height=56 min-width=56 flex-shrink=0 backgroundMaterial="glass" pointer-events="auto" -exact-press-haptic="impact-light"
              image "symbol:add" color="light-dark(#14171f, #14171f)" width=22 height=22
      // A chapter this listener asked for is ready: a notice at the top, to play it.
      if notice != ""
        row position="absolute" top="calc(env(safe-area-inset-top) + 10px)" left=16 right=16 margin="0 auto" max-width="25rem" box-sizing="border-box" z-index=30
          align-items="center" gap=10 padding="8px 8px 8px 20px" border-radius=999 backgroundMaterial="glass" class=Lift color-scheme="light" role="status" testId="notice"
          animation=(still ? "none" : "dockIn 420ms cubic-bezier(.2,.9,.3,1.1) both")
          column flex=1 min-width=0 gap=1 font-size="min(-exact-subheadline, 20px)"
            text notice font-size="1em" color="light-dark(#14171f, #14171f)" line-clamp=1 testId="notice-title"
            text `Ready to play · ${noticeBook}` font-size="0.8em" color="light-dark(#5c6170, #5c6170)" line-clamp=1
          button press=noticePlay appearance="none" aria-label=`Play ${notice}` testId="notice-play"
            height=40 padding="0 18px" flex-shrink=0 border-radius=999 display="flex" align-items="center" gap=6 background-color="light-dark(#14171f, #14171f)" cursor="pointer" -exact-press-scale=0.94
            image "symbol:play-fill" color="light-dark(#f4f2ec, #f4f2ec)" font-size="min(-exact-caption1, 16px)"
            text "Play" font-weight=500 font-size="min(-exact-subheadline, 20px)" color="light-dark(#f4f2ec, #f4f2ec)"
          button press=clearNotice appearance="none" aria-label="Dismiss" testId="notice-close" class=Round width=40 height=40
            image "symbol:close" color="light-dark(#5c6170, #5c6170)" font-size="min(-exact-caption1, 16px)"
      // Signing in for a chapter's Generate, from anywhere: the app's sheet has Apple's own button, then
      // Google's; the site needs Exact's Google button (it holds the popup at the press).
      dialog id="account-sheet" aria-label="Log in or sign up" close=sheetClosed testId="account-sheet"
        column gap=12 align-items="stretch" width="100%" max-width="27.5rem" margin="0 auto" box-sizing="border-box" padding="32px 20px calc(env(safe-area-inset-bottom) + 20px)"
          text "Log in or sign up" role="heading" aria-level=2 font-family="system-ui" font-weight=700 font-size="1.625rem" text-align="center" color="light-dark(#14171f, #14171f)"
          text "Sign in to narrate this chapter." font-family="system-ui" font-size="1rem" text-align="center" color="light-dark(#5c6170, #5c6170)" margin-bottom=12
          if app.ok
            exact-sign-in-button provider="apple" press=appleSignIn testId="account-apple" width="100%" height=56
            button press=googleSignIn aria-label="Continue with Google" testId="account-google" class=Chip width="100%" height=56 border-radius=16 background-color="light-dark(#fff, #fff)" border="1px solid light-dark(#d6d8de, #d6d8de)" gap=10 -exact-press-haptic="impact-light"
              GoogleMark()
              text "Continue with Google" font-family="system-ui" font-weight=600 font-size="1.0625rem" color="light-dark(#14171f, #14171f)"
          else
            exact-sign-in-button provider="google" theme="filled_black" shape="pill" press=googleSignIn testId="account-site-google" width="100%" height=52
          if signInError != ""
            text signInError color="light-dark(#7a241c, #7a241c)" font-family="system-ui" font-size="0.875rem" text-align="center" testId="account-error"
      // The library's alerts: deleting, sharing (the person confirms the right to share), renaming, a refusal.
      dialog id="remove-alert" role="alertdialog" aria-label=`Delete “${aimedTitle}”?`
        text "The audiobook is gone for good, for you and for anyone listening in Browse."
        button press=remove destructive=true commandfor="remove-alert" command="close" testId="remove-confirm"
          text "Delete"
        button commandfor="remove-alert" command="close" testId="remove-cancel"
          text "Cancel"
      dialog id="share-alert" role="alertdialog" aria-label="Share Publicly?"
        text "Anyone can listen to it in Browse. Only share books you have the right to."
        button press=shareAimed commandfor="share-alert" command="close" testId="share-confirm"
          text "I Have the Right"
        button commandfor="share-alert" command="close" testId="share-cancel"
          text "Cancel"
      dialog id="rename-alert" role="alertdialog" aria-label="Rename"
        input value=renameTitle input=editRenameTitle placeholder="Title" aria-label="Title" testId="rename-title"
        button press=rename disabled=(renameTitle.trim() == "") commandfor="rename-alert" command="close" testId="rename-save"
          text "Save"
        button commandfor="rename-alert" command="close" testId="rename-cancel"
          text "Cancel"
      dialog id="change-alert" role="alertdialog" aria-label="Couldn’t Change It"
        text changeMessage testId="change-message"
        button commandfor="change-alert" command="close" testId="change-ok"
          text "OK"


// What floats: a capsule to press, a round button.
style Chip
  appearance="none" display="flex" align-items="center" justify-content="center" gap=8 height=44 padding="0 18px" border-radius=999
  box-sizing="border-box" flex-shrink=0 cursor="pointer" -exact-press-scale=0.95 -exact-press-haptic="selection"
// A chip on the composer's glass: an icon, a name and a chevron, a menu behind it.
style Pill
  display="flex" align-items="center" gap=6 height=48 padding="0 10px" border-radius=999 min-width=0 cursor="pointer"

style Round
  appearance="none" display="flex" align-items="center" justify-content="center" width=44 height=44 padding=0 border-radius=999
  flex-shrink=0 cursor="pointer" -exact-press-scale=0.9 -exact-press-haptic="selection"
style Lift
  box-shadow="0 12px 30px -14px rgba(20,24,36,0.32)"

// The painting as weather at the top of a light screen, thinning into the page.
component Mist
  view
    view position="absolute" top=0 left=0 right=0 height=300 overflow="hidden" pointer-events="none"
      image "assets/lander.jpg" alt="" position="absolute" top=0 left=0 width="100%" height="100%" object-fit="cover" opacity=0.75
      view position="absolute" inset=0 background-image="linear-gradient(180deg, rgba(236,238,242,0.35) 0%, rgba(236,238,242,0.75) 55%, #eceef2 100%)"

// Google's "G", in its own colours.
component GoogleMark
  view
    svg viewBox="0 0 48 48" width=19 height=19 aria-hidden="true"
      path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
      path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
      path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
      path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"

// A chapter's line in the player's list: its number, its title (the one playing set heavier), and
// how its narration is going when it isn't narrated, or that it's downloaded.
component ChapterLine
  props
    chapter: Chapter
    current: bool
    kept: bool
  view
    row flex=1 min-width=0 align-items="center" gap=16
      text `${chapter.idx + 1}` font-size="min(-exact-footnote, 17px)" color="light-dark(#eeebe4, #eeebe4)" min-width="min(1.5rem, 24px)" flex-shrink=0
      column flex=1 min-width=0 gap=2
        text chapter.title line-clamp=2 font-weight=(current ? 500 : 400) font-size="1rem" line-height=1.4 color="light-dark(#eeebe4, #eeebe4)"
        if chapter.status != "ready" and chapterNote(chapter) != ""
          text (chapter.status == "failed" and chapter.error != "" ? chapter.error : chapterNote(chapter)) line-clamp=2 font-size="0.8125rem"
            color=(chapter.status == "failed" ? "light-dark(#f6b8ad, #f6b8ad)" : "light-dark(#eeebe4, #eeebe4)") testId=`chapter-note-${chapter.idx}`
        else if kept
          row gap=5 align-items="center" flex-wrap="wrap" testId=`chapter-kept-${chapter.idx}`
            image "symbol:checkmark" color="light-dark(#eeebe4, #eeebe4)" font-size="min(-exact-caption2, 14px)"
            text "Downloaded" font-size="min(-exact-caption1, 18px)" color="light-dark(#eeebe4, #eeebe4)"

component TopBar
  props
    active: string
  view
    row align-items="center" gap=30 padding="22px 7vw" position="absolute" top=0 left=0 right=0 z-index=5
      background-color="light-dark(rgba(236,238,242,0.72), rgba(236,238,242,0.72))" backdrop-filter="blur(14px)" border-bottom="1px solid light-dark(rgba(20,23,31,0.06), rgba(20,23,31,0.06))"
      link href=path("lander") testId="nav-exalt"
        text "EXALT" font-family="Jost" font-weight=500 font-size="0.875rem" letter-spacing="0.5em" color="light-dark(#14171f, #14171f)"
      view flex=1
      link href=path("home") testId="nav-home" padding="4px 0"
        text "Library" font-size="0.9375rem" color=(active == "home" ? "light-dark(#14171f, #14171f)" : "light-dark(#626777, #626777)")
          border-bottom=(active == "home" ? "1px solid light-dark(#14171f, #14171f)" : "1px solid transparent") padding-bottom=2

component SectionTitle
  props
    label: string
  view
    view font-size="min(-exact-body, 30px)"
      text label.toUpperCase() role="heading" aria-level=2 font-weight=600 font-size="0.6875em" letter-spacing="0.06em" color="light-dark(#626777, #626777)"

// A cover as a book: page edges under it and light along the spine. Without art, its title on cloth.
component BookCover
  props
    src: string
    title: string
    w: number
    flat: bool
  view
    view position="relative" width=w height=round(w * 1.5) flex-shrink=0 border-radius=3 background-color="light-dark(#2a2d36, #2a2d36)"
      box-shadow=(flat ? "none" : "1px 1px 0 #f3eee2, 2px 2px 0 #d6ccb5, 3px 3px 0 #efe8d8, 4px 4px 0 #c4b99f, 0 22px 34px -16px rgba(8,10,18,0.55)")
      if src != ""
        image src alt="" width="100%" height="100%" object-fit="cover" border-radius=3
      else
        column position="absolute" inset=0 padding=round(w * 0.12) justify-content="center" align-items="center"
          text title font-family="Jost" font-weight=300 font-size=max(11, round(w * 0.1)) line-height=1.5 color="light-dark(#eeebe4, #eeebe4)" text-align="center" line-clamp=5
      view position="absolute" inset=0 border-radius=3 pointer-events="none"
        background-image="linear-gradient(90deg, rgba(0,0,0,0.28) 0%, rgba(255,255,255,0.12) 2.4%, rgba(0,0,0,0.06) 4.5%, rgba(0,0,0,0) 8%), linear-gradient(118deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 45%)"


// A voice's face: its picture, or its initial on a plain disc.
component VoiceFace
  props
    title: string
    cover: string
    size: number
  view
    if cover != ""
      image cover alt="" width=size height=size border-radius=999 object-fit="cover" flex-shrink=0
    else
      view width=size height=size border-radius=999 background-color="light-dark(#d9dce3, #d9dce3)" display="flex" align-items="center" justify-content="center" flex-shrink=0
        text (title == "" ? "·" : title.slice(0, 1).toUpperCase()) font-weight=400 font-size=round(size * 0.42) color="light-dark(#4a4f5c, #4a4f5c)"

component VoiceRow
  props
    voice: Voice
    chosen: bool
    playing: bool
    audition: action
    choose: action
  view
    row gap=16 align-items="center" padding="16px 0" border-bottom="1px solid light-dark(rgba(20,23,31,0.08), rgba(20,23,31,0.08))" testId=`voice-${voice.id}`
      VoiceFace(title=voice.title, cover=voice.cover, size=52)
      column flex=1 min-width=0 gap=3
        text voice.title font-size="1.0625rem" color="light-dark(#14171f, #14171f)" line-clamp=1 text-overflow="ellipsis"
        if voice.description != ""
          text voice.description font-size="0.875rem" color="light-dark(#626777, #626777)" line-clamp=1 text-overflow="ellipsis"
      if voice.sample != ""
        button press=audition(voice.sample) aria-label=(playing ? "Stop sample" : "Hear sample") testId=`hear-${voice.id}` class=Round backgroundMaterial="glass"
          image (playing ? "symbol:stop-fill" : "symbol:play-fill") color="light-dark(#14171f, #14171f)" width=13 height=13
      button press=choose(voice) testId=`use-${voice.id}` class=Chip height=40 padding="0 16px" min-width=64
        backgroundMaterial=(chosen ? "none" : "glass") background-color=(chosen ? "light-dark(#14171f, #14171f)" : "light-dark(rgba(20,23,31,0), rgba(20,23,31,0))")
        text (chosen ? "✓ Selected" : "Use") font-weight=500 font-size="0.875rem" color=(chosen ? "light-dark(#f4f2ec, #f4f2ec)" : "light-dark(#14171f, #14171f)")

// The search field: a lit box with a glass, that lifts on focus and shows its own working —
// a turning ring where the clear button sits, and a line sweeping along its foot.
component SearchField
  props
    value: string
    hint: string
    label: string
    id: string
    focused: bool
    busy: bool
    still: bool
    edit: action
    enter: action
    focus: action
    blur: action
    clear: action
  view
    row position="relative" align-items="center" gap=12 width="100%" box-sizing="border-box" min-height="3.375rem" padding="0 16px 0 18px"
      border-radius=999 overflow="hidden" backgroundMaterial="glass"
      box-shadow=(focused ? "0 16px 36px -16px rgba(20,24,36,0.45)" : "0 10px 26px -16px rgba(20,24,36,0.3)")
      transition="box-shadow 260ms ease"
      image "symbol:search" color=(focused ? "light-dark(#14171f, #14171f)" : "light-dark(#6b7080, #6b7080)") width="1.25rem" height="1.25rem" flex-shrink=0
      // A text field with a search keyboard: the box draws its own glass and clear button.
      input type="text" inputmode="search" enterkeyhint="search" autocomplete="off" value=value input=edit submit=enter focus=focus blur=blur placeholder=hint
        aria-label=label testId=id flex=1 min-width=0 height="100%" box-sizing="border-box" appearance="none"
        font-weight=400 font-size="1.1875rem" color="light-dark(#14171f, #14171f)" background-color="transparent"
        border="none" border-radius=0 padding=0 outline="none"
        ::placeholder
          color="light-dark(#8a8f9c, #8a8f9c)"
      if busy
        if still
          text "Searching…" font-size="0.8125rem" color="light-dark(#626777, #626777)" flex-shrink=0 testId=`${id}-busy`
        else
          view width=18 height=18 box-sizing="border-box" border-radius=999 flex-shrink=0 testId=`${id}-busy`
            border="2px solid light-dark(rgba(20,23,31,0.14), rgba(20,23,31,0.14))" border-top-color="light-dark(#14171f, #14171f)" animation="spin 700ms linear infinite"
      else if value != ""
        button press=clear appearance="none" aria-label="Clear" testId=`${id}-clear` width=28 height=28 border-radius=999 flex-shrink=0
          display="flex" align-items="center" justify-content="center" background-color="light-dark(rgba(20,23,31,0.07), rgba(20,23,31,0.07))" cursor="pointer"
          animation=(still ? "none" : "popIn 180ms ease both")
          image "symbol:close" color="light-dark(#4a4f5c, #4a4f5c)" width=10 height=10
      if busy and not still
        view position="absolute" left=0 bottom=0 width="35%" height=2 pointer-events="none"
          background-image="linear-gradient(90deg, rgba(20,23,31,0) 0%, rgba(20,23,31,0.75) 50%, rgba(20,23,31,0) 100%)"
          animation="sweep 1.1s ease-in-out infinite"

// A row still to come: the shape of a voice, breathing, each a beat after the last.
component SkeletonRow
  props
    i: number
    still: bool
  view
    row gap=18 align-items="center" padding="16px 0" border-bottom="1px solid light-dark(rgba(20,23,31,0.08), rgba(20,23,31,0.08))"
      animation=(still ? "none" : `breathe 1.3s ${i * 130}ms ease-in-out infinite`)
      view width=52 height=52 border-radius=999 background-color="light-dark(#d5d9e1, #d5d9e1)" flex-shrink=0
      column flex=1 min-width=0 gap=9
        view height=14 width=`${62 - i * 8}%` border-radius=4 background-color="light-dark(#d5d9e1, #d5d9e1)"
        view height=10 width=`${40 - i * 4}%` border-radius=4 background-color="light-dark(#dfe2e8, #dfe2e8)"

keyframes spin
  to rotate="360deg"
keyframes sweep
  from translate="-100% 0px"
  to translate="290% 0px"
keyframes breathe
  50% opacity=0.4
keyframes popIn
  from opacity=0 scale=0.6
keyframes arrive
  from opacity=0 translate="0px 40px"
keyframes inkIn
  from opacity=0 translate="0px 10px"
// The dock changing what it holds: it gathers in from below, as a glass bar does.
keyframes dockIn
  from opacity=0 scale=0.9 translate="0px 14px"
keyframes drift
  50% translate="6% -2%"

// A book lying face up in the stack: its cover, its page edges under it, a sheen of light
// on the one in focus and shade on the ones below.
component Volume
  props
    book: Great
    depth: number
    n: number
    i: number
    w: number
    h: number
    dx: number
    dy: number
    dragging: bool
  view
    view position="absolute" left=0 top=0 width=w height=h z-index=volZ(depth, n) testId=`great-${book.id}`
      translate=`${volX(depth, n, i, w) + dx}px ${volY(depth, n, h) + dy}px` rotate=`${volRot(depth, n, i) + dx * 0.05}deg`
      scale=(dragging and depth == 0 ? 1.03 : 1 - min(depth, 5) * 0.012) opacity=volOpacity(depth, n)
      transition=(dragging and depth == 0 ? "scale 200ms ease" : "translate -exact-spring(150, 20, 1), rotate -exact-spring(150, 20, 1), scale -exact-spring(150, 20, 1), opacity 650ms ease")
      border-radius=3 background-color="light-dark(#2a2d36, #2a2d36)"
      box-shadow="1px 1px 0 #f3eee2, 2px 2px 0 #ddd4bf, 3px 3px 0 #f3eee2, 4px 4px 0 #d6ccb5, 5px 5px 0 #efe8d8, 6px 6px 0 #c4b99f, 0 30px 50px -12px rgba(8,10,18,0.6)"
      image book.cover alt=(depth == 0 ? `${book.title}, ${book.author}` : "") width="100%" height="100%" object-fit="cover" border-radius=3
      view position="absolute" inset=0 border-radius=3 pointer-events="none"
        background-image="linear-gradient(90deg, rgba(0,0,0,0.30) 0%, rgba(255,255,255,0.12) 2.2%, rgba(0,0,0,0.06) 4%, rgba(0,0,0,0) 7%), linear-gradient(118deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0) 45%)"
      view position="absolute" inset=0 border-radius=3 pointer-events="none" background-color="light-dark(#0b0d14, #0b0d14)"
        opacity=(min(depth, 5) * 0.1) transition="opacity 420ms ease"
