                      text (fileName == "" ? "Or upload an EPUB, PDF or TXT" : fileName) flex=1 min-width=0 line-clamp=1 font-family="Jost" font-size=16
                        color=(fileName == "" ? "#6b7080" : "#14171f") testId="file-name"
                      button press=chooseFile appearance="none" testId="choose-file" padding="4px 0" cursor="pointer" flex-shrink=0
                        text (fileName == "" ? "Choose  →" : "Change  →") font-family="Jost" font-size=15 color="#14171f" border-bottom="1px solid rgba(20,23,31,0.3)" padding-bottom=2
                      input type="file" id="upload" display="none" change=picked testId="upload"
                  column gap=14
