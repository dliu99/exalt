                      font-family="Jost" font-size=17 color="#14171f" background-color="transparent" border="none" border-bottom="1px solid rgba(20,23,31,0.35)" border-radius=0 padding="10px 0" outline="none"
                      option "Choose a model…" value=""
                      for m in models key=m.id
