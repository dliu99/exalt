                    text "Devin Liu" font-family="Jost" font-size=13 color="#eeebe4" border-bottom="1px solid rgba(238,235,228,0.35)" padding-bottom=1
            header display="flex" align-items="center" padding=(wide ? "28px 7vw" : "18px 24px") position="absolute" top=0 left=0 right=0 z-index=5
              background-color="transparent" border-bottom="none" pointer-events="none"
              view flex=1
                link href="/" testId="wordmark" pointer-events="auto" padding="6px 0"
                  text "EXALT" font-family="Jost" font-weight=500 font-size=14 letter-spacing="0.5em" color=(lit ? "#eeebe4" : "#1b1f2b") transition="color 400ms ease"
              link href=path("home") testId="enter" padding="6px 0" pointer-events="auto"
                text "Home" font-family="Jost" font-weight=400 font-size=15 letter-spacing="0.04em" color=(lit ? "#eeebe4" : "#1b1f2b") transition="color 400ms ease"
        // Home: the painting as a faint band, then where you left off, what you made, and your voice.
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="home-scroll" position="absolute" inset=0 background-color="#eceef2" testId="home"
            scroll id="home-scroll" position="absolute" top=0 left=0 width="100%" height="100%" overflow-x="hidden" overflow-y="auto"
              view position="relative" height=(wide ? 320 : 240) overflow="hidden" flex-shrink=0
                image "assets/lander.jpg" alt="" position="absolute" top=0 left=0 width="100%" height="100%" object-fit="cover"
                view position="absolute" inset=0 background-image="linear-gradient(180deg, rgba(236,238,242,0.1) 0%, rgba(236,238,242,0.5) 55%, #eceef2 100%)"
                column position="absolute" left=0 right=0 bottom=(wide ? 36 : 24) align-items="center" padding="0 20px"
                  text (account.signedIn ? `Welcome back, ${account.name}` : "Welcome") role="heading" aria-level=1 font-family="Jost" font-weight=300
                    font-size=(wide ? 52 : 34) letter-spacing="-0.02em" color="#14171f" text-align="center" line-clamp=1 testId="home-title"
                    animation=(still ? "none" : "inkIn 800ms cubic-bezier(.2,.7,.2,1) both")
              column margin="0 auto" width="100%" max-width=1080 box-sizing="border-box" padding=(wide ? "24px 48px 96px" : "16px 20px 72px") gap=(wide ? 64 : 48)
                column gap=20
                  SectionTitle(label="Continue listening")
                  if places.length == 0
                    column gap=10 align-items="flex-start" testId="no-places"
                      text "Nothing in progress yet." font-family="Jost" font-weight=300 font-size=22 color="#14171f"
                      link href=path("explore") testId="home-explore"
                        text "Find something in Explore  →" font-family="Jost" font-size=15 color="#14171f" border-bottom="1px solid rgba(20,23,31,0.3)" padding-bottom=2
                  else
                    scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none" margin=(wide ? "0 -48px" : "0 -20px")
                      row gap=(wide ? 32 : 22) padding=(wide ? "4px 48px 18px" : "4px 20px 18px") align-items="flex-start"
                        for p in places key=p.gen
                          PlaceCard(place=p, resume=resume)
                column gap=20
                  SectionTitle(label="Your books")
                  if not account.signedIn
                    column gap=12 align-items="flex-start" max-width=320 testId="mine-signed-out"
                      text "Sign in to keep the audiobooks you make here." font-family="Jost" font-weight=300 font-size=20 color="#14171f" line-height=1.35
                      if identities.providers.google.active
                        exact-sign-in-button provider="google" press=googleSignIn testId="home-google" width="100%" height=44
                      if signInError != ""
                        text signInError color="#b2463c" font-family="Jost" font-size=14
                  else if mine.length == 0
                    text "You haven’t voiced a book yet. Choose one in Explore and make its first audiobook." font-family="Jost" font-weight=300 font-size=20 color="#14171f" line-height=1.35 max-width=520 testId="no-mine"
                  else
                    view display="grid" grid-template-columns=(wide ? "repeat(auto-fill, minmax(160px, 1fr))" : "repeat(auto-fill, minmax(130px, 1fr))") gap=(wide ? 32 : 22)
                      for m in mine key=m.gen
                        MineCard(item=m, open=openMine, w=(wide ? 150 : 120))
                column gap=20
                  SectionTitle(label="Your voice")
                  row gap=16 align-items="center" testId="your-voice"
                    VoiceFace(title=voicePref.title, cover=voicePref.cover, size=56)
                    column flex=1 min-width=0 gap=3
                      text (voicePref.id == "" ? "No voice chosen yet" : voicePref.title) font-family="Jost" font-size=18 color="#14171f" line-clamp=1 testId="voice-name"
                      text "Reads the audiobooks you make, from Fish Audio’s library." font-family="Jost" font-size=14 color="#6b7080" line-clamp=2
                    link href=path("voices") testId="change-voice" flex-shrink=0
                      text (voicePref.id == "" ? "Choose  →" : "Change  →") font-family="Jost" font-size=15 color="#14171f" border-bottom="1px solid rgba(20,23,31,0.3)" padding-bottom=2
                if listening.length > 0
                  column gap=20
                    SectionTitle(label="On Exalt")
                    view display="grid" grid-template-columns=(wide ? "repeat(auto-fill, minmax(160px, 1fr))" : "repeat(auto-fill, minmax(130px, 1fr))") gap=(wide ? 32 : 22)
                      for b in listening key=b.id
                        BookCard(book=b, w=(wide ? 150 : 120))
            TopBar(active="home", wide=wide)
        // Explore: search every book, with suggestions under the field as you type.
        if e.name == "explore"
          column navigationKey=`${e.id}` navigationScroll="explore-scroll" position="absolute" inset=0 background-color="#eceef2" testId="explore"
            scroll id="explore-scroll" position="absolute" top=0 left=0 width="100%" height="100%" overflow-x="hidden" overflow-y="auto"
              column margin="0 auto" width="100%" max-width=(asked != "" ? 760 : 1080) box-sizing="border-box" padding=(wide ? "120px 48px 96px" : "88px 20px 72px") gap=(wide ? 48 : 36)
                column gap=18 position="relative" z-index=2
                  text "Explore" role="heading" aria-level=1 font-family="Jost" font-weight=300 font-size=(wide ? 52 : 36) letter-spacing="-0.02em" color="#14171f"
                  column position="relative" width="100%" max-width=640
                    input type="search" value=query input=search submit=ask focus=fieldFocus blur=fieldBlur placeholder="A title or an author"
                      aria-label="Search Books" testId="search" width="100%" box-sizing="border-box" appearance="none"
                      font-family="Jost" font-weight=300 font-size=(wide ? 24 : 20) color="#14171f" background-color="transparent"
                      border="none" border-bottom="1px solid rgba(20,23,31,0.35)" border-radius=0 padding="10px 0" outline="none"
