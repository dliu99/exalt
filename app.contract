                      width=72 height=72 min-width=72 padding=0 flex-shrink=0 border-radius=999 display="flex" align-items="center" justify-content="center" background-color="#eeebe4" cursor="pointer"
                      box-shadow="0 14px 36px -10px rgba(0,0,0,0.6)"
                      image (held ? "symbol:play-fill" : "symbol:pause-fill") color="#14171f" width=28 height=28
                    button press=fwd30 appearance="none" aria-label="Forward 30 seconds" testId="fwd30" padding=8 cursor="pointer"
                      image "symbol:skip-forward-30" color="#eeebe4" width=28 height=28
                    view width=48
                  column gap=4 padding-top=8
                    text "CHAPTERS" font-family="Jost" font-weight=500 font-size=11 letter-spacing="0.26em" color="#9a978f" padding-bottom=8
                    for t in audiobook.tracks key=t.idx
                      button press=playTrack(t.idx) appearance="none" text-align="start" display="flex" align-items="center" gap=16 padding="12px 0"
                        border-bottom="1px solid rgba(238,235,228,0.08)" cursor="pointer" testId=`track-${t.idx}`
                        text `${t.idx + 1}` font-family="Jost" font-size=13 color="#6f6d67" width=24
                        text t.title flex=1 min-width=0 line-clamp=1 font-family="Jost" font-size=15 color=(t.idx == track ? "#eeebe4" : "#9a978f")
                        if t.idx == track
                          image "symbol:waveform" color="#eeebe4" width=16 height=16
                  text `Read by ${audiobook.model} · made by ${audiobook.by}` font-family="Jost" font-size=13 color="#6f6d67" text-align="center"
              if trackSrc(audiobook, track) != ""
                audio id="player-audio" src=trackSrc(audiobook, track) paused=held playbackRate=rate preload="auto"
                  timeupdate=tick durationchange=gotDuration loadedmetadata=resumeAt ended=nextTrack play=played pause=stopped
                  metadata=MediaMetadata(title=trackTitle(audiobook, track), artist=audiobook.author, album=audiobook.title, artwork=audiobook.cover)
                  seekbackward=back15 seekforward=fwd30 nexttrack=nextTrack previoustrack=prevTrack testId="audio"
            header display="flex" align-items="center" padding=(wide ? "24px 7vw" : "16px 20px") position="absolute" top=0 left=0 right=0 z-index=5
              appearance="none" background-color="transparent" border-bottom="none" pointer-events="none"
              button press=back appearance="none" aria-label="Back" testId="player-back" padding="6px 0" pointer-events="auto" display="flex" align-items="center" gap=8 cursor="pointer"
                image "symbol:back" color="#eeebe4" width=18 height=18
              view flex=1
              text "EXALT" font-family="Jost" font-weight=500 font-size=13 letter-spacing="0.5em" color="#6f6d67"

component TopBar
  props
    active: string
    wide: bool
  view
    header display="flex" align-items="center" gap=(wide ? 30 : 20) padding=(wide ? "22px 7vw" : "14px 20px") position="absolute" top=0 left=0 right=0 z-index=5
      appearance="none" background-color="rgba(236,238,242,0.72)" backdrop-filter="blur(14px)" border-bottom="1px solid rgba(20,23,31,0.06)"
      link href=path("lander") testId="nav-exalt"
        text "EXALT" font-family="Jost" font-weight=500 font-size=14 letter-spacing="0.5em" color="#14171f"
      view flex=1
      link href=path("home") testId="nav-home" padding="4px 0"
        text "Home" font-family="Jost" font-size=15 color=(active == "home" ? "#14171f" : "#6b7080")
          border-bottom=(active == "home" ? "1px solid #14171f" : "1px solid transparent") padding-bottom=2
      link href=path("explore") testId="nav-explore" padding="4px 0"
        text "Explore" font-family="Jost" font-size=15 color=(active == "explore" ? "#14171f" : "#6b7080")
          border-bottom=(active == "explore" ? "1px solid #14171f" : "1px solid transparent") padding-bottom=2

component SectionTitle
  props
    label: string
  view
    text label.toUpperCase() role="heading" aria-level=2 font-family="Jost" font-weight=500 font-size=11 letter-spacing="0.26em" color="#6b7080"

// A cover as a book: page edges under it and light along the spine. Without art, its title on cloth.
component BookCover
  props
    src: string
    title: string
    w: number
  view
    view position="relative" width=w height=round(w * 1.5) flex-shrink=0 border-radius=3 background-color="#2a2d36"
      box-shadow="1px 1px 0 #f3eee2, 2px 2px 0 #d6ccb5, 3px 3px 0 #efe8d8, 4px 4px 0 #c4b99f, 0 22px 34px -16px rgba(8,10,18,0.55)"
      if src != ""
        image src alt="" width="100%" height="100%" object-fit="cover" border-radius=3
      else
        column position="absolute" inset=0 padding=round(w * 0.12) justify-content="center" align-items="center"
          text title font-family="Jost" font-weight=300 font-size=max(11, round(w * 0.1)) line-height=1.2 color="#eeebe4" text-align="center" line-clamp=5
      view position="absolute" inset=0 border-radius=3 pointer-events="none"
        background-image="linear-gradient(90deg, rgba(0,0,0,0.28) 0%, rgba(255,255,255,0.12) 2.4%, rgba(0,0,0,0.06) 4.5%, rgba(0,0,0,0) 8%), linear-gradient(118deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 45%)"

component BookCard
  props
    book: Book
    w: number
  view
    link href=path("book", book.id) testId=`book-${book.id}`
      column gap=10
        BookCover(src=book.cover, title=book.title, w=w)
        column gap=2
          text book.title font-family="Jost" font-size=15 color="#14171f" line-clamp=2
          text book.author font-family="Jost" font-size=13 color="#6b7080" line-clamp=1
          if book.versions > 0
            text versionsText(book.versions) font-family="Jost" font-size=12 color="#4a4f5c"

component PlaceCard
  props
    place: Place
    resume: action
  view
    button press=resume(place) appearance="none" padding=0 text-align="start" cursor="pointer" flex-shrink=0 width=150 testId=`place-${place.gen}`
      column gap=10
        BookCover(src=place.cover, title=place.title, w=140)
        column gap=4
          text place.title font-family="Jost" font-size=15 color="#14171f" line-clamp=1
          text `Chapter ${place.track + 1} of ${place.tracks}` font-family="Jost" font-size=13 color="#6b7080"
          view height=2 width=140 background-color="rgba(20,23,31,0.12)" border-radius=1 margin-top=4
            view height=2 width=`${round(placeFrac(place) * 100)}%` background-color="#14171f" border-radius=1

component MineCard
  props
    item: Mine
    open: action
    w: number
  view
    button press=open(item) appearance="none" padding=0 text-align="start" cursor="pointer" testId=`mine-${item.gen}`
      column gap=10
        view position="relative" width=w
          BookCover(src=item.cover, title=item.title, w=w)
          if item.status != "ready"
            view position="absolute" inset=0 border-radius=3 background-color="rgba(18,20,25,0.45)"
        column gap=2
          text item.title font-family="Jost" font-size=15 color="#14171f" line-clamp=2
          text mineText(item) font-family="Jost" font-size=13 color=(item.status == "failed" ? "#b2463c" : "#6b7080")

component ResultRow
  props
    book: Book
  view
    link href=path("book", book.id) testId=`book-${book.id}`
      row gap=18 align-items="center" padding="14px 0" border-bottom="1px solid rgba(20,23,31,0.08)"
        BookCover(src=book.cover, title=book.title, w=48)
        column flex=1 min-width=0 gap=3
          text book.title font-family="Jost" font-size=18 color="#14171f" line-clamp=1
          text byline(book) font-family="Jost" font-size=14 color="#6b7080" line-clamp=1
          if book.versions > 0
            text versionsText(book.versions) font-family="Jost" font-size=13 color="#4a4f5c"
        text "→" font-family="Jost" font-size=18 color="#9a9eab"

component SuggestionRow
  props
    book: Book
  view
    link href=path("book", book.id) role="option" testId=`suggest-${book.id}` padding="8px 14px"
      row gap=12 align-items="center" flex=1 min-width=0
        BookCover(src=book.cover, title=book.title, w=28)
        column flex=1 min-width=0 gap=1
          text book.title font-family="Jost" font-size=15 color="#14171f" line-clamp=1
          text byline(book) font-family="Jost" font-size=13 color="#6b7080" line-clamp=1

component VersionRow
  props
    version: Version
    listen: action
  view
    if version.status == "ready"
      button press=listen(version.id) appearance="none" text-align="start" display="flex" align-items="center" gap=16 padding="16px 0"
        border-bottom="1px solid rgba(20,23,31,0.08)" cursor="pointer" testId=`version-${version.id}`
        view width=40 height=40 border-radius=999 display="flex" align-items="center" justify-content="center" background-color="#14171f" flex-shrink=0
          image "symbol:play-fill" color="#f4f2ec" width=14 height=14
        column flex=1 min-width=0 gap=2
          text `Read by ${readBy(version)}` font-family="Jost" font-size=16 color="#14171f" line-clamp=1
          text `${version.by} · ${statusText(version)}` font-family="Jost" font-size=13 color="#6b7080"
    else
      row testId=`version-${version.id}` align-items="center" gap=16 padding="16px 0" border-bottom="1px solid rgba(20,23,31,0.08)"
        view width=40 height=40 display="flex" align-items="center" justify-content="center" flex-shrink=0
          if version.status != "failed"
            progress aria-label="Making"
        column flex=1 min-width=0 gap=2
          text `Read by ${readBy(version)}` font-family="Jost" font-size=16 color="#14171f" line-clamp=1
          text statusText(version) font-family="Jost" font-size=13 color=(version.status == "failed" ? "#b2463c" : "#6b7080") testId=`status-${version.id}`

// A voice's face: its picture, or its initial on a plain disc.
component VoiceFace
  props
    title: string
    cover: string
    size: number
  view
    if cover != ""
      image cover alt="" width=size height=size border-radius=999 object-fit="cover" flex-shrink=0
    else
      view width=size height=size border-radius=999 background-color="#d9dce3" display="flex" align-items="center" justify-content="center" flex-shrink=0
        text (title == "" ? "·" : title.slice(0, 1).toUpperCase()) font-family="Jost" font-weight=300 font-size=round(size * 0.42) color="#4a4f5c"

component VoiceRow
  props
    voice: Voice
    chosen: bool
    playing: bool
    audition: action
    choose: action
  view
    row gap=16 align-items="center" padding="16px 0" border-bottom="1px solid rgba(20,23,31,0.08)" testId=`voice-${voice.id}`
      VoiceFace(title=voice.title, cover=voice.cover, size=52)
      column flex=1 min-width=0 gap=3
        text voice.title font-family="Jost" font-size=17 color="#14171f" line-clamp=1
        if voice.description != ""
          text voice.description font-family="Jost" font-size=14 line-height=1.45 color="#6b7080" line-clamp=2
      if voice.sample != ""
        button press=audition(voice.sample) appearance="none" aria-label=(playing ? "Stop sample" : "Hear sample") testId=`hear-${voice.id}`
          width=40 height=40 border-radius=999 display="flex" align-items="center" justify-content="center" border="1px solid rgba(20,23,31,0.25)" cursor="pointer" flex-shrink=0
          image (playing ? "symbol:stop-fill" : "symbol:play-fill") color="#14171f" width=12 height=12
      row width=88 justify-content="flex-end" flex-shrink=0
        button press=choose(voice) appearance="none" testId=`use-${voice.id}` padding="4px 0" cursor="pointer"
          text (chosen ? "✓ Selected" : "Use") font-family="Jost" font-weight=(chosen ? 500 : 400) font-size=15 color="#14171f"
            border-bottom=(chosen ? "1px solid transparent" : "1px solid rgba(20,23,31,0.3)") padding-bottom=2

keyframes arrive
  from opacity=0 translate="0px 40px"
keyframes inkIn
  from opacity=0 translate="0px 10px"
keyframes drift
  50% translate="6% -2%"

// A book lying face up in the stack: its cover, its page edges under it, a sheen of light
// on the one in focus and shade on the ones below.
component Volume
  props
    book: Great
    depth: number
    n: number
    i: number
    w: number
    h: number
    dx: number
    dy: number
    dragging: bool
  view
    view position="absolute" left=0 top=0 width=w height=h z-index=volZ(depth, n) testId=`great-${book.id}`
      translate=`${volX(depth, n, i, w) + dx}px ${volY(depth, n, h) + dy}px` rotate=`${volRot(depth, n, i) + dx * 0.05}deg`
      scale=(dragging and depth == 0 ? 1.03 : 1 - min(depth, 5) * 0.012) opacity=volOpacity(depth, n)
      transition=(dragging and depth == 0 ? "scale 200ms ease" : "translate -exact-spring(150, 20, 1), rotate -exact-spring(150, 20, 1), scale -exact-spring(150, 20, 1), opacity 650ms ease")
      border-radius=3 background-color="#2a2d36"
      box-shadow="1px 1px 0 #f3eee2, 2px 2px 0 #ddd4bf, 3px 3px 0 #f3eee2, 4px 4px 0 #d6ccb5, 5px 5px 0 #efe8d8, 6px 6px 0 #c4b99f, 0 30px 50px -12px rgba(8,10,18,0.6)"
      image book.cover alt=(depth == 0 ? `${book.title}, ${book.author}` : "") width="100%" height="100%" object-fit="cover" border-radius=3
      view position="absolute" inset=0 border-radius=3 pointer-events="none"
        background-image="linear-gradient(90deg, rgba(0,0,0,0.30) 0%, rgba(255,255,255,0.12) 2.2%, rgba(0,0,0,0.06) 4%, rgba(0,0,0,0) 7%), linear-gradient(118deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0) 45%)"
      view position="absolute" inset=0 border-radius=3 pointer-events="none" background-color="#0b0d14"
        opacity=(min(depth, 5) * 0.1) transition="opacity 420ms ease"
