// Exalt: audiobooks of your own books. A signed-in person imports an EPUB, PDF or TXT, the server
// narrates it, and it joins their library, shared in the public Browse feed unless they keep it
// private. app.ts asks server/index.ts for all of it. On the site anyone can listen to what is
// shared; importing needs an account.
use EmptyState from "exact:content"
use getIdentityCapabilities, IdentityCapabilities from "@exact/sign-in"
use getClientCapabilities, ClientCapabilities from "@exact/passkeys"

// The lander's face: Jost (SIL Open Font License), cut to static weights.
font "Jost"
  300 = "assets/fonts/Jost-Light.ttf"
  300 italic = "assets/fonts/Jost-LightItalic.ttf"
  400 = "assets/fonts/Jost-Regular.ttf"
  500 = "assets/fonts/Jost-Medium.ttf"

routes nav
  lander "/"
    home "/home"
      add "/import"
      browse "/browse"
      voices "/voices"
      play "/play/:gen"

shape Model
  id: string
  name: string
  voices: string[]

shape Track
  idx: number
  title: string
  src: string

// One audiobook to play.
shape Audiobook
  id: string
  title: string
  author: string
  cover: string
  by: string
  voice: string
  public: bool
  status: string
  done: number
  total: number
  error: string
  tracks: Track[]

shape Reply
  ok: bool
  error: string

shape Account
  signedIn: bool
  name: string

// Where the listener left off in an audiobook (on this device, and the account's).
shape Place
  gen: string
  title: string
  author: string
  cover: string
  track: number
  tracks: number
  time: number
  duration: number
  at: number

// An audiobook in the signed-in person's library, finished or not.
shape Mine
  id: string
  title: string
  author: string
  cover: string
  status: string
  done: number
  total: number
  error: string
  public: bool
  voice: string

// A finished audiobook someone shared, in Browse.
shape Shared
  id: string
  title: string
  author: string
  cover: string
  by: string
  voice: string
  chapters: number

// A voice from Fish Audio's library (read through OpenRouter's Fish models), and the listener's choice.
shape Voice
  id: string
  title: string
  description: string
  cover: string
  sample: string
  languages: string
  uses: number

shape VoicePref
  id: string
  title: string
  cover: string

// One of the lander's great books: its Penguin cover ships in assets/covers.
shape Great
  id: string
  title: string
  author: string
  cover: string

shape Time
  epochAtZero: number
  utcOffset: number

shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool

// The lander's stack. A book's depth is how far below the top it lies (0 is the one in focus);
// the last depth is the book just turned away, thrown off to the left, so going back brings it
// down onto the top again. The rest settle under the top at a slant of their own.
fn depthOf(i: number, cur: number, n: number): number = (i - cur + n) % n
fn gone(d: number, n: number): bool = d == n - 1 and n > 1
fn slant(i: number): number = ((i * 47) % 13 - 6) * 0.85
fn volX(d: number, n: number, i: number, w: number): number = gone(d, n) ? -w * 2.1 : d == 0 ? 0 : ((i * 29) % 9 - 4) * 4
fn volY(d: number, n: number, h: number): number = gone(d, n) ? -h * 0.12 : min(d, 5) * 8
fn volRot(d: number, n: number, i: number): number = gone(d, n) ? -26 : d == 0 ? slant(i) * 0.2 : slant(i)
fn volOpacity(d: number, n: number): number = gone(d, n) ? 0 : d > 5 ? 0 : 1
fn volZ(d: number, n: number): number = gone(d, n) ? n + 1 : n - d
fn mag(x: number): number = max(x, -x)

fn two(n: number): string = n < 10 ? `0${n}` : `${n}`
fn clock(s: number): string = s >= 3600 ? `${floor(s / 3600)}:${two(floor(s / 60) % 60)}:${two(floor(s) % 60)}` : `${floor(max(0, s) / 60)}:${two(floor(max(0, s)) % 60)}`
fn nextRate(r: number): number = r == 1 ? 1.25 : r == 1.25 ? 1.5 : r == 1.5 ? 2 : r == 2 ? 0.75 : 1
fn rateText(r: number): string = r == 1 ? "1×" : r == 1.25 ? "1.25×" : r == 1.5 ? "1.5×" : r == 2 ? "2×" : "0.75×"
fn trackTitle(a: Audiobook, i: number): string = match a.tracks.at(i) { case some(t) => t.title, case none => "" }
fn trackSrc(a: Audiobook, i: number): string = match a.tracks.at(i) { case some(t) => t.src, case none => "" }
// A library row's one quiet line: how the narration goes, or where the listener is.
fn chaptersText(n: number): string = `${n} ${n == 1 ? "chapter" : "chapters"}`
fn spanText(s: number): string = s >= 3600 ? `${floor(s / 3600)}h ${round((s % 3600) / 60)}m` : `${max(1, round(s / 60))}m`
// What is left, the chapters still to come taken to run as long as this one.
fn leftOf(p: Place): number = max(0, p.duration - p.time) + (p.tracks - p.track - 1) * p.duration
fn placeText(p: Place): string = p.duration > 0 ? `Chapter ${p.track + 1} of ${p.tracks} · ${spanText(leftOf(p))} left` : `Chapter ${p.track + 1} of ${p.tracks}`
fn workText(m: Mine): string = m.status == "queued" ? "Waiting…" : m.status == "failed" ? (m.error == "" ? "Didn’t finish" : `Didn’t finish: ${m.error}`) : m.total == 0 ? "Preparing…" : `Narrating ${m.done} of ${m.total}…`
fn statusOf(m: Mine, ps: Place[]): string = m.status != "ready" ? workText(m) : match first(ps.filter(p => p.gen == m.id)) { case some(p) => placeText(p), case none => `Ready · ${chaptersText(m.total)}` }
fn readBy(voice: string, by: string): string = voice == "" ? by : `Read by ${voice} · ${by}`

component App
  state track = 0
  // The lander: a hero over the painting, and a stack of books lying across the fold. Scrolling
  // fades the painting out and brings the stack into focus, one book at a time.
  resource greats = loadGreats() as shape Great[] else empty()
  resource viewport = exactViewport() as shape Viewport
  state cur = 0
  state dragX = 0
  state dragY = 0
  state dragging = false
  state moved = false
  state scrollY = 0
  // A drag far enough to turn the book is felt as it crosses the line.
  state armed = false
  derive n = greats.length
  derive wide = viewport.width >= 820
  // A phone gets the dock: the tabs and the book in progress, floating on glass over every main screen.
  derive docked = not wide and (top(nav).name == "home" or (top(nav).name == "browse" and not browseTyping) or (top(nav).name == "voices" and not fromImport))
  // Voices opened from the import sheet goes back to it, rather than off to the tabs.
  derive fromImport = stack(nav).filter(e => e.name == "add").length > 0
  derive coverH = round(min(viewport.height * (wide ? (gated ? 0.42 : 0.46) : gated ? 0.45 : 0.4), 440))
  derive coverW = min(round(coverH / 1.55), round(viewport.width * 0.66))
  derive focused = greats.slice(cur, cur + 1)
  derive still = viewport.prefersReducedMotion
  // 0 with the painting in full, 1 once it has scrolled most of the way off.
  derive fade = min(1, max(0, scrollY / max(1, viewport.height * 0.6)))
  derive lit = fade > 0.5
  // The painting covers the screen. On a narrow one it is drawn a little taller and slides
  // so the wanderer stands at the right, under the book's name.
  derive paintH = wide ? max(viewport.height, viewport.width / 1.777) : viewport.height * 1.15
  derive paintW = paintH * 1.777
  derive paintLeft = wide ? (viewport.width - paintW) / 2 : max(viewport.width - paintW, min(0, viewport.width * 0.86 - paintW * 0.83))
  // The app opens on signing in; the site lets anyone through to listen.
  resource app = isApp() as shape Reply else empty(ok=false, error="")
  // The door: where the server keeps accounts, nothing opens without signing in, on the site as in the app.
  resource door = accountRequired() as shape Reply else empty(ok=true, error="")
  derive gated = door.ok and not account.signedIn and identities.providers.google.active
  // On a phone the door is a plain screen of its own: no painting, no wordmark.
  derive phoneDoor = gated and not wide
  // The account: the provider's buttons sign in, with a nonce fetched before the press.
  resource account = currentAccount() as shape Account else empty(signedIn=false, name="")
  resource identities = getIdentityCapabilities() as shape IdentityCapabilities
  mutation nonce as shape Reply
  mutation signedIn as shape Reply refreshes account, library, places
  mutation left as shape Reply refreshes account, library, places
  derive signInError = match signedIn { case some(r) => r.error, case none => "" }

  // Library: the person's audiobooks, newest first, and where they are in each.
  resource library = loadLibrary() as shape Mine[] else empty()
  resource places = loadPlaces() as shape Place[] else empty()
  resource time = exactTime() as shape Time
  mutation placed as shape Reply refreshes places
  // A row's long-press menu and alerts act on the row they came from.
  state aimed = ""
  state renameTitle = ""
  state changeMessage = ""
  mutation shared as shape Reply refreshes library, browse then afterShared
  mutation renamed as shape Reply refreshes library, browse, places then afterRenamed
  mutation removed as shape Reply refreshes library, browse, places then afterRemoved
  derive aimedPublic = library.filter(m => m.id == aimed and m.public).length > 0
  derive aimedTitle = match first(library.filter(m => m.id == aimed)) { case some(m) => m.title, case none => "" }
  derive working = library.filter(m => m.status == "queued" or m.status == "working").length > 0

  // Import: a file, its title and author if the file's are wrong, a voice, and whether to share it.
  resource models = loadModels() as shape Model[] else empty()
  resource voicePref = loadVoicePref() as shape VoicePref else empty(id="", title="", cover="")
  state filePath = ""
  state fileName = ""
  state importTitle = ""
  state importAuthor = ""
  state model = ""
  state voice = ""
  state share = true
  state rights = false
  state refusal = ""
  mutation imported as shape Reply refreshes library then afterImport
  // The model in effect: the one chosen, or the first until one is.
  derive chosenModel = model != "" ? model : match first(models) { case some(m) => m.id, case none => "" }
  derive fishModel = chosenModel.startsWith("fish-audio/")
  derive voices = match first(models.filter(m => m.id == chosenModel)) { case some(m) => m.voices, case none => [] }
  derive importError = match imported { case some(r) => r.error, case none => "" }
  // Why Narrate waits, the first thing missing; nothing once it can go.
  derive importHint = pending(imported) ? "Uploading…" : not account.signedIn ? "Sign in to narrate." : fileName == "" ? "Choose an EPUB, PDF or TXT file." : chosenModel == "" ? "Choose a voice." : share and not rights ? "Confirm you have the right to share this book, or keep it private." : ""
  derive canImport = importHint == ""

  // Browse: what everyone has shared, narrowed by title or author as you type.
  state browseQuery = ""
  // While the search field has the keyboard, the dock steps aside.
  state browseTyping = false
  state browseAsked = ""
  resource browse = loadBrowse(browseAsked) as shape Shared[] else empty()
  derive browseBusy = browseQuery.trim() != browseAsked or pending(browse)

  // Voices.
  mutation prefSet as shape Reply refreshes voicePref
  state voiceQuery = ""
  state voiceAsked = ""
  state voiceOn = false
  resource voiceList = loadVoices(voiceAsked) as shape Voice[] else empty()
  state auditioning = ""
  derive voiceBusy = voiceQuery.trim() != voiceAsked or pending(voiceList)

  // The player: paused or not, where it is, how long the chapter is, how fast it reads.
  resource audiobook = loadAudiobook(genId) as shape Audiobook else empty()
  state held = true
  state now = 0
  state duration = 0
  state rate = 1
  state resumeTime = 0
  derive genId = match stack(nav).filter(e => e.name == "play").at(-1) { case some(e) => e.params.gen, case none => "" }
  derive playerCover = wide ? min(240, round(viewport.height * 0.28)) : min(220, round(viewport.width * 0.56))

  // While playing, the place is kept every so often (and at every pause and chapter's end).
  task keeping when top(nav).name == "play" and not held
    every(15000, keepPlace)
  task voiceSearching when voiceQuery.trim() != voiceAsked key=voiceQuery
    after(300, takeVoiceQuery)
  task browseSearching when browseQuery.trim() != browseAsked key=browseQuery
    after(300, takeBrowseQuery)

  // A drag's end can be followed by a click on the stack; it is spent a moment later either way.
  task settling when moved and not dragging
    after(250, clearMoved)

  // While a book is being narrated, the library follows the progress.
  task poll mount
    every(3000, pull)

  task prepareIdentity mount
    after(1, getNonce)
  // In the app, signing in opens the library, and signing out comes back to the door.
  task entering when app.ok and account.signedIn and top(nav).name == "lander"
    after(1, enter)
  // The site bars only what needs an account; anyone can listen to what is shared.
  task barring when gated and top(nav).name != "lander" and (app.ok or top(nav).name == "home" or top(nav).name == "add")
    after(1, toDoor)

  action getNonce
    send nonce = identityNonce()
  action googleSignIn
    send signedIn = signInWith("google")
  action appleSignIn
    send signedIn = signInWith("apple")
  action signOut
    send left = signOut()
    // A sheet still up is for the session that is ending: its answer is dropped.
    send signedIn = idle()
  // A session the server dropped shows as signed out (app.ts forgets it), so the account follows.
  action pull
    if account.signedIn
      refresh account
    if working
      refresh library
      refresh browse
  action retryLibrary
    refresh library
    refresh account
  action back
    if top(nav).name == "play"
      keepPlace()
    nav = back(nav)
  action next
    if n > 0
      cur = (cur + 1) % n
      haptic("selection")
  action prev
    if n > 0
      cur = (cur + n - 1) % n
  // On the lander, ← and → turn the stack.
  action keyed(key: string)
    if top(nav).name == "lander"
      if key == "ArrowRight"
        next()
      else if key == "ArrowLeft"
        prev()
  // A tap throws the top book aside; one that ends a drag does not.
  action tapBook
    if moved
      moved = false
    else
      next()
  action dragBook(dx: number, dy: number)
    dragging = true
    dragX = dx
    dragY = dy
    moved = moved or max(mag(dx), mag(dy)) > 6
    let over = mag(dx) > 70
    if over and not armed
      haptic("impact-light")
    armed = over
  // A throw to the left turns to the next book, to the right back to the last; a short one settles.
  action dropBook(vx: number, vy: number)
    if n > 0 and (dragX < -70 or vx < -600)
      cur = (cur + 1) % n
    else if n > 0 and (dragX > 70 or vx > 600)
      cur = (cur + n - 1) % n
    dragging = false
    armed = false
    dragX = 0
    dragY = 0
  action clearMoved
    moved = false
  action scrolled(x: number, y: number)
    scrollY = y
  action enter
    // The app's sign-in sheet, if it is still up.
    if app.ok
      close("door-sheet")
    if top(nav).name == "lander"
      nav = push(nav, path("home"))
  action toDoor
    nav = go(nav, path("lander"))
  // A book on the stack opens Browse, narrowed to its title.
  action seek(g: Great)
    browseQuery = g.title
    browseAsked = g.title
    nav = go(nav, path("browse"))
  action follow(url: string)
    nav = go(nav, url)

  // Import. A draft is kept until it is narrated, so a trip to Voices doesn't lose it.
  action openImport
    refusal = ""
    nav = push(nav, path("add"))
  action chooseFile
    showPicker("upload")
  action picked(files: Picked[])
    filePath = match first(files) { case some(f) => f.path, case none => filePath }
    fileName = match first(files) { case some(f) => f.name, case none => fileName }
    refusal = ""
  action editTitle(v: string)
    importTitle = v
  action editAuthor(v: string)
    importAuthor = v
  action pickModel(v: string)
    model = v
    voice = ""
  action editVoice(v: string)
    voice = v
  action setShare(on: bool)
    share = on
  action setRights(on: bool)
    rights = on
  action narrate
    if canImport
      send imported = importBook(filePath, fileName, chosenModel, fishModel ? voicePref.id : voice, fishModel ? voicePref.title : voice, importTitle.trim(), importAuthor.trim(), share, share and rights)
  action afterImport
    refusal = importError
    haptic(importError == "" ? "success" : "error")
    if importError == ""
      filePath = ""
      fileName = ""
      importTitle = ""
      importAuthor = ""
      share = true
      rights = false
      if top(nav).name == "add"
        nav = back(nav)

  // Library rows: tap a finished one to listen, long-press for its menu, swipe to delete.
  action openMine(m: Mine)
    if m.status == "ready"
      listen(m.id)
  action aim(id: string)
    aimed = id
  action askRemove(id: string)
    aimed = id
    showModal("remove-alert")
  action remove
    send removed = deleteAudiobook(aimed)
  // Sharing asks the person to confirm the right to share; keeping private asks nothing.
  action toggleShare
    if aimedPublic
      send shared = setSharing(aimed, false, false)
    else
      showModal("share-alert")
  action shareAimed
    send shared = setSharing(aimed, true, true)
  action askRename
    renameTitle = aimedTitle
    showModal("rename-alert")
  action editRenameTitle(v: string)
    renameTitle = v
  action rename
    if renameTitle.trim() != ""
      send renamed = renameAudiobook(aimed, renameTitle.trim())
  action afterShared
    refused(match shared { case some(r) => r.error, case none => "" })
  action afterRenamed
    refused(match renamed { case some(r) => r.error, case none => "" })
  action afterRemoved
    refused(match removed { case some(r) => r.error, case none => "" })
  // A change the server refused says why, in an alert.
  action refused(message: string)
    if message != ""
      changeMessage = message
      haptic("error")
      showModal("change-alert")

  // Browse.
  action browseFocus
    browseTyping = true
  action browseBlur
    browseTyping = false
  action editBrowseQuery(v: string)
    browseQuery = v
  action takeBrowseQuery
    browseAsked = browseQuery.trim()

  // Listening picks up where the listener left off, if they have been here before.
  action listen(id: string)
    track = match first(places.filter(p => p.gen == id)) { case some(p) => p.track, case none => 0 }
    resumeTime = match first(places.filter(p => p.gen == id)) { case some(p) => p.time, case none => 0 }
    now = 0
    duration = 0
    held = false
    nav = push(nav, path("play", id))
  action resume(p: Place)
    listen(p.gen)
  action playTrack(i: number)
    haptic("selection")
    track = i
    now = 0
    duration = 0
    held = false
  action nextTrack
    let following = track + 1
    if following < audiobook.tracks.length
      // A chapter's end pauses the element first (HTML fires `pause` before `ended`): play on.
      track = following
      now = 0
      duration = 0
      held = false
      keepAt(following, 0, 0)
    else
      held = true
      keepPlace()
  action prevTrack
    if now > 5 or track == 0
      fastSeek("player-audio", 0)
    else
      track = track - 1
      now = 0
      duration = 0
  action keepPlace
    keepAt(track, now, duration)
  action keepAt(tr: number, t: number, d: number)
    if audiobook.id != "" and audiobook.id == genId
      send placed = savePlace(audiobook.id, audiobook.title, audiobook.author, audiobook.cover, tr, audiobook.tracks.length, t, d, time.epochAtZero + performanceNow())
  action tick(t: number)
    now = t
  action gotDuration(d: number)
    duration = d
  action resumeAt
    if resumeTime > 0
      fastSeek("player-audio", resumeTime)
      resumeTime = 0
  action scrub(v: number)
    now = v
    fastSeek("player-audio", v)
  action toggle
    held = not held
  action played
    held = false
  action stopped
    held = true
    keepPlace()
  action back15
    fastSeek("player-audio", max(0, now - 15))
  action fwd30
    fastSeek("player-audio", min(max(0, duration - 1), now + 30))
  action cycleRate
    rate = nextRate(rate)
    haptic("selection")
  // Voices: browse or search Fish Audio's community library, hear a sample, choose one.
  action editVoiceQuery(v: string)
    voiceQuery = v
  action takeVoiceQuery
    voiceAsked = voiceQuery.trim()
  action clearVoiceQuery
    voiceQuery = ""
    voiceAsked = ""
  action voiceFocus
    voiceOn = true
  action voiceBlur
    voiceOn = false
  action audition(src: string)
    auditioning = auditioning == src ? "" : src
  action auditionEnded
    auditioning = ""
  action chooseVoice(v: Voice)
    haptic("success")
    send prefSet = setVoicePref(v.id, v.title, v.cover)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow key=keyed testId="app" width="100%" height="100%" viewport-fit="cover" color-scheme="light" accent-color="light-dark(#14171f, #14171f)"
      for e in stack(nav) key=e.id
        if e.name == "lander"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 overflow="hidden" background-color=(phoneDoor ? "light-dark(#eceef2, #eceef2)" : "light-dark(#121419, #121419)") testId="lander"
            status-bar-style=(lit ? "light-content" : "dark-content") status-bar-animation="fade"
            background-image="radial-gradient(ellipse closest-side at 50% 45%, rgba(120,128,150,0.16) 0%, rgba(120,128,150,0) 100%)"
            // The painting, behind everything, fading out and drifting up as the page scrolls.
            view position="absolute" inset=0 pointer-events="none" opacity=(1 - fade) overflow="hidden" display=(phoneDoor ? "none" : "flex")
              image "assets/lander.jpg" alt="" position="absolute" top=0 left=paintLeft width=paintW height=paintH
                translate=`0px ${round(-scrollY * 0.25)}px`
              view position="absolute" inset=0
                background-image=(wide ? "linear-gradient(100deg, rgba(240,240,244,0.55) 0%, rgba(240,240,244,0.18) 38%, rgba(240,240,244,0) 60%)" : "linear-gradient(180deg, rgba(240,240,244,0.5) 0%, rgba(240,240,244,0.15) 45%, rgba(240,240,244,0) 70%)")
              // Fog drifting along the fold, out of which the books rise.
              view position="absolute" left="-15%" right="-15%" bottom=0 height="45%" opacity=0.7
                animation=(still ? "none" : "drift 26s ease-in-out infinite")
                view position="absolute" left="0%" bottom="-35%" width="55%" height="90%"
                  background-image="radial-gradient(ellipse closest-side, rgba(250,250,252,0.9) 0%, rgba(250,250,252,0) 100%)"
                view position="absolute" left="40%" bottom="-45%" width="60%" height="95%"
                  background-image="radial-gradient(ellipse closest-side, rgba(250,250,252,0.85) 0%, rgba(250,250,252,0) 100%)"
            // On a phone the door is its own screen: the painting, the line, and one glass button.
            if phoneDoor
              column position="absolute" inset=0 box-sizing="border-box" justify-content="space-between" testId="door"
                padding="calc(env(safe-area-inset-top) + 40px) 20px calc(env(safe-area-inset-bottom) + 20px)"
                // The books are the screen: one line in the sky, and the stack, large, to tap or throw through.
                column align-items="center" gap=34 flex=1 justify-content="center" padding-bottom=20 font-size="min(-exact-body, 22px)"
                  text "Give great words a voice" role="heading" aria-level=1 font-family="Jost" font-weight=300 font-size="1.75em" letter-spacing="-0.01em" color="light-dark(#1b1f2b, #1b1f2b)" text-align="center"
                    animation=(still ? "none" : "inkIn 1.1s 0.15s cubic-bezier(.2,.7,.2,1) both") testId="hero-title"
                  button press=tapBook aria-label="Next book" testId="stack" appearance="none" position="relative"
                    width=coverW height=coverH flex-shrink=0 touch-action="pan-y" pan=dragBook panrelease=dropBook cursor="grab"
                    animation=(still ? "none" : "arrive 1.2s 0.1s cubic-bezier(.2,.7,.2,1) both")
                    for g, i in greats key=g.id
                      Volume(book=g, depth=depthOf(i, cur, n), n=n, i=i, w=coverW, h=coverH,
                        dx=(depthOf(i, cur, n) == 0 ? dragX : 0), dy=(depthOf(i, cur, n) == 0 ? dragY : 0), dragging=dragging)
                column gap=12 align-items="stretch" animation=(still ? "none" : "arrive 1s 0.45s cubic-bezier(.2,.7,.2,1) both")
                  if signInError != ""
                    text signInError color="light-dark(#7a241c, #7a241c)" font-family="Jost" font-size="0.875rem" text-align="center" testId="door-error"
                  // The site needs Exact's button (it holds the popup at the press); the app's is its own, on glass,
                  // and opens a sheet of the providers' own buttons: Apple's, then Google's.
                  if app.ok
                    button commandfor="door-sheet" command="show-modal" testId="door-start" class=Chip height=58 border-radius=18 backgroundMaterial="glass" box-shadow="0 18px 40px -18px rgba(20,24,36,0.45)" -exact-press-haptic="impact-medium"
                      text "Get started" font-family="system-ui" font-weight=600 font-size="1.0625rem" color="light-dark(#14171f, #14171f)"
                    // A half sheet as tall as its content: Apple's own button (never drawn by hand), then Google's.
                    dialog id="door-sheet" aria-label="Log in or sign up" testId="door-sheet"
                      column gap=12 align-items="stretch" width=viewport.width box-sizing="border-box" padding="32px 20px calc(env(safe-area-inset-bottom) + 20px)"
                        text "Log in or sign up" role="heading" aria-level=2 font-family="system-ui" font-weight=700 font-size="1.625rem" text-align="center" color="light-dark(#14171f, #14171f)" margin-bottom=20
                        exact-sign-in-button provider="apple" press=appleSignIn testId="sheet-apple" width="100%" height=56
                        button press=googleSignIn aria-label="Continue with Google" testId="sheet-google" class=Chip width="100%" height=56 border-radius=16 background-color="light-dark(#fff, #fff)" border="1px solid light-dark(#d6d8de, #d6d8de)" gap=10 -exact-press-haptic="impact-light"
                          svg viewBox="0 0 48 48" width=19 height=19 aria-hidden="true"
                            path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
                            path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
                            path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
                            path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
                          text "Continue with Google" font-family="system-ui" font-weight=600 font-size="1.0625rem" color="light-dark(#14171f, #14171f)"
                        if signInError != ""
                          text signInError color="light-dark(#7a241c, #7a241c)" font-family="system-ui" font-size="0.875rem" text-align="center" testId="sheet-error"
                  else
                    exact-sign-in-button provider="google" theme="filled_black" shape="pill" press=googleSignIn testId="door-google" width="100%" height=52
            else
              scroll id="lander-scroll" position="absolute" top=0 left=0 width="100%" height="100%" scroll=scrolled z-index=1
                overflow-x="hidden" overflow-y=(gated ? "hidden" : "auto") scrollbar-width="none"
                // The hero, over the painting: the line, and the stack of books to throw through.
                column min-height=viewport.height flex-shrink=0 box-sizing="border-box" align-items="center" justify-content="center" font-size="min(-exact-body, 22px)"
                  gap=(wide ? 44 : gated ? 26 : 32) padding=(wide ? "72px 24px 40px" : "calc(env(safe-area-inset-top) + 96px) 20px 32px")
                  text "Give great words a voice" role="heading" aria-level=1 font-family="Jost" font-weight=300 text-align="center"
                    font-size=(wide ? `${min(76, round(viewport.width * 0.052)) / 16}em` : "2.5em") line-height=1.05 padding="0.2em 0" margin="-0.2em 0" letter-spacing="-0.02em" color="light-dark(#1b1f2b, #1b1f2b)"
                    opacity=max(0, 1 - fade * 1.5) animation=(still ? "none" : "inkIn 1.1s 0.15s cubic-bezier(.2,.7,.2,1) both") testId="hero-title"
                  // Tap the top book to throw it aside, or swipe it away in any direction.
                  button press=tapBook aria-label="Next book" testId="stack" appearance="none" position="relative"
                    width=coverW height=coverH flex-shrink=0 touch-action="pan-y" pan=dragBook panrelease=dropBook cursor="grab"
                    animation=(still ? "none" : "arrive 1.4s 0.35s cubic-bezier(.2,.7,.2,1) both")
                    for g, i in greats key=g.id
                      Volume(book=g, depth=depthOf(i, cur, n), n=n, i=i, w=coverW, h=coverH,
                        dx=(depthOf(i, cur, n) == 0 ? dragX : 0), dy=(depthOf(i, cur, n) == 0 ? dragY : 0), dragging=dragging)
                  // The focused book's title, lifted off the painting by a soft pale halo, and the one thing to do with it.
                  for g in focused key=g.id
                    // On a phone the stack's lower books hang below it, so the title stands clear of them.
                    column align-items="center" gap=16 padding-top=(wide ? 20 : 28) position="relative" opacity=max(0, 1 - fade * 1.5)
                      animation=(still ? "none" : "inkIn 500ms cubic-bezier(.2,.7,.2,1) both")
                      view position="absolute" left="-30%" right="-30%" top="-10%" bottom="-25%" pointer-events="none"
                        background-image="radial-gradient(ellipse closest-side, rgba(242,242,246,0.7) 0%, rgba(242,242,246,0.35) 55%, rgba(242,242,246,0) 100%)"
                      column align-items="center" gap=5 position="relative"
                        text g.title font-family="Jost" font-weight=400 font-size="1.125rem" color="light-dark(#14171f, #14171f)" text-align="center" line-clamp=1 testId="great-title"
                        text g.author.toUpperCase() font-family="Jost" font-weight=500 font-size="0.6875rem" letter-spacing="0.26em" color="light-dark(#2c3140, #2c3140)" text-align="center" testId="great-author"
                      if not gated
                        button press=seek(g) testId="seek" position="relative" class=Chip backgroundMaterial="glass"
                          text "Open in Exalt" font-family="Jost" font-weight=400 font-size="0.9375rem" color="light-dark(#14171f, #14171f)"
                          image "symbol:forward-chevron" color="light-dark(#14171f, #14171f)" width="0.6875rem" height="0.6875rem"
                  // The door: Google's own button, the one way in.
                  if gated
                    column align-items="center" gap=10 width="100%" max-width="18.75rem" position="relative" opacity=max(0, 1 - fade * 1.5) testId="door"
                      exact-sign-in-button provider="google" theme="filled_black" shape="pill" press=googleSignIn testId="door-google" width="100%" height=48
                      if signInError != ""
                        text signInError color="light-dark(#b2463c, #b2463c)" font-family="Jost" font-size="0.875rem" text-align="center" testId="door-error"
                // Below the fold, in the dark: what Exalt is, and signing up.
                column min-height=viewport.height flex-shrink=0 display=(gated ? "none" : "flex") box-sizing="border-box" align-items="center" justify-content="center"
                  padding=(wide ? "120px 24px 120px" : "96px 24px 96px") gap=44 position="relative"
                  column max-width=640 align-items="center" gap=22 opacity=fade
                    text "Import a book you own, and Exalt reads it aloud in a voice you choose."
                      font-family="Jost" font-weight=300 font-size=(wide ? "min(-exact-title1, 44px)" : "min(-exact-title2, 30px)") line-height=1.3 padding="0.1em 0" margin="-0.1em 0" color="light-dark(#eeebe4, #eeebe4)" text-align="center" testId="about"
                    text "Generate, listen, and share for free."
                      font-family="Jost" font-weight=400 font-size=(wide ? "min(-exact-body, 22px)" : "min(-exact-subheadline, 20px)") line-height=1.6 color="light-dark(#9a978f, #9a978f)" text-align="center" max-width=520
                  column width="100%" max-width="18.75rem" align-items="stretch" gap=12 opacity=fade
                    if account.signedIn
                      text `Signed in as ${account.name}` font-family="Jost" font-size="0.9375rem" color="light-dark(#9a978f, #9a978f)" text-align="center" testId="lander-account"
                      link href=path("home") testId="lander-library" padding="13px 26px" border-radius=999 background-color="light-dark(#eeebe4, #eeebe4)" display="flex" justify-content="center"
                        -exact-press-scale=0.96 -exact-press-haptic="impact-light"
                        text "Open the library" font-family="Jost" font-weight=500 font-size="0.9375rem" color="light-dark(#1b1f2b, #1b1f2b)"
                    else
                      if identities.providers.google.active
                        exact-sign-in-button provider="google" press=googleSignIn testId="lander-google" width="100%" height=46
                      if signInError != ""
                        text signInError color="light-dark(#e8837b, #e8837b)" font-family="Jost" font-size="0.875rem" text-align="center" testId="lander-sign-in-error"
                      link href=path("browse") testId="lander-browse" padding="10px 0" display="flex" justify-content="center"
                        text "Or just listen  →" font-family="Jost" font-size="0.9375rem" color="light-dark(#eeebe4, #eeebe4)" border-bottom="1px solid light-dark(rgba(238,235,228,0.35), rgba(238,235,228,0.35))" padding-bottom=3
                  // The credit, at the foot of the page.
                  row align-items="center" justify-content="center" gap=5 position="absolute" left=0 right=0 bottom=(wide ? 32 : 40) opacity=fade testId="credit"
                    text "Made with" font-family="Jost" font-size="min(-exact-footnote, 16px)" color="light-dark(#9a978f, #9a978f)"
                    text "♥" font-size="min(-exact-footnote, 16px)" color="light-dark(#e8837b, #e8837b)" aria-label="love"
                    text "by" font-family="Jost" font-size="min(-exact-footnote, 16px)" color="light-dark(#9a978f, #9a978f)"
                    link href="https://devinliu.xyz" testId="credit-link"
                      text "Devin Liu" font-family="Jost" font-size="min(-exact-footnote, 16px)" color="light-dark(#eeebe4, #eeebe4)" border-bottom="1px solid light-dark(rgba(238,235,228,0.35), rgba(238,235,228,0.35))" padding-bottom=1
            row align-items="center" padding=(wide ? "28px 7vw" : "14px 20px 14px 24px") position="absolute" top="env(safe-area-inset-top)" left=0 right=0 z-index=5
              pointer-events="none"
              // On a phone it steps aside below the fold, as Library does, so the page never runs under it.
              view flex=1 display=(phoneDoor or (lit and not wide) ? "none" : "flex")
                link href="/" testId="wordmark" pointer-events="auto" padding="6px 0" min-height=44 display="flex" align-items="center" font-size="min(-exact-body, 23px)"
                  text "EXALT" font-family="Jost" font-weight=500 font-size="0.875em" letter-spacing="0.5em" color=(lit ? "light-dark(#eeebe4, #eeebe4)" : "light-dark(#1b1f2b, #1b1f2b)") transition="color 400ms ease"
              // Hidden below the fold, where the about text runs under the bar and the page offers its own way in.
              if not gated and not lit
                link href=path("home") testId="enter" pointer-events="auto" class=Chip font-size="min(-exact-body, 23px)" backgroundMaterial="glass" color-scheme=(lit ? "dark" : "light")
                  text "Library" font-family="Jost" font-weight=400 font-size="0.9375em" letter-spacing="0.04em" color=(lit ? "light-dark(#eeebe4, #eeebe4)" : "light-dark(#1b1f2b, #1b1f2b)") transition="color 400ms ease"
        // Library: the person's audiobooks as a list, the newest first, and + to import another.
        if e.name == "home"
          column navigationKey=`${e.id}` navigationBar="none" navigationScroll="library-list" position="absolute" inset=0 status-bar-style="dark-content" background-color="-exact-grouped-background" color="-exact-label" testId="home"
            column flex=1 min-height=0 width="100%" max-width=(wide ? "47.5rem" : "none") margin="0 auto" padding-top=(wide ? 72 : 0)
              header display="flex" align-items="center" gap=4 padding=(wide ? "24px 28px 8px" : "calc(env(safe-area-inset-top) + 16px) 16px 8px 20px") font-size="min(-exact-body, 22px)"
                text "Library" role="heading" aria-level=1 flex=1 min-width=0 font-family="Jost" font-weight=300 font-size="1.6em" letter-spacing="-0.02em" color="-exact-label" testId="home-title"
                if account.signedIn
                  button popovertarget="account-menu" aria-label="Account" testId="account-button"
                    image "symbol:person"
                button press=openImport aria-label="Import a book" testId="import"
                  image "symbol:add"
              column id="account-menu" popover="auto" role="menu" aria-label=account.name
                button press=signOut destructive=true popovertarget="account-menu" popovertargetaction="hide" testId="home-sign-out"
                  image "symbol:sign-out"
                  text "Sign Out"
              if failed(library) and library.length == 0
                EmptyState(symbol="symbol:alert", title="Can’t Open Your Library", message="The server didn’t answer. Try again in a moment.")
                  button press=retryLibrary testId="library-retry"
                    text "Try Again"
              else if library.length == 0 and not pending(library)
                view flex=1 min-height=0 display="flex" flex-direction="column" padding-bottom=(docked ? 96 : 0) testId="library-empty"
                  EmptyState(symbol="symbol:book", title="No Audiobooks Yet", message=(account.signedIn ? "Import an EPUB, PDF or TXT and Exalt narrates it for you." : "Sign in to import an EPUB, PDF or TXT and hear it narrated."))
                    // Signed out, signing in is the step to take; importing comes after.
                    column gap=12 align-items="center"
                      if not account.signedIn and identities.providers.google.active
                        exact-sign-in-button provider="google" press=googleSignIn testId="library-google" width=260 height=44
                      button press=openImport buttonStyle=(account.signedIn ? "filled" : "borderless") testId="library-import"
                        text "Import a Book"
                      if signInError != ""
                        text signInError font="-exact-footnote" color="-exact-system-red" testId="library-sign-in-error"
              else
                list id="library-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 padding-bottom=(docked ? 112 : 24)
                  section
                    for m in library key=m.id
                      button press=openMine(m) delete=askRemove(m.id) contextmenu=aim(m.id) contextPopover="row-menu" testId=`mine-${m.id}`
                        aria-label=`${m.title}, ${statusOf(m, places)}`
                        row flex=1 min-width=0 align-items="center" gap=14 padding="6px 0"
                          BookCover(src=m.cover, title=m.title, w=40, flat=true)
                          column flex=1 min-width=0 gap=2
                            text m.title font="-exact-headline" testId=`mine-title-${m.id}`
                            if m.author != ""
                              text m.author font="-exact-subheadline" color="-exact-secondary-label"
                            text statusOf(m, places) font="-exact-footnote" color=(m.status == "failed" ? "-exact-system-red" : "-exact-secondary-label") testId=`mine-status-${m.id}`
                          image (m.public ? "symbol:people" : "symbol:lock") color="-exact-tertiary-label" aria-label=(m.public ? "Shared" : "Private") testId=`mine-sharing-${m.id}`
              column id="row-menu" popover="auto" role="menu" aria-label=aimedTitle
                button press=toggleShare popovertarget="row-menu" popovertargetaction="hide" testId="menu-share"
                  image (aimedPublic ? "symbol:lock" : "symbol:people")
                  text (aimedPublic ? "Make Private" : "Share Publicly")
                button press=askRename popovertarget="row-menu" popovertargetaction="hide" testId="menu-rename"
                  image "symbol:pencil"
                  text "Rename…"
                hr
                button press=askRemove(aimed) destructive=true popovertarget="row-menu" popovertargetaction="hide" testId="menu-delete"
                  image "symbol:delete"
                  text "Delete"
            if wide
              TopBar(active="home")
        // Import: a sheet of a grouped form. The file, its title and author, a voice, and whether to share it.
        if e.name == "add"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="import-form" position="absolute" inset=0 color-scheme="light" background-color="-exact-grouped-background" color="-exact-label" testId="import-sheet"
            header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
              button id="back" press=back testId="import-cancel"
                text "Cancel"
              text "Import a Book" role="heading" aria-level=1
              button press=narrate buttonStyle="filled" disabled=(not canImport) testId="narrate"
                text "Narrate"
            list id="import-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 background-color="-exact-grouped-background"
              if not account.signedIn
                section testId="import-signed-out"
                  row
                    text "Sign in to narrate your books. Listening to Browse needs no account."
                  if identities.providers.google.active
                    row
                      exact-sign-in-button provider="google" press=googleSignIn testId="import-google" flex=1 height=44
                  if signInError != ""
                    row
                      text signInError font="-exact-footnote" color="-exact-system-red" testId="import-sign-in-error"
              section
                header
                  text "Book" color="light-dark(#6c6c70, #6c6c70)"
                row
                  text "File"
                  button press=chooseFile min-width=0 testId="choose-file"
                    text (fileName == "" ? "Choose…" : fileName) line-clamp=1 testId="file-name"
                  input type="file" id="upload" display="none" change=picked testId="upload"
                row
                  text "Title"
                  input value=importTitle input=editTitle placeholder="From the file" aria-label="Title" text-align="end" flex=1 min-width=0 testId="import-title"
                row
                  text "Author"
                  input value=importAuthor input=editAuthor placeholder="From the file" aria-label="Author" text-align="end" flex=1 min-width=0 testId="import-author"
                footer
                  text "An EPUB, PDF or TXT of your own." color="light-dark(#6c6c70, #6c6c70)"
              section
                header
                  text "Voice" color="light-dark(#6c6c70, #6c6c70)"
                row
                  text "Model"
                  select value=chosenModel change=pickModel aria-label="Voice model" testId="model"
                    for m in models key=m.id
                      option m.name value=m.id
                if fishModel
                  link href=path("voices") testId="import-voice"
                    text "Voice"
                    text (voicePref.id == "" ? "Default" : voicePref.title) color="light-dark(#6c6c70, #6c6c70)"
                    image "symbol:forward-chevron"
                else if voices.length > 0
                  row
                    text "Voice"
                    select value=voice change=editVoice aria-label="Voice" testId="voice"
                      option "Default" value=""
                      for v in voices key=v
                        option v value=v
              section
                row
                  text "Share publicly"
                  input type="checkbox" switch checked=share change=setShare aria-label="Share publicly" testId="share"
                if share
                  row
                    text "I have the right to share this book"
                    input type="checkbox" checked=rights change=setRights aria-label="I have the right to share this book" testId="rights"
                footer
                  text (share ? "Anyone can listen in Browse. Only share books you have the right to." : "Only you can listen. You can share it later from your library.") color="light-dark(#6c6c70, #6c6c70)" testId="share-note"
              section
                footer
                  text (refusal != "" ? refusal : importHint) color=(refusal != "" ? "-exact-system-red" : "light-dark(#6c6c70, #6c6c70)") testId="import-hint"
        // Browse: everyone's shared audiobooks, narrowed by title or author.
        if e.name == "browse"
          column navigationKey=`${e.id}` navigationBar="none" navigationScroll="browse-list" position="absolute" inset=0 status-bar-style="dark-content" background-color="-exact-grouped-background" color="-exact-label" testId="browse"
            column flex=1 min-height=0 width="100%" max-width=(wide ? "47.5rem" : "none") margin="0 auto" padding-top=(wide ? 72 : 0)
              column align-items="stretch" gap=8 flex-shrink=0 position="relative" z-index=2 padding=(wide ? "24px 28px 8px" : "calc(env(safe-area-inset-top) + 16px) 16px 8px 20px") font-size="min(-exact-body, 22px)"
                text "Browse" role="heading" aria-level=1 min-width=0 font-family="Jost" font-weight=300 font-size="1.6em" letter-spacing="-0.02em" color="-exact-label" testId="browse-title"
                input type="search" value=browseQuery input=editBrowseQuery placeholder="Title or author" aria-label="Search shared audiobooks"
                  focus=browseFocus blur=browseBlur testId="browse-search" min-width=0
              if failed(browse) and browse.length == 0
                EmptyState(symbol="symbol:alert", title="Can’t Reach Exalt", message="Shared audiobooks didn’t load. Try again in a moment.")
              else if browse.length == 0 and not browseBusy
                view flex=1 min-height=0 display="flex" flex-direction="column" padding-bottom=(docked ? 96 : 0) testId="browse-empty"
                  if browseAsked == ""
                    EmptyState(symbol="symbol:book", title="Nothing Shared Yet", message="Audiobooks people share appear here.")
                  else
                    EmptyState(symbol="symbol:search", title="No Results", message=`Nothing shared matches “${browseAsked}”. Try another title or author.`)
              else
                list id="browse-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 padding-bottom=(docked ? 112 : 24)
                  section
                    for s in browse key=s.id
                      button press=listen(s.id) testId=`shared-${s.id}` aria-label=`${s.title}, ${s.author}`
                        row flex=1 min-width=0 align-items="center" gap=14 padding="6px 0"
                          BookCover(src=s.cover, title=s.title, w=40, flat=true)
                          column flex=1 min-width=0 gap=2
                            text s.title font="-exact-headline"
                            if s.author != ""
                              text s.author font="-exact-subheadline" color="-exact-secondary-label"
                            text readBy(s.voice, s.by) font="-exact-footnote" color="-exact-secondary-label"
            if wide
              TopBar(active="browse")
        // Voices: a recommended set to start, and Fish Audio's whole community library by search.
        if e.name == "voices"
          column navigationKey=`${e.id}` navigationBar="none" navigationScroll="voices-scroll" position="absolute" inset=0 background-color="light-dark(#eceef2, #eceef2)" status-bar-style="dark-content" testId="voices"
            Mist()
            scroll id="voices-scroll" position="absolute" top=0 left=0 width="100%" height="100%" overflow-x="hidden" overflow-y="auto"
              view height="env(safe-area-inset-top)" flex-shrink=0
              column margin="0 auto" width="100%" max-width="47.5rem" box-sizing="border-box" padding=(wide ? "120px 48px 96px" : "28px 20px 200px") gap=(wide ? 32 : 26)
                column gap=18 font-size="min(-exact-body, 22px)"
                  if fromImport
                    button press=back aria-label="Back to Import" testId="voices-back" class=Round backgroundMaterial="glass" margin-left=-6
                      image "symbol:back" color="light-dark(#14171f, #14171f)" width=18 height=18
                  text "Voices" role="heading" aria-level=1 font-family="Jost" font-weight=300 font-size=(wide ? "3.25em" : "2.375em") letter-spacing="-0.02em" color="light-dark(#14171f, #14171f)"
                  view width="100%" max-width="35rem"
                    SearchField(value=voiceQuery, hint="Search voices", label="Search Voices", id="voice-search", focused=voiceOn, busy=voiceBusy, still=still,
                      edit=editVoiceQuery, enter=takeVoiceQuery, focus=voiceFocus, blur=voiceBlur, clear=clearVoiceQuery)
                if pending(voiceList) and voiceList.length == 0
                  column role="status" aria-label="Loading voices" testId="voices-loading"
                    for n in [0, 1, 2, 3, 4] key=n
                      SkeletonRow(i=n, still=still)
                else if voiceList.length == 0
                  text "No voices found." font-family="Jost" font-weight=300 font-size="1.25rem" color="light-dark(#14171f, #14171f)" testId="no-voices"
                    animation=(still ? "none" : "inkIn 420ms cubic-bezier(.2,.7,.2,1) both")
                else
                  column gap=8
                    SectionTitle(label=(voiceAsked == "" ? "Recommended" : "Community"))
                    column opacity=(voiceBusy ? 0.4 : 1) transition="opacity 220ms ease"
                      for v, i in voiceList key=v.id
                        view animation=(still ? "none" : `inkIn 420ms ${min(i, 10) * 45}ms cubic-bezier(.2,.7,.2,1) both`)
                          VoiceRow(voice=v, chosen=(v.id == voicePref.id), playing=(v.sample != "" and v.sample == auditioning), audition=audition, choose=chooseVoice)
                if auditioning != ""
                  audio src=auditioning autoplay=true ended=auditionEnded testId="audition"
            if wide
              TopBar(active="voices")
        // The player, in the dark: the cover lights the room, and the controls float on glass.
        if e.name == "play"
          column navigationKey=`${e.id}` navigationBar="none" navigationScroll="player" position="absolute" inset=0 background-color="light-dark(#121419, #121419)" color-scheme="dark" status-bar-style="light-content" testId="player"
            background-image="radial-gradient(ellipse closest-side at 50% 32%, rgba(140,148,170,0.20) 0%, rgba(140,148,170,0) 100%)"
            if failed(audiobook)
              column flex=1 min-height=0 justify-content="center" testId="player-gone"
                EmptyState(symbol="symbol:alert", title="Can’t Play This", message="It was removed or made private.")
                  button press=back testId="player-gone-back"
                    text "Back"
            else if audiobook.id != e.params.gen
              column flex=1 justify-content="center" align-items="center"
                progress aria-label="Loading" testId="player-loading"
            else
              if audiobook.cover != ""
                view position="absolute" top=0 left=0 right=0 height="78%" overflow="hidden" pointer-events="none"
                  image audiobook.cover alt="" position="absolute" top="-20%" left="-20%" width="140%" height="140%" object-fit="cover" filter="blur(56px) saturate(1.5)" opacity=0.7
                  view position="absolute" inset=0 background-image="linear-gradient(180deg, rgba(18,20,25,0.3) 0%, rgba(18,20,25,0.62) 55%, #121419 100%)"
              scroll id="player" position="absolute" top=0 left=0 width="100%" height="100%" overflow-x="hidden" overflow-y="auto" scrollbar-width="none"
                view height="env(safe-area-inset-top)" flex-shrink=0
                column margin="0 auto" width="100%" max-width="35rem" box-sizing="border-box" padding=(wide ? "80px 32px 80px" : "68px 22px 64px") gap=(wide ? 32 : 30)
                  column align-items="center" gap=28
                    view animation=(still ? "none" : "arrive 900ms cubic-bezier(.2,.7,.2,1) both")
                      scale=(held ? 0.92 : 1) transition="scale 500ms cubic-bezier(.2,.9,.3,1.15)"
                      BookCover(src=audiobook.cover, title=audiobook.title, w=playerCover, flat=false)
                    column align-items="center" gap=8
                      text audiobook.title role="heading" aria-level=1 font-family="Jost" font-weight=300 font-size=(wide ? "2rem" : "1.75rem") line-height=1.15 color="light-dark(#eeebe4, #eeebe4)" text-align="center"
                      text audiobook.author.toUpperCase() font-family="Jost" font-weight=500 font-size="0.6875rem" letter-spacing="0.26em" color="light-dark(#b5b2aa, #b5b2aa)" text-align="center"
                      text trackTitle(audiobook, track) font-family="Jost" font-size="0.9375rem" color="light-dark(#d6d3cb, #d6d3cb)" text-align="center" line-clamp=1 padding-top=8 testId="now-playing"
                  column gap=6
                    input type="range" min=0 max=max(1, round(duration)) step=1 value=round(now) input=scrub aria-label="Position" testId="scrub" width="100%" accent-color="light-dark(#eeebe4, #eeebe4)"
                    row justify-content="space-between"
                      text clock(now) font-family="Jost" font-size="0.75rem" color="light-dark(#b5b2aa, #b5b2aa)" testId="elapsed"
                      text (duration > 0 ? `−${clock(duration - now)}` : "") font-family="Jost" font-size="0.75rem" color="light-dark(#b5b2aa, #b5b2aa)"
                  row justify-content="space-between" align-items="center" padding="10px 18px" border-radius=999 backgroundMaterial="glass"
                    button press=cycleRate appearance="none" aria-label="Speed" testId="rate" width="3rem" padding="8px 0" cursor="pointer" -exact-press-scale=0.9
                      text rateText(rate) font-family="Jost" font-weight=500 font-size="0.9375rem" color="light-dark(#eeebe4, #eeebe4)" text-align="center"
                    button press=back15 appearance="none" aria-label="Back 15 seconds" testId="back15" padding=8 cursor="pointer" -exact-press-scale=0.88 -exact-press-haptic="impact-light"
                      image "symbol:skip-back-15" color="light-dark(#eeebe4, #eeebe4)" width=28 height=28
                    button press=toggle appearance="none" aria-label=(held ? "Play" : "Pause") aria-keyshortcuts="Space" testId="toggle"
                      width=68 height=68 min-width=68 padding=0 flex-shrink=0 border-radius=999 display="flex" align-items="center" justify-content="center" background-color="light-dark(#eeebe4, #eeebe4)" cursor="pointer"
                      box-shadow="0 14px 36px -10px rgba(0,0,0,0.6)" -exact-press-scale=0.9 -exact-press-haptic="impact-medium"
                      image (held ? "symbol:play-fill" : "symbol:pause-fill") color="light-dark(#14171f, #14171f)" width=26 height=26
                    button press=fwd30 appearance="none" aria-label="Forward 30 seconds" testId="fwd30" padding=8 cursor="pointer" -exact-press-scale=0.88 -exact-press-haptic="impact-light"
                      image "symbol:skip-forward-30" color="light-dark(#eeebe4, #eeebe4)" width=28 height=28
                    row width="3rem" justify-content="center"
                      image "symbol:waveform" color=(held ? "light-dark(#6f6d67, #6f6d67)" : "light-dark(#eeebe4, #eeebe4)") width=20 height=20
                  column padding="20px 20px 8px" border-radius=30 backgroundMaterial="glass"
                    text "CHAPTERS" font-family="Jost" font-weight=500 font-size="0.6875rem" letter-spacing="0.26em" color="light-dark(#b5b2aa, #b5b2aa)" padding-bottom=8
                    for t in audiobook.tracks key=t.idx
                      button press=playTrack(t.idx) appearance="none" text-align="start" display="flex" align-items="center" gap=16 padding="13px 0"
                        border-top="1px solid light-dark(rgba(238,235,228,0.1), rgba(238,235,228,0.1))" cursor="pointer" testId=`track-${t.idx}` -exact-press-opacity=0.6
                        text `${t.idx + 1}` font-family="Jost" font-size="0.8125rem" color="light-dark(#9a978f, #9a978f)" width="1.5rem"
                        text t.title flex=1 min-width=0 line-clamp=1 font-family="Jost" font-size="1rem" color=(t.idx == track ? "light-dark(#eeebe4, #eeebe4)" : "light-dark(#b5b2aa, #b5b2aa)")
                        if t.idx == track
                          image "symbol:waveform" color="light-dark(#eeebe4, #eeebe4)" width=16 height=16
                  row justify-content="center" align-items="center" gap=8 testId="player-credit"
                    if audiobook.public
                      image "symbol:people" color="light-dark(#9a978f, #9a978f)" aria-label="Shared publicly" font-size="0.8125rem" testId="player-shared"
                    text readBy(audiobook.voice, audiobook.by) font-family="Jost" font-size="0.8125rem" color="light-dark(#9a978f, #9a978f)" text-align="center"
              if trackSrc(audiobook, track) != ""
                audio id="player-audio" src=trackSrc(audiobook, track) paused=held playbackRate=rate preload="auto"
                  timeupdate=tick durationchange=gotDuration loadedmetadata=resumeAt ended=nextTrack play=played pause=stopped
                  metadata=MediaMetadata(title=trackTitle(audiobook, track), artist=audiobook.author, album=audiobook.title, artwork=audiobook.cover)
                  seekbackward=back15 seekforward=fwd30 nexttrack=nextTrack previoustrack=prevTrack testId="audio"
            row align-items="center" padding=(wide ? "24px 7vw" : "8px 16px") position="absolute" top="env(safe-area-inset-top)" left=0 right=0 z-index=5 pointer-events="none"
              button press=back aria-label="Back" testId="player-back" pointer-events="auto" class=Round backgroundMaterial="glass"
                image "symbol:back" color="light-dark(#eeebe4, #eeebe4)" width=18 height=18
              view flex=1
              text "EXALT" font-family="Jost" font-weight=500 font-size="0.8125rem" letter-spacing="0.5em" color="light-dark(#b5b2aa, #b5b2aa)" padding-right=8
      // The dock, over every main screen on a phone: the book in progress, and the tabs.
      if docked
        column position="absolute" left=0 right=0 bottom=0 align-items="center" gap=10 pointer-events="none" z-index=20 testId="dock"
          padding="0 16px clamp(14px, calc(env(safe-area-inset-bottom) - 8px), 40px)"
          for p in (top(nav).name == "home" ? [] : places.slice(0, 1)) key=p.gen
            button press=resume(p) appearance="none" aria-label=`Resume ${p.title}` testId="mini" pointer-events="auto" text-align="start" cursor="pointer"
              width="100%" max-width="23.125rem" box-sizing="border-box" display="flex" align-items="center" gap=12 padding="8px 10px 8px 8px" border-radius=999
              backgroundMaterial="glass" class=Lift -exact-press-scale=0.97 -exact-press-haptic="impact-light"
              if p.cover != ""
                image p.cover alt="" width=42 height=42 border-radius=999 object-fit="cover" flex-shrink=0
              else
                view width=42 height=42 border-radius=999 background-color="light-dark(#2a2d36, #2a2d36)" flex-shrink=0
              column flex=1 min-width=0 gap=1
                text p.title font-family="Jost" font-size="0.9375rem" color="light-dark(#14171f, #14171f)" line-clamp=1
                text `Chapter ${p.track + 1} of ${p.tracks}` font-family="Jost" font-size="0.75rem" color="light-dark(#6b7080, #6b7080)" line-clamp=1
              view width=38 height=38 border-radius=999 background-color="light-dark(#14171f, #14171f)" display="flex" align-items="center" justify-content="center" flex-shrink=0
                image "symbol:play-fill" color="light-dark(#f4f2ec, #f4f2ec)" width=13 height=13
          row padding=5 gap=2 border-radius=999 backgroundMaterial="glass" class=Lift pointer-events="auto" role="navigation"
            DockTab(to=path("home"), id="nav-home", label="Library", symbol="symbol:book", on=(top(nav).name == "home"))
            DockTab(to=path("browse"), id="nav-browse", label="Browse", symbol="symbol:search", on=(top(nav).name == "browse"))
            DockTab(to=path("voices"), id="nav-voices", label="Voices", symbol="symbol:waveform", on=(top(nav).name == "voices"))
      // The library's alerts: deleting, sharing (the person confirms the right to share), renaming, a refusal.
      dialog id="remove-alert" role="alertdialog" aria-label=`Delete “${aimedTitle}”?`
        text "The audiobook is gone for good, for you and for anyone listening in Browse."
        button press=remove destructive=true commandfor="remove-alert" command="close" testId="remove-confirm"
          text "Delete"
        button commandfor="remove-alert" command="close" testId="remove-cancel"
          text "Cancel"
      dialog id="share-alert" role="alertdialog" aria-label="Share Publicly?"
        text "Anyone can listen to it in Browse. Only share books you have the right to."
        button press=shareAimed commandfor="share-alert" command="close" testId="share-confirm"
          text "I Have the Right"
        button commandfor="share-alert" command="close" testId="share-cancel"
          text "Cancel"
      dialog id="rename-alert" role="alertdialog" aria-label="Rename"
        input value=renameTitle input=editRenameTitle placeholder="Title" aria-label="Title" testId="rename-title"
        button press=rename disabled=(renameTitle.trim() == "") commandfor="rename-alert" command="close" testId="rename-save"
          text "Save"
        button commandfor="rename-alert" command="close" testId="rename-cancel"
          text "Cancel"
      dialog id="change-alert" role="alertdialog" aria-label="Couldn’t Change It"
        text changeMessage testId="change-message"
        button commandfor="change-alert" command="close" testId="change-ok"
          text "OK"


// What floats: a capsule to press, a round button.
style Chip
  appearance="none" display="flex" align-items="center" justify-content="center" gap=8 height=44 padding="0 18px" border-radius=999
  box-sizing="border-box" flex-shrink=0 cursor="pointer" -exact-press-scale=0.95 -exact-press-haptic="selection"
style Round
  appearance="none" display="flex" align-items="center" justify-content="center" width=44 height=44 padding=0 border-radius=999
  flex-shrink=0 cursor="pointer" -exact-press-scale=0.9 -exact-press-haptic="selection"
style Lift
  box-shadow="0 12px 30px -14px rgba(20,24,36,0.32)"

// The painting as weather at the top of a light screen, thinning into the page.
component Mist
  view
    view position="absolute" top=0 left=0 right=0 height=300 overflow="hidden" pointer-events="none"
      image "assets/lander.jpg" alt="" position="absolute" top=0 left=0 width="100%" height="100%" object-fit="cover" opacity=0.75
      view position="absolute" inset=0 background-image="linear-gradient(180deg, rgba(236,238,242,0.35) 0%, rgba(236,238,242,0.75) 55%, #eceef2 100%)"

component DockTab
  props
    to: string
    id: string
    label: string
    symbol: string
    on: bool
  view
    link href=to testId=id aria-label=label aria-current=(on ? "page" : "false") -exact-press-scale=0.9 -exact-press-haptic="selection"
      row align-items="center" justify-content="center" width=72 height=48 border-radius=999
        background-color=(on ? "light-dark(rgba(20,23,31,0.09), rgba(20,23,31,0.09))" : "light-dark(rgba(20,23,31,0), rgba(20,23,31,0))") transition="background-color 200ms ease"
        image symbol color=(on ? "light-dark(#14171f, #14171f)" : "light-dark(#6b7080, #6b7080)") width=22 height=22

component TopBar
  props
    active: string
  view
    row align-items="center" gap=30 padding="22px 7vw" position="absolute" top=0 left=0 right=0 z-index=5
      background-color="light-dark(rgba(236,238,242,0.72), rgba(236,238,242,0.72))" backdrop-filter="blur(14px)" border-bottom="1px solid light-dark(rgba(20,23,31,0.06), rgba(20,23,31,0.06))"
      link href=path("lander") testId="nav-exalt"
        text "EXALT" font-family="Jost" font-weight=500 font-size="0.875rem" letter-spacing="0.5em" color="light-dark(#14171f, #14171f)"
      view flex=1
      link href=path("home") testId="nav-home" padding="4px 0"
        text "Library" font-family="Jost" font-size="0.9375rem" color=(active == "home" ? "light-dark(#14171f, #14171f)" : "light-dark(#626777, #626777)")
          border-bottom=(active == "home" ? "1px solid light-dark(#14171f, #14171f)" : "1px solid transparent") padding-bottom=2
      link href=path("browse") testId="nav-browse" padding="4px 0"
        text "Browse" font-family="Jost" font-size="0.9375rem" color=(active == "browse" ? "light-dark(#14171f, #14171f)" : "light-dark(#626777, #626777)")
          border-bottom=(active == "browse" ? "1px solid light-dark(#14171f, #14171f)" : "1px solid transparent") padding-bottom=2
      link href=path("voices") testId="nav-voices" padding="4px 0"
        text "Voices" font-family="Jost" font-size="0.9375rem" color=(active == "voices" ? "light-dark(#14171f, #14171f)" : "light-dark(#626777, #626777)")
          border-bottom=(active == "voices" ? "1px solid light-dark(#14171f, #14171f)" : "1px solid transparent") padding-bottom=2

component SectionTitle
  props
    label: string
  view
    view font-size="min(-exact-body, 30px)"
      text label.toUpperCase() role="heading" aria-level=2 font-family="Jost" font-weight=500 font-size="0.6875em" letter-spacing="0.26em" color="light-dark(#626777, #626777)"

// A cover as a book: page edges under it and light along the spine. Without art, its title on cloth.
component BookCover
  props
    src: string
    title: string
    w: number
    flat: bool
  view
    view position="relative" width=w height=round(w * 1.5) flex-shrink=0 border-radius=3 background-color="light-dark(#2a2d36, #2a2d36)"
      box-shadow=(flat ? "none" : "1px 1px 0 #f3eee2, 2px 2px 0 #d6ccb5, 3px 3px 0 #efe8d8, 4px 4px 0 #c4b99f, 0 22px 34px -16px rgba(8,10,18,0.55)")
      if src != ""
        image src alt="" width="100%" height="100%" object-fit="cover" border-radius=3
      else
        column position="absolute" inset=0 padding=round(w * 0.12) justify-content="center" align-items="center"
          text title font-family="Jost" font-weight=300 font-size=max(11, round(w * 0.1)) line-height=1.2 color="light-dark(#eeebe4, #eeebe4)" text-align="center" line-clamp=5
      view position="absolute" inset=0 border-radius=3 pointer-events="none"
        background-image="linear-gradient(90deg, rgba(0,0,0,0.28) 0%, rgba(255,255,255,0.12) 2.4%, rgba(0,0,0,0.06) 4.5%, rgba(0,0,0,0) 8%), linear-gradient(118deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 45%)"


// A voice's face: its picture, or its initial on a plain disc.
component VoiceFace
  props
    title: string
    cover: string
    size: number
  view
    if cover != ""
      image cover alt="" width=size height=size border-radius=999 object-fit="cover" flex-shrink=0
    else
      view width=size height=size border-radius=999 background-color="light-dark(#d9dce3, #d9dce3)" display="flex" align-items="center" justify-content="center" flex-shrink=0
        text (title == "" ? "·" : title.slice(0, 1).toUpperCase()) font-family="Jost" font-weight=300 font-size=round(size * 0.42) color="light-dark(#4a4f5c, #4a4f5c)"

component VoiceRow
  props
    voice: Voice
    chosen: bool
    playing: bool
    audition: action
    choose: action
  view
    row gap=16 align-items="center" padding="16px 0" border-bottom="1px solid light-dark(rgba(20,23,31,0.08), rgba(20,23,31,0.08))" testId=`voice-${voice.id}`
      VoiceFace(title=voice.title, cover=voice.cover, size=52)
      column flex=1 min-width=0 gap=3
        text voice.title font-family="Jost" font-size="1.0625rem" color="light-dark(#14171f, #14171f)" line-clamp=1 text-overflow="ellipsis"
        if voice.description != ""
          text voice.description font-family="Jost" font-size="0.875rem" color="light-dark(#626777, #626777)" line-clamp=1 text-overflow="ellipsis"
      if voice.sample != ""
        button press=audition(voice.sample) aria-label=(playing ? "Stop sample" : "Hear sample") testId=`hear-${voice.id}` class=Round backgroundMaterial="glass"
          image (playing ? "symbol:stop-fill" : "symbol:play-fill") color="light-dark(#14171f, #14171f)" width=13 height=13
      button press=choose(voice) testId=`use-${voice.id}` class=Chip height=40 padding="0 16px" min-width=64
        backgroundMaterial=(chosen ? "none" : "glass") background-color=(chosen ? "light-dark(#14171f, #14171f)" : "light-dark(rgba(20,23,31,0), rgba(20,23,31,0))")
        text (chosen ? "✓ Selected" : "Use") font-family="Jost" font-weight=500 font-size="0.875rem" color=(chosen ? "light-dark(#f4f2ec, #f4f2ec)" : "light-dark(#14171f, #14171f)")

// The search field: a lit box with a glass, that lifts on focus and shows its own working —
// a turning ring where the clear button sits, and a line sweeping along its foot.
component SearchField
  props
    value: string
    hint: string
    label: string
    id: string
    focused: bool
    busy: bool
    still: bool
    edit: action
    enter: action
    focus: action
    blur: action
    clear: action
  view
    row position="relative" align-items="center" gap=12 width="100%" box-sizing="border-box" min-height="3.375rem" padding="0 16px 0 18px"
      border-radius=999 overflow="hidden" backgroundMaterial="glass"
      box-shadow=(focused ? "0 16px 36px -16px rgba(20,24,36,0.45)" : "0 10px 26px -16px rgba(20,24,36,0.3)")
      transition="box-shadow 260ms ease"
      image "symbol:search" color=(focused ? "light-dark(#14171f, #14171f)" : "light-dark(#6b7080, #6b7080)") width="1.25rem" height="1.25rem" flex-shrink=0
      // A text field with a search keyboard: the box draws its own glass and clear button.
      input type="text" inputmode="search" enterkeyhint="search" autocomplete="off" value=value input=edit submit=enter focus=focus blur=blur placeholder=hint
        aria-label=label testId=id flex=1 min-width=0 height="100%" box-sizing="border-box" appearance="none"
        font-family="Jost" font-weight=300 font-size="1.1875rem" color="light-dark(#14171f, #14171f)" background-color="transparent"
        border="none" border-radius=0 padding=0 outline="none"
        ::placeholder
          color="light-dark(#8a8f9c, #8a8f9c)"
      if busy
        if still
          text "Searching…" font-family="Jost" font-size="0.8125rem" color="light-dark(#626777, #626777)" flex-shrink=0 testId=`${id}-busy`
        else
          view width=18 height=18 box-sizing="border-box" border-radius=999 flex-shrink=0 testId=`${id}-busy`
            border="2px solid light-dark(rgba(20,23,31,0.14), rgba(20,23,31,0.14))" border-top-color="light-dark(#14171f, #14171f)" animation="spin 700ms linear infinite"
      else if value != ""
        button press=clear appearance="none" aria-label="Clear" testId=`${id}-clear` width=28 height=28 border-radius=999 flex-shrink=0
          display="flex" align-items="center" justify-content="center" background-color="light-dark(rgba(20,23,31,0.07), rgba(20,23,31,0.07))" cursor="pointer"
          animation=(still ? "none" : "popIn 180ms ease both")
          image "symbol:close" color="light-dark(#4a4f5c, #4a4f5c)" width=10 height=10
      if busy and not still
        view position="absolute" left=0 bottom=0 width="35%" height=2 pointer-events="none"
          background-image="linear-gradient(90deg, rgba(20,23,31,0) 0%, rgba(20,23,31,0.75) 50%, rgba(20,23,31,0) 100%)"
          animation="sweep 1.1s ease-in-out infinite"

// A row still to come: the shape of a voice, breathing, each a beat after the last.
component SkeletonRow
  props
    i: number
    still: bool
  view
    row gap=18 align-items="center" padding="16px 0" border-bottom="1px solid light-dark(rgba(20,23,31,0.08), rgba(20,23,31,0.08))"
      animation=(still ? "none" : `breathe 1.3s ${i * 130}ms ease-in-out infinite`)
      view width=52 height=52 border-radius=999 background-color="light-dark(#d5d9e1, #d5d9e1)" flex-shrink=0
      column flex=1 min-width=0 gap=9
        view height=14 width=`${62 - i * 8}%` border-radius=4 background-color="light-dark(#d5d9e1, #d5d9e1)"
        view height=10 width=`${40 - i * 4}%` border-radius=4 background-color="light-dark(#dfe2e8, #dfe2e8)"

keyframes spin
  to rotate="360deg"
keyframes sweep
  from translate="-100% 0px"
  to translate="290% 0px"
keyframes breathe
  50% opacity=0.4
keyframes popIn
  from opacity=0 scale=0.6
keyframes arrive
  from opacity=0 translate="0px 40px"
keyframes inkIn
  from opacity=0 translate="0px 10px"
keyframes drift
  50% translate="6% -2%"

// A book lying face up in the stack: its cover, its page edges under it, a sheen of light
// on the one in focus and shade on the ones below.
component Volume
  props
    book: Great
    depth: number
    n: number
    i: number
    w: number
    h: number
    dx: number
    dy: number
    dragging: bool
  view
    view position="absolute" left=0 top=0 width=w height=h z-index=volZ(depth, n) testId=`great-${book.id}`
      translate=`${volX(depth, n, i, w) + dx}px ${volY(depth, n, h) + dy}px` rotate=`${volRot(depth, n, i) + dx * 0.05}deg`
      scale=(dragging and depth == 0 ? 1.03 : 1 - min(depth, 5) * 0.012) opacity=volOpacity(depth, n)
      transition=(dragging and depth == 0 ? "scale 200ms ease" : "translate -exact-spring(150, 20, 1), rotate -exact-spring(150, 20, 1), scale -exact-spring(150, 20, 1), opacity 650ms ease")
      border-radius=3 background-color="light-dark(#2a2d36, #2a2d36)"
      box-shadow="1px 1px 0 #f3eee2, 2px 2px 0 #ddd4bf, 3px 3px 0 #f3eee2, 4px 4px 0 #d6ccb5, 5px 5px 0 #efe8d8, 6px 6px 0 #c4b99f, 0 30px 50px -12px rgba(8,10,18,0.6)"
      image book.cover alt=(depth == 0 ? `${book.title}, ${book.author}` : "") width="100%" height="100%" object-fit="cover" border-radius=3
      view position="absolute" inset=0 border-radius=3 pointer-events="none"
        background-image="linear-gradient(90deg, rgba(0,0,0,0.30) 0%, rgba(255,255,255,0.12) 2.2%, rgba(0,0,0,0.06) 4%, rgba(0,0,0,0) 7%), linear-gradient(118deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0) 45%)"
      view position="absolute" inset=0 border-radius=3 pointer-events="none" background-color="light-dark(#0b0d14, #0b0d14)"
        opacity=(min(depth, 5) * 0.1) transition="opacity 420ms ease"
